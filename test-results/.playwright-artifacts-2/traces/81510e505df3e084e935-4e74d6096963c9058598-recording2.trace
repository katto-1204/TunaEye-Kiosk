 box-shadow: 0 0 0 2px color-mix(in srgb, var(--pdial-ink) 45%, transparent);\n}\n\n.pdial__rim {\n  position: absolute;\n  inset: 0;\n  padding: 1px;\n  border-radius: inherit;\n  pointer-events: none;\n  background: linear-gradient(\n    180deg,\n    var(--pdial-rim-top) 0%,\n    var(--pdial-rim-mid) 22%,\n    var(--pdial-rim-mid) 52%,\n    color-mix(in srgb, var(--pdial-c2) 70%, transparent) 84%,\n    var(--pdial-c3) 100%\n  );\n  -webkit-mask:\n    linear-gradient(#000 0 0) content-box,\n    linear-gradient(#000 0 0);\n  -webkit-mask-composite: xor;\n  mask:\n    linear-gradient(#000 0 0) content-box exclude,\n    linear-gradient(#000 0 0);\n}\n\n.pdial__clip {\n  position: absolute;\n  inset: 0;\n  overflow: hidden;\n  border-radius: inherit;\n}\n\n.pdial__wash {\n  position: absolute;\n  inset: 0;\n  opacity: var(--pdial-wash-op);\n  background:\n    radial-gradient(62% 22% at 50% 102%, #e0f2fe 0%, color-mix(in srgb, var(--pdial-c3) 80%, transparent) 40%, transparent 80%),\n    linear-gradient(\n      0deg,\n      var(--pdial-c3) 0%,\n      var(--pdial-c2) 8%,\n      var(--pdial-c1) 19%,\n      color-mix(in srgb, var(--pdial-c1) 38%, transparent) 29%,\n      transparent 40%\n    );\n  filter: blur(calc(var(--pdial-w) * 0.016));\n  transform-origin: 50% 100%;\n}\n\n.pdial[data-theme=\"light\"] .pdial__wash {\n  filter: blur(calc(var(--pdial-w) * 0.02)) saturate(0.88) brightness(1.1);\n}\n\n.pdial__walls {\n  position: absolute;\n  inset: 0;\n  border-radius: inherit;\n  pointer-events: none;\n  opacity: var(--pdial-wash-op);\n  box-shadow:\n    inset 0 calc(var(--pdial-w) * -0.02) calc(var(--pdial-w) * 0.04) calc(var(--pdial-w) * -0.012) color-mix(in srgb, var(--pdial-c3) 80%, white),\n    inset calc(var(--pdial-w) * 0.016) calc(var(--pdial-w) * -0.05) calc(var(--pdial-w) * 0.05) calc(var(--pdial-w) * -0.03) color-mix(in srgb, var(--pdial-c2) 80%, transparent),\n    inset calc(var(--pdial-w) * -0.016) calc(var(--pdial-w) * -0.05) calc(var(--pdial-w) * 0.05) cal