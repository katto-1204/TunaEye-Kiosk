 {\n  position: relative;\n  z-index: 1;\n  display: flex;\n  align-items: center;\n  gap: 12px;\n}\n.grader-dashboard__sync-state {\n  display: flex;\n  align-items: center;\n  gap: 9px;\n  margin-top: 18px;\n  color: var(--secondary);\n  font-size: 14px;\n}\n.grader-dashboard__metrics article {\n  position: relative;\n  display: grid;\n  grid-template-columns: auto 1fr;\n  grid-template-rows: auto auto auto;\n  column-gap: 14px;\n  border-color: #d7e2ef;\n  background: linear-gradient(145deg,#fff,#f8fbff);\n  box-shadow: 0 12px 28px rgba(17,24,39,.07);\n}\n.grader-dashboard__metrics article>span {\n  grid-row: 1/4;\n  width: 48px;\n  height: 48px;\n  display: grid;\n  place-items: center;\n  border-radius: 15px;\n  background: var(--blue-soft);\n  color: var(--blue);\n}\n.grader-dashboard__metrics article small {\n  align-self: end;\n}\n.grader-dashboard__metrics article strong {\n  line-height: 1.05;\n}\n.grader-dashboard__metrics article em {\n  color: var(--muted);\n  font-size: 13px;\n  font-style: normal;\n}\n.grader-dashboard>.admin-table-card {\n  border-color: #d7e2ef;\n  box-shadow: 0 12px 30px rgba(17,24,39,.07);\n}\n@media (max-width:900px) {\n  .grader-dashboard__hero-actions {\n    width: 100%;\n  }\n  .grader-dashboard__hero-actions .btn {\n    flex: 1;\n  }\n  .admin-header-actions .btn span {\n    display: none;\n  }\n}\n@media (max-height:850px) and (orientation:landscape) {\n  .screen-stack--association .association-options button {\n    min-height: 150px !important;\n    max-height: 190px;\n  }\n  .grader-dashboard__sync-state {\n    margin-top: 8px;\n  }\n  .grader-dashboard__hero-actions {\n    gap: 8px;\n  }\n  .grader-dashboard__metrics article>span {\n    width: 38px;\n    height: 38px;\n  }\n  .grader-dashboard__metrics article em {\n    font-size: 11px;\n  }\n}\n.topbar--compact {\n  height: 48px;\n  min-height: 48px;\n  padding: 0 14px 0 16px;\n  gap: 14px;\n}\n.topbar--compact .brand-mark--compact .brand-word {\n  font-size: 15px;\n}\n.topbar--compact .brand-mark--compact .brand-symbol {\n  width: 26px;\n  height: 26px;\n}\n.topbar--compact .brand-mark--compact .brand-symbol>span {\n  width: 8px;\n  height: 8px;\n}\n.topbar--compact .topbar__actions {\n  gap: 8px;\n}\n.topbar--compact .topbar__actions>.status-dot {\n  width: 8px;\n  height: 8px;\n}\n.topbar--compact .icon-button {\n  width: 34px !important;\n  height: 34px !important;\n  border-radius: 10px !important;\n}\n@keyframes welcomeFadeUp {\n  0% {\n    opacity: 0;\n    transform: translateY(28px);\n  }\n  100% {\n    opacity: 1;\n    transform: translateY(0);\n  }\n}\n@keyframes logoPulse {\n  0% {\n    transform: scale(1);\n    opacity: .6;\n  }\n  50% {\n    transform: scale(1.5);\n    opacity: 0;\n  }\n  100% {\n    transform: scale(1.5);\n    opacity: 0;\n  }\n}\n@keyframes logoGlow {\n  0% {\n    box-shadow: 0 0 0 0 rgba(23,107,255,.3);\n  }\n  50% {\n    box-shadow: 0 0 40px 12px rgba(36,120,255,.18);\n  }\n  100% {\n    box-shadow: 0 0 0 0 rgba(23,107,255,.3);\n  }\n}\n.welcome-screen--v2 {\n  position: relative;\n  min-height: 100vh;\n  height: auto;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  overflow: hidden;\n  padding: 0;\n}\n.welcome-screen--v2 .welcome-screen__bg {\n  position: absolute;\n  inset: 0;\n  background: url('/assets/tunaeyebackground.png') center/cover no-repeat;\n  z-index: 0;\n}\n.welcome-screen--v2 .welcome-screen__bg::after {\n  content: '';\n  position: absolute;\n  inset: 0;\n  background: linear-gradient(170deg,rgba(7,17,29,.78) 0%,rgba(17,24,39,.72) 40%,rgba(23,107,255,.45) 100%);\n  backdrop-filter: blur(2px);\n}\n.welcome-screen--v2 .welcome-screen__content {\n  position: relative;\n  z-index: 1;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: clamp(28px,5vh,52px);\n  padding: clamp(28px,5vh,60px) clamp(20px,4vw,48px);\n  max-width: 580px;\n  width: 100%;\n  text-align: center;\n}\n.welcome-brand-hero {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 8px;\n  opacity: 0;\n  transform: translateY(28px);\n}\n.welcome-screen--v2.is-entered .welcome-brand-hero {\n  animation: welcomeFadeUp .7s cubic-bezier(.22,1,.36,1) forwards;\n}\n.welcome-brand-hero__mark {\n  margin-bottom: 6px;\n}\n.kiosk-logo-ring {\n  position: relative;\n  width: 88px;\n  height: 88px;\n  display: grid;\n  place-items: center;\n}\n.kiosk-logo-ring__pulse {\n  position: absolute;\n  inset: 0;\n  border-radius: 50%;\n  border: 2px solid rgba(36,120,255,.5);\n  animation: logoPulse 2.8s ease-out infinite;\n}\n.kiosk-logo-ring__inner {\n  width: 68px;\n  height: 68px;\n  border-radius: 50%;\n  background: linear-gradient(135deg,#176BFF,#2478FF);\n  color: #fff;\n  display: grid;\n  place-items: center;\n  box-shadow: 0 8px 32px rgba(23,107,255,.35);\n  animation: logoGlow 3s ease-in-out infinite;\n}\n.welcome-brand-hero__title {\n  font-family: 'Open Runde',sans-serif;\n  font-size: clamp(52px,9vw,72px);\n  font-weight: 700;\n  letter-spacing: -.06em;\n  line-height: .95;\n  color: #fff;\n  margin: 0;\n}\n.welcome-brand-hero__title span {\n  color: #2478FF;\n}\n.welcome-brand-hero__sub {\n  font-family: 'Open Runde',sans-serif;\n  font-size: clamp(14px,2.5vw,18px);\n  font-weight: 600;\n  letter-spacing: .32em;\n  color: rgba(255,255,255,.55);\n  text-transform: uppercase;\n  margin: 0;\n}\n.welcome-onboard-strip {\n  width: 100%;\n  overflow: hidden;\n  opacity: 0;\n  transform: translateY(18px);\n}\n.welcome-screen--v2.is-entered .welcome-onboard-strip {\n  animation: welcomeFadeUp .7s .25s cubic-bezier(.22,1,.36,1) forwards;\n}\n.welcome-onboard-track {\n  display: flex;\n  width: 300%;\n  transition: transform .5s cubic-bezier(.22,1,.36,1);\n}\n.welcome-onboard-card {\n  flex: 1;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 6px;\n  padding: 18px 14px;\n  border-radius: 18px;\n  background: rgba(255,255,255,.08);\n  border: 1px solid rgba(255,255,255,.1);\n  backdrop-filter: blur(10px);\n  color: rgba(255,255,255,.6);\n  transition: all .4s ease;\n  margin: 0 6px;\n}\n.welcome-onboard-card.is-active {\n  background: rgba(255,255,255,.15);\n  border-color: rgba(255,255,255,.22);\n  color: #fff;\n  transform: scale(1.04);\n}\n.welcome-onboard-card__icon {\n  width: 38px;\n  height: 38px;\n  border-radius: 12px;\n  display: grid;\n  place-items: center;\n  background: rgba(255,255,255,.12);\n  color: #2478FF;\n}\n.welcome-onboard-card strong {\n  font-size: 15px;\n  font-weight: 700;\n  letter-spacing: -.02em;\n}\n.welcome-onboard-card small {\n  font-size: 12px;\n  opacity: .7;\n}\n.welcome-onboard-dots {\n  display: flex;\n  justify-content: center;\n  gap: 8px;\n  margin-top: 14px;\n}\n.welcome-onboard-dots button {\n  width: 8px;\n  height: 8px;\n  border: 0;\n  border-radius: 50%;\n  background: rgba(255,255,255,.25);\n  padding: 0;\n  transition: all .3s ease;\n}\n.welcome-onboard-dots button.is-active {\n  width: 24px;\n  border-radius: 4px;\n  background: #2478FF;\n}\n.welcome-cta-group {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 10px;\n  opacity: 0;\n  transform: translateY(18px);\n}\n.welcome-screen--v2.is-entered .welcome-cta-group {\n  animation: welcomeFadeUp .7s .45s cubic-bezier(.22,1,.36,1) forwards;\n}\n.welcome-cta-main {\n  min-width: 260px;\n  background: linear-gradient(135deg,#176BFF,#1a4fd6) !important;\n  box-shadow: 0 12px 36px rgba(23,107,255,.35) !important;\n  border-radius: 22px !important;\n  color: #fff !important;\n  font-size: 22px !important;\n}\n.welcome-cta-main:hover {\n  box-shadow: 0 16px 44px rgba(23,107,255,.45) !important;\n  transform: translateY(-2px) scale(1.02);\n}\n.welcome-cta-group .btn--ghost {\n  color: rgba(255,255,255,.6) !important;\n}\n.welcome-cta-group .btn--ghost:hover {\n  color: #fff !important;\n  background: rgba(255,255,255,.1) !important;\n}\n.tutorial-fab--glass {\n  position: absolute;\n  right: 20px;\n  bottom: 20px;\n  z-index: 2;\n  width: 48px;\n  height: 48px;\n  padding: 0;\n  border: 1px solid rgba(255,255,255,.18);\n  background: rgba(255,255,255,.1);\n  backdrop-filter: blur(12px);\n  border-radius: 50%;\n  color: rgba(255,255,255,.7);\n  display: grid;\n  place-items: center;\n}\n.tutorial-fab--glass:hover {\n  background: rgba(255,255,255,.2);\n  color: #fff;\n}\n.screen-stack--role-v2 {\n  justify-content: center !important;\n  align-items: center !important;\n  gap: clamp(24px,4vh,44px) !important;\n}\n.role-title-v2 {\n  font-family: 'Open Runde',sans-serif;\n  font-size: clamp(36px,5.5vw,56px);\n  font-weight: 700;\n  letter-spacing: -.05em;\n  color: var(--navy);\n  margin: 0;\n  text-align: center;\n}\n.role-actions--v2 {\n  display: grid !important;\n  grid-template-columns: repeat(2,minmax(0,1fr)) !important;\n  gap: clamp(14px,2.5vw,24px) !important;\n  width: min(100%,640px) !important;\n  max-width: 640px !important;\n  margin: 0 auto !important;\n}\n.role-card-v2 {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  gap: clamp(10px,1.8vh,18px);\n  min-height: clamp(180px,28vh,280px);\n  padding: clamp(24px,3vw,36px);\n  border: 1px solid var(--border);\n  border-radius: clamp(22px,3vw,32px);\n  background: var(--surface);\n  box-shadow: 0 8px 28px rgba(17,24,39,.06);\n  text-align: center;\n  transition: all .22s cubic-bezier(.22,1,.36,1);\n  cursor: pointer;\n}\n.role-card-v2:hover {\n  transform: translateY(-4px);\n  border-color: #a9c3e7;\n  box-shadow: 0 16px 44px rgba(17,24,39,.12);\n}\n.role-card-v2:active {\n  transform: scale(.98);\n}\n.role-card-v2__icon {\n  width: clamp(58px,8vw,76px);\n  height: clamp(58px,8vw,76px);\n  border-radius: clamp(18px,2.5vw,24px);\n  display: grid;\n  place-items: center;\n}\n.role-card-v2__icon--admin {\n  background: var(--blue-soft);\n  color: var(--blue);\n}\n.role-card-v2__icon--expert {\n  background: var(--blue);\n  color: #fff;\n}\n.role-card-v2 strong {\n  font-family: 'Open Runde',san