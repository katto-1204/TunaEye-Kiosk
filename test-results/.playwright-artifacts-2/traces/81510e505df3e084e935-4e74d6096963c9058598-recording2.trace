sis-screen__info {\n  display: flex;\n  flex-direction: column;\n  gap: 20px;\n}\n.analysis-screen__info .eyebrow {\n  color: var(--blue);\n}\n.analysis-screen__info h1 {\n  margin: 6px 0 4px;\n  font-size: clamp(28px,3.5vw,46px);\n  letter-spacing: -.045em;\n  color: var(--navy);\n  line-height: 1.08;\n}\n.analysis-screen__info p {\n  margin: 0;\n  color: var(--secondary);\n  font-size: clamp(15px,1.6vw,18px);\n  line-height: 1.5;\n}\n.analysis-status {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  padding: 14px 18px;\n  border: 1px solid var(--border);\n  border-radius: 14px;\n  background: #fff;\n  color: var(--secondary);\n  font-size: 15px;\n  font-weight: 500;\n  margin-top: 4px;\n}\n@media (max-width:680px) {\n  .analysis-screen--split {\n    grid-template-columns: 1fr;\n    gap: 14px;\n  }\n  .analysis-screen--split .analysis-screen__visual {\n    height: 38vw;\n    min-height: 180px;\n    max-height: 260px;\n  }\n  .analysis-screen__info h1 {\n    font-size: 26px;\n  }\n}\n.override-lock {\n  display: grid;\n  gap: 18px;\n  margin-top: 18px;\n}\n.override-lock p {\n  margin: 0;\n  color: var(--secondary);\n  font-size: 18px;\n}\n.screen-stack--overview .section-heading {\n  width: 100%;\n  max-width: 1080px;\n  margin-inline: auto;\n}\n.screen-stack--overview .section-heading h1 {\n  font-size: clamp(40px,4.6vw,62px) !important;\n  line-height: 1.02;\n  margin: 8px 0 14px;\n}\n.screen-stack--overview .section-heading p {\n  max-width: 900px;\n  font-size: clamp(19px,2vw,25px) !important;\n  line-height: 1.42;\n}\n.screen-stack--overview .overview-card:only-child {\n  width: min(100%,1040px);\n  justify-self: center;\n  padding: clamp(30px,4vw,54px) !important;\n  gap: clamp(20px,3vh,34px);\n}\n.screen-stack--overview .overview-card:only-child .overview-card__head {\n  gap: clamp(22px,3vw,42px);\n}\n.screen-stack--overview .overview-card:only-child .result-sample-image {\n  width: clamp(230px,29vw,390px) !important;\n  height: clamp(150px,21vh,2