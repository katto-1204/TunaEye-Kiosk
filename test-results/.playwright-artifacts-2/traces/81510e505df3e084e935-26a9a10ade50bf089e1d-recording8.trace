_copy h1 {\n  font-size: clamp(24px, 3.2vw, 34px) !important;\n  margin: 4px 0 0 !important;\n  color: var(--navy) !important;\n  letter-spacing: -0.04em !important;\n}\n.weight-panel--stacked .weight-entry {\n  padding: 0 !important;\n  width: 100% !important;\n}\n.weight-panel--stacked .weight-row {\n  display: flex !important;\n  align-items: center !important;\n  justify-content: space-between !important;\n  padding: 10px 14px !important;\n  border: 2px solid #e2e8f0 !important;\n  border-radius: 16px !important;\n  background: #f8fafc !important;\n  transition: all 0.2s ease !important;\n}\n.weight-panel--stacked .weight-row.is-active-fish {\n  border-color: var(--blue) !important;\n  background: #eff6ff !important;\n  box-shadow: 0 0 0 3px rgba(23, 107, 255, 0.15) !important;\n}\n.weight-panel--stacked .weight-input {\n  display: flex !important;\n  align-items: baseline !important;\n  gap: 4px !important;\n  border-bottom: none !important;\n  padding: 0 !important;\n}\n.weight-panel--stacked .weight-input input {\n  font-family: 'Open Runde', sans-serif !important;\n  font-size: clamp(34px, 4.5vw, 48px) !important;\n  font-weight: 700 !important;\n  color: var(--navy) !important;\n  width: 120px !important;\n  text-align: right !important;\n}\n.tutorial-heading .tutorial-stage__number {\n  position: static;\n  display: block;\n  margin-bottom: 8px;\n  color: #061EAE !important;\n  opacity: 1 !important;\n  font-size: clamp(64px,8vw,96px) !important;\n  line-height: .8;\n  text-shadow: none;\n}\n.selector-card__art .sample-art {\n  width: auto;\n  height: auto;\n  object-fit: contain;\n}\n.selector-card__art .sample-art--core {\n  max-width: 98%;\n  max-height: 96%;\n}\n.selector-card__art .sample-art--tail {\n  max-width: 94%;\n  max-height: 92%;\n}\n.grader-home-shortcut {\n  position: fixed;\n  z-index: 9;\n  top: calc(12px + var(--safe-top));\n  right: calc(16px + var(--safe-right));\n  width: 42px;\n  height: 42px;\n  display: grid;\n  place-items: center