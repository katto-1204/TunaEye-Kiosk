ermal-slip-divider {\n    font-family: 'Courier New', Courier, monospace !important;\n    font-size: 9px !important;\n    letter-spacing: -0.05em !important;\n    text-align: center !important;\n    margin: 1.5mm 0 !important;\n    color: #000000 !important;\n    white-space: nowrap !important;\n    overflow: hidden !important;\n  }\n  .thermal-slip-row {\n    display: flex !important;\n    justify-content: space-between !important;\n    align-items: baseline !important;\n    font-size: 10px !important;\n    margin-bottom: 1mm !important;\n    color: #000000 !important;\n  }\n  .thermal-slip-row--head {\n    font-weight: 700 !important;\n    font-size: 9.5px !important;\n    text-transform: uppercase !important;\n  }\n  .thermal-slip-detail {\n    font-size: 9px !important;\n    color: #222222 !important;\n    margin-top: -0.5mm !important;\n    margin-bottom: 1.5mm !important;\n  }\n  .thermal-slip-grade-box {\n    border: 2px solid #000000 !important;\n    padding: 2mm 1mm !important;\n    text-align: center !important;\n    margin: 2mm 0 !important;\n    background: #ffffff !important;\n  }\n  .thermal-slip-grade-label {\n    font-size: 9px !important;\n    font-weight: 700 !important;\n    letter-spacing: 0.08em !important;\n    color: #000000 !important;\n  }\n  .thermal-slip-grade-value {\n    font-size: 19px !important;\n    font-weight: 900 !important;\n    letter-spacing: 0.05em !important;\n    margin: 1mm 0 !important;\n    color: #000000 !important;\n  }\n  .thermal-slip-grade-sub {\n    font-size: 8px !important;\n    color: #333333 !important;\n    font-weight: 600 !important;\n  }\n  .thermal-slip-barcode {\n    text-align: center !important;\n    margin: 2.5mm 0 1mm 0 !important;\n  }\n  .thermal-slip-barcode-svg {\n    width: 42mm !important;\n    height: 9mm !important;\n    margin: 0 auto !important;\n    display: block !important;\n  }\n  .thermal-slip-barcode-svg rect {\n    fill: #000000 !important;\n  }\n  .thermal-slip-barcode-text {\n    font-size: 8.5px !important;\n    letter-spacing: 0.18em !important;\n    margin-top: 1mm !important;\n    color: #000000 !important;\n    text-align: center !important;\n  }\n  .thermal-slip-footer {\n    text-align: center !important;\n    font-size: 8px !important;\n    margin-top: 2.5mm !important;\n    line-height: 1.4 !important;\n    color: #000000 !important;\n  }\n  .thermal-slip-feed-margin {\n    height: 10mm !important;\n  }\n}\n@media (max-width:680px) {\n  .app-main:not(.app-main--welcome):not(.app-main--complete):not(.app-main--admin-dashboard) {\n    height: calc(100dvh - 78px) !important;\n    overflow: hidden !important;\n  }\n  .screen-stack--camera,.screen-stack--review,.screen-stack--result,.screen-stack--overview,.screen-stack--tutorial {\n    padding-block: 20px 12px !important;\n    gap: 10px !important;\n  }\n  .camera-layout,.review-layout {\n    gap: 10px !important;\n  }\n  .live-camera,.live-camera video {\n    height: 28vh !important;\n    min-height: 170px !important;\n  }\n  .camera-aside h1,.review-aside h1 {\n    font-size: 27px !important;\n    margin: 5px 0 !important;\n  }\n  .camera-aside>p,.review-aside>p {\n    display: none;\n  }\n  .sample-context {\n    margin: 4px 0 !important;\n  }\n  .sample-context .sample-art {\n    width: 52px;\n    height: 38px;\n  }\n  .camera-selector {\n    margin: 4px 0 !important;\n    padding: 8px !important;\n  }\n  .camera-selector select {\n    min-height: 48px;\n  }\n  .quality-list {\n    display: none;\n  }\n  .demo-outcome {\n    margin-top: 4px !important;\n    padding: 8px !important;\n  }\n  .demo-outcome small {\n    display: none;\n  }\n  .bottom-bar {\n    min-height: 64px !important;\n    padding: 6px 0 !important;\n  }\n  .bottom-bar .btn {\n    min-height: 56px !important;\n    font-size: 17px !important;\n  }\n  .review-layout .evidence-frame {\n    height: 37vh !important;\n    min-height: 210px !important;\n  }\n  .review-note {\n    margin-top: 10px;\n    padding-top: 10px;\n  