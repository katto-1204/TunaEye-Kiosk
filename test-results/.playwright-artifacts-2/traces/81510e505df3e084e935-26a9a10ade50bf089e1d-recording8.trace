reen-stack--role .role-button {\n    min-height: 0 !important;\n    height: 100% !important;\n    padding: 20px !important;\n  }\n  .screen-stack--role .role-intro h1 {\n    font-size: 34px;\n  }\n  .screen-stack--role .role-bottom {\n    padding-bottom: var(--safe-bottom);\n  }\n}\n.thermal-print-slip {\n  display: none !important;\n}\n@media print {\n  @page {\n    size: 58mm auto;\n    margin: 0;\n  }\n  html, body {\n    width: 58mm !important;\n    min-width: 58mm !important;\n    max-width: 58mm !important;\n    height: auto !important;\n    background: #ffffff !important;\n    margin: 0 !important;\n    padding: 0 !important;\n    overflow: visible !important;\n    -webkit-print-color-adjust: exact !important;\n    print-color-adjust: exact !important;\n  }\n  body * {\n    visibility: hidden !important;\n  }\n  .thermal-print-slip, .thermal-print-slip * {\n    visibility: visible !important;\n  }\n  .thermal-print-slip {\n    display: block !important;\n    position: fixed !important;\n    left: 0 !important;\n    top: 0 !important;\n    width: 58mm !important;\n    max-width: 58mm !important;\n    margin: 0 !important;\n    padding: 3mm 4mm 8mm 4mm !important;\n    box-sizing: border-box !important;\n    background: #ffffff !important;\n    color: #000000 !important;\n    font-family: 'Courier New', Courier, monospace, monospace !important;\n    line-height: 1.35 !important;\n  }\n  .thermal-slip-header {\n    text-align: center !important;\n    margin-bottom: 2mm !important;\n  }\n  .thermal-slip-logo {\n    font-size: 15px !important;\n    font-weight: 900 !important;\n    letter-spacing: 0.08em !important;\n    color: #000000 !important;\n  }\n  .thermal-slip-title {\n    font-size: 11px !important;\n    font-weight: 700 !important;\n    letter-spacing: 0.04em !important;\n    margin-top: 1mm !important;\n    color: #000000 !important;\n  }\n  .thermal-slip-subtitle {\n    font-size: 9px !important;\n    color: #333333 !important;\n  }\n  .thermal-slip-d