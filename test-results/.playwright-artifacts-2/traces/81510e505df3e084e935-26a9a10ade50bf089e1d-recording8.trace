   width: 60px;\n    height: 60px;\n    margin-bottom: 6px;\n  }\n  .complete-screen h1 {\n    font-size: 40px;\n  }\n  .complete-screen p {\n    font-size: 16px;\n  }\n  .complete-print-list {\n    margin-top: 12px;\n  }\n  .complete-screen__meta {\n    margin-top: 10px;\n  }\n  .complete-screen__actions {\n    margin-top: 14px;\n  }\n  .auto-reset-note {\n    bottom: 8px;\n  }\n  .welcome-screen {\n    min-height: 100vh !important;\n    height: auto !important;\n    padding: 18px 28px !important;\n    overflow-y: auto !important;\n  }\n  .welcome-screen__hero h1 {\n    font-size: clamp(42px,7vh,58px);\n  }\n  .welcome-screen__hero p {\n    font-size: 16px;\n  }\n  .welcome-illustration {\n    transform: scale(.78);\n    transform-origin: center;\n    margin-top: 0;\n  }\n  .welcome-screen__cta {\n    padding-bottom: 4px;\n  }\n  .modal-card {\n    max-height: calc(100dvh - 28px);\n    padding: 20px;\n    overflow: hidden;\n  }\n  .modal-card__header h2 {\n    font-size: 25px;\n  }\n  .override-lock {\n    gap: 10px;\n    margin-top: 10px;\n  }\n}\n.screen-stack--grader {\n  position: relative;\n  max-width: 1180px;\n  justify-content: center;\n  background: radial-gradient(circle at 20% 28%,rgba(36,120,255,.10),transparent 35%),linear-gradient(135deg,rgba(255,255,255,.82),rgba(234,242,255,.52));\n  border-radius: 0 0 34px 34px;\n}\n.grader-entry {\n  position: relative;\n  z-index: 1;\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 72px;\n  align-items: center;\n  width: 100%;\n  padding: 46px;\n  border: 1px solid rgba(222,230,239,.86);\n  background: rgba(255,255,255,.78);\n  border-radius: 30px;\n  box-shadow: var(--shadow);\n}\n.grader-entry__copy {\n  display: flex;\n  flex-direction: column;\n  align-items: flex-start;\n  gap: 16px;\n}\n.grader-entry__copy .brand-mark {\n  margin-bottom: 22px;\n}\n.grader-entry__copy h1 {\n  font-size: 52px;\n  line-height: 1.02;\n  letter-spacing: -.06em;\n  margin: 0;\n  color: var(--navy);\n}\n.grader-entry__copy p {\n  font-size: 20px;\n  line-height: 1.48;\n  color: var(--secondary);\n  max-width: 470px;\n  margin: 0;\n}\n.grader-entry__form {\n  padding: 12px 0;\n}\n.field-label {\n  display: flex;\n  flex-direction: column;\n  gap: 10px;\n  color: var(--secondary);\n  font-size: 16px;\n}\n.field-label input,.field-label textarea {\n  border: 1px solid var(--border);\n  border-radius: 18px;\n  background: #fff;\n  color: var(--navy);\n  padding: 0 18px;\n  min-height: 62px;\n  outline: none;\n  box-shadow: var(--shadow-soft);\n}\n.field-label textarea {\n  padding: 14px 16px;\n  resize: vertical;\n  min-height: 94px;\n}\n.grader-profiles {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 8px;\n  margin-top: 16px;\n}\n.grader-profiles button {\n  min-height: 46px;\n  border: 1px solid var(--border);\n  background: #f7faff;\n  color: var(--secondary);\n  padding: 0 14px;\n  border-radius: 14px;\n  font-size: 14px;\n}\n.grader-profiles button.is-selected {\n  border-color: var(--blue);\n  color: var(--blue);\n  background: var(--blue-soft);\n  font-weight: 600;\n}\n.remember-row {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  color: var(--secondary);\n  font-size: 16px;\n  margin-top: 26px;\n}\n.remember-row input {\n  width: 20px;\n  height: 20px;\n  accent-color: var(--blue);\n}\n.legal-links {\n  display: flex;\n  gap: 8px;\n  align-items: center;\n  color: var(--muted);\n  font-size: 14px;\n  margin-top: 32px;\n}\n.legal-links button {\n  border: 0;\n  background: transparent;\n  color: var(--blue);\n  text-decoration: underline;\n  text-underline-offset: 3px;\n  padding: 0;\n  font-size: 14px;\n}\n.legal-links button:hover {\n  color: var(--blue-dark);\n}\n.error-text {\n  display: flex;\n  align-items: center;\n  gap: 7px;\n  color: var(--red);\n  font-size: 15px;\n  margin-top: 10px;\n}\n.sample-options--three {\n  grid-template-columns: repeat(3,1fr);\n  align-items: stretch;\n}\n.selector-card {\n  min-height: 340px;\n  padding: 20px;\n}\n.selector-card.is-selected {\n  padding: 18px;\n}\n.selector-card__art {\n  width: 100%;\n  height: 170px;\n  display: flex;\n  gap: 8px;\n  align-items: center;\n  justify-content: center;\n  border-radius: 19px;\n  overflow: hidden;\n  background: #f5f9fd;\n}\n.selector-card__art .sample-art {\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n}\n.selector-card__art .sample-art:only-child {\n  width: 100%;\n}\n.selector-card__art .sample-art:not(:only-child) {\n  width: 50%;\n  object-fit: cover;\n}\n.selector-note {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  color: var(--secondary);\n  font-size: 15px;\n  padding: 14px 16px;\n  border: 1px solid var(--border);\n  border-radius: 16px;\n  background: #fff;\n  width: max-content;\n  max-width: 100%;\n}\n.sample-art {\n  display: block;\n  max-width: 100%;\n  object-fit: cover;\n  border-radius: 18px;\n}\n.association-copy {\n  max-width: 760px;\n}\n.association-copy h1 {\n  font-size: 52px;\n  line-height: 1.03;\n  letter-spacing: -.06em;\n  margin: 14px 0;\n}\n.association-copy p {\n  font-size: 20px;\n  line-height: 1.45;\n  color: var(--secondary);\n  max-width: 700px;\n}\n.association-options {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 22px;\n  margin-top: 20px;\n}\n.association-options button {\n  position: relative;\n  min-height: 190px;\n  border: 1px solid var(--border);\n  background: #fff;\n  border-radius: 26px;\n  padding: 26px;\n  text-align: left;\n  box-shadow: var(--shadow-soft);\n  display: flex;\n  flex-direction: column;\n  align-items: flex-start;\n  gap: 12px;\n  transition: transform .18s ease,border-color .18s ease,box-shadow .18s ease;\n}\n.association-options button:hover {\n  transform: translateY(-2px);\n  border-color: #a9c3e7;\n}\n.association-options button.is-selected {\n  border: 3px solid var(--blue);\n  padding: 24px;\n  background: #f8fbff;\n}\n.association-options button>span:first-child {\n  width: 56px;\n  height: 56px;\n  border-radius: 18px;\n  display: grid;\n  place-items: center;\n  background: var(--blue-soft);\n  color: var(--blue);\n}\n.association-options button strong {\n  font-size: 25px;\n  letter-spacing: -.03em;\n}\n.association-options button small {\n  font-size: 16px;\n  color: var(--secondary);\n}\n.association-options button>svg:last-child {\n  position: absolute;\n  right: 20px;\n  top: 20px;\n  color: var(--blue);\n}\n.single-fish-card {\n  display: flex;\n  align-items: center;\n  gap: 16px;\n  width: min(560px,100%);\n  padding: 24px;\n  background: #fff;\n  border: 1px solid var(--border);\n  border-radius: 22px;\n  box-shadow: var(--shadow-soft);\n}\n.single-fish-card__icon {\n  width: 58px;\n  height: 58px;\n  border-radius: 18px;\n  display: grid;\n  place-items: center;\n  background: #e9f6ef;\n  color: var(--green);\n}\n.single-fish-card div {\n  display: flex;\n  flex-direction: column;\n  gap: 5px;\n}\n.single-fish-card strong {\n  font-size: 21px;\n}\n.single-fish-card small {\n  color: var(--secondary);\n  font-size: 16px;\n}\n.screen-stack--tutorial {\n  display: grid;\n  grid-template-columns: 36% 64%;\n  grid-template-rows: 1fr auto auto;\n  gap: 16px 38px;\n}\n.tutorial-heading {\n  align-self: center;\n}\n.tutorial-heading h1 {\n  font-size: 48px;\n  line-height: 1.04;\n  letter-spacing: -.06em;\n  margin: 14px 0;\n}\n.tutorial-heading p {\n  font-size: 20px;\n  line-height: 1.45;\n  color: var(--secondary);\n  max-width: 380px;\n}\n.tutorial-sample-chips {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 8px;\n  margin-top: 26px;\n}\n.tutorial-sample-chips span {\n  padding: 8px 12px;\n  border: 1px solid #c7d9ef;\n  color: var(--blue);\n  background: var(--blue-soft);\n  border-radius: 999px;\n  font-size: 14px;\n  font-weight: 600;\n}\n.tutorial-stage {\n  position: relative;\n}\n.tutorial-stage .evidence-frame {\n  min-height: 420px;\n}\n.tutorial-stage__number {\n  position: absolute;\n  z-index: 3;\n  left: -22px;\n  top: 10px;\n  font-size: 78px;\n  line-height: 1;\n  color: #d7e5fa;\n  font-weight: 700;\n  letter-spacing: -.08em;\n}\n.tutorial-stage__callout {\n  position: absolute;\n  z-index: 3;\n  right: 22px;\n  bottom: 22px;\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  color: var(--blue);\n  font-size: 14px;\n  background: rgba(255,255,255,.9);\n  border-radius: 14px;\n  padding: 10px 12px;\n}\n.tutorial-dots {\n  grid-column: 1 / -1;\n  display: flex;\n  gap: 8px;\n  justify-content: center;\n}\n.tutorial-dots button {\n  width: 44px;\n  height: 8px;\n  border: 0;\n  border-radius: 99px;\n  background: #dce5f0;\n}\n.tutorial-dots button.is-active {\n  background: var(--blue);\n}\n.weight-entry--multi {\n  display: flex;\n  flex-direction: column;\n  gap: 14px;\n}\n.weight-row {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 18px;\n  padding: 14px 0;\n  border-bottom: 1px solid var(--line);\n}\n.weight-row>span {\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n  min-width: 130px;\n  color: var(--navy);\n  font-size: 18px;\n  font-weight: 600;\n}\n.weight-row>span small {\n  color: var(--muted);\n  font-size: 13px;\n  font-weight: 400;\n}\n.weight-row .weight-input {\n  width: 220px;\n}\n.weight-row .weight-input input {\n  font-size: 52px;\n}\n.weight-row .weight-input b {\n  color: var(--secondary);\n  font-size: 18px;\n  font-weight: 500;\n  padding-bottom: 7px;\n}\n.sample-context {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  margin: 18px 0;\n}\n.sample-context .sample-art {\n  width: 68px;\n  height: 48px;\n  object-fit: cover;\n  border-radius: 12px;\n}\n.sample-context span {\n  display: flex;\n  flex-direction: column;\n  gap: 2px;\n}\n.sample-context strong {\n  font-size: 17px;\n}\n.sample-context small {\n  font-size: 13px;\n  color: var(--secondary);\n}\n.individual-result-layout {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 64px;\n  align-items: center;\n}\n.grade-letter--B {\n  color: var(--amber);\n}\n.grade-letter--C {\n  color: var(--red);\n}\n.individual-result-layout .grade-hero h1 {\n  font-size: 40px;\n  max-width: 490px;\n}\n.result-details>.result-sample-image {\n  width: 100%;\n  height: 190px;\n  object-fit: cover;\n  margin-bottom: 16px;\n}\n.result-badges {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 8px;\n  margin-top: 22px;\n}\n.result-badges span {\n  padding: 8px 11px;\n  border-radius: 999px;\n  background: #f0f5fa;\n  color: var(--secondary);\n  font-size: 14px;\n}\n.result-badges .override-badge {\n  background: #fff4d9;\n  color: var(--amber);\n  font-weight: 600;\n}\n.overview-cards {\n  display: grid;\n  grid-template-columns: repeat(2,1fr);\n  gap: 20px;\n}\n.overview-card {\n  padding: 18px;\n  border: 1px solid var(--border);\n  background: #fff;\n  border-radius: 24px;\n  box-shadow: var(--shadow-soft);\n}\n.overview-card__head {\n  display: flex;\n  gap: 14px;\n  align-items: center;\n}\n.overview-card__head .result-sample-image {\n  width: 146px;\n  height: 92px;\n  object-fit: cover;\n  border-radius: 16px;\n}\n.overview-card h2 {\n  font-size: 23px;\n  letter-spacing: -.03em;\n  margin: 5px 0;\n}\n.status-label {\n  display: inline-flex;\n  padding: 6px 9px;\n  border-radius: 999px;\n  font-size: 13px;\n  font-weight: 600;\n}\n.status-label--valid {\n  background: #e9f6ef;\n  color: var(--green);\n}\n.status-label--uncertain {\n  background: #fff5db;\n  color: var(--amber);\n}\n.status-label--invalid {\n  background: #fff0ec;\n  color: var(--red);\n}\n.overview-card__stats {\n  display: flex;\n  gap: 22px;\n  border-top: 1px solid var(--line);\n  border-bottom: 1px solid var(--line);\n  margin: 16px 0 8px;\n  padding: 12px 0;\n}\n.overview-card__stats span {\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n}\n.overview-card__stats small {\n  color: var(--muted);\n  font-size: 13px;\n}\n.overview-card__stats strong {\n  font-size: 16px;\n}\n.overview-card>.btn {\n  padding-left: 0;\n}\n.combined-panel {\n  display: flex;\n  align-items: flex-start;\n  gap: 15px;\n  padding: 20px;\n  border-radius: 22px;\n  border: 1px solid #c9dcef;\n  background: #f8fbff;\n}\n.combined-panel--different {\n  border-color: #ead8d1;\n  background: #fffaf8;\n}\n.combined-panel__icon {\n  width: 46px;\n  height: 46px;\n  border-radius: 15px;\n  display: grid;\n  place-items: center;\n  background: var(--blue-soft);\n  color: var(--blue);\n  flex: none;\n}\n.combined-panel--different .combined-panel__icon {\n  background: #fff0ec;\n  color: var(--red);\n}\n.combined-panel h2 {\n  font-size: 21px;\n  margin: 5px 0;\n}\n.combined-panel p {\n  font-size: 15px;\n  line-height: 1.4;\n  color: var(--secondary);\n  margin: 0;\n}\n.admin-dashboard {\n  width: min(1100px,calc(100% - 96px));\n  margin: 0 auto;\n  flex: 1;\n  padding: 58px 0 34px;\n}\n.admin-dashboard__intro {\n  display: flex;\n  justify-content: space-between;\n  align-items: flex-end;\n  gap: 20px;\n}\n.admin-dashboard h1 {\n  font-size: 50px;\n  letter-spacing: -.06em;\n  margin: 12px 0;\n}\n.admin-dashboard__intro p {\n  color: var(--secondary);\n  font-size: 19px;\n  margin: 0;\n}\n.admin-grid {\n  display: grid;\n  grid-template-columns: repeat(2,1fr);\n  gap: 18px;\n  margin-top: 42px;\n}\n.admin-card {\n  min-height: 150px;\n  display: grid;\n  grid-template-columns: auto 1fr auto;\n  grid-template-rows: auto auto;\n  align-items: center;\n  column-gap: 16px;\n  text-align: left;\n  padding: 22px;\n  border: 1px solid var(--border);\n  background: #fff;\n  border-radius: 22px;\n  box-shadow: var(--shadow-soft);\n  color: var(--navy);\n}\n.admin-card>span {\n  grid-row: 1 / span 2;\n  width: 58px;\n  height: 58px;\n  border-radius: 18px;\n  display: grid;\n  place-items: center;\n  background: var(--blue-soft);\n  color: var(--blue);\n}\n.admin-card strong {\n  font-size: 22px;\n}\n.admin-card small {\n  font-size: 15px;\n  color: var(--secondary);\n}\n.admin-card>svg {\n  grid-column: 3;\n  grid-row: 1 / span 2;\n  color: #93a1b1;\n}\n.admin-status {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  color: var(--secondary);\n  font-size: 15px;\n  margin-top: 24px;\n}\n.admin-status span:last-child {\n  margin-left: auto;\n  color: var(--muted);\n}\n.print-queue {\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n  margin-top: 28px;\n}\n.print-queue>div {\n  display: grid;\n  grid-template-columns: 28px 1fr auto;\n  align-items: center;\n  gap: 10px;\n  padding: 11px 12px;\n  border: 1px solid var(--border);\n  border-radius: 14px;\n  color: var(--secondary);\n  background: #fff;\n}\n.print-queue>div>span {\n  width: 24px;\n  height: 24px;\n  display: grid;\n  place-items: center;\n  border-radius: 50%;\n  background: #eef3f8;\n  font-size: 12px;\n}\n.print-queue>div.is-current {\n  border-color: #9cbef0;\n  background: var(--blue-soft);\n  color: var(--blue);\n}\n.print-queue>div.is-current>span {\n  background: var(--blue);\n  color: #fff;\n}\n.print-queue>div.is-printed {\n  color: var(--green);\n  background: #f4fbf6;\n}\n.print-queue>div.is-printed>span {\n  background: #e9f6ef;\n}\n.print-queue small {\n  font-size: 12px;\n  color: var(--muted);\n}\n.receipt__sample {\n  display: flex;\n  justify-content: space-between;\n  gap: 10px;\n  border-bottom: 1px dashed #c7d3df;\n  padding-bottom: 12px;\n  font-size: 13px;\n}\n.receipt__sample span {\n  color: var(--secondary);\n}\n.receipt__sample strong {\n  font-weight: 600;\n}\n.complete-print-list {\n  display: flex;\n  flex-wrap: wrap;\n  justify-content: center;\n  gap: 8px;\n  margin-top: 24px;\n}\n.complete-print-list span {\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n  padding: 9px 12px;\n  border-radius: 999px;\n  background: #e9f6ef;\n  color: var(--green);\n  font-size: 14px;\n}\n.override-modal {\n  max-width: 620px;\n}\n.override-modal>p {\n  color: var(--secondary);\n  font-size: 16px;\n  line-height: 1.45;\n}\n.override-grades {\n  display: flex;\n  gap: 10px;\n  margin: 12px 0 22px;\n}\n.override-grades button {\n  flex: 1;\n  min-height: 58px;\n  border: 1px solid var(--border);\n  border-radius: 16px;\n  background: #fff;\n  color: var(--secondary);\n  font-size: 18px;\n  font-weight: 600;\n}\n.override-grades button.is-selected {\n  border: 2px solid var(--blue);\n  background: var(--blue-soft);\n  color: var(--blue);\n}\n.override-modal__actions {\n  display: flex;\n  justify-content: flex-end;\n  gap: 12px;\n  margin-top: 24px;\n}\n.legal-modal>p {\n  color: var(--secondary);\n  font-size: 17px;\n  line-height: 1.55;\n}\n@media (max-width:1100px) {\n  .grader-entry {\n    gap: 36px;\n    padding: 32px;\n  }\n  .sample-options--three {\n    grid-template-columns: 1fr;\n  }\n  .selector-card {\n    min-height: 220px;\n    display: grid;\n    grid-template-columns: 180px 1fr auto;\n    align-items: center;\n  }\n  .selector-card__art {\n    height: 150px;\n  }\n  .screen-stack--tutorial {\n    display: flex;\n  }\n  .tutorial-stage {\n    width: 100%;\n  }\n  .tutorial-stage .evidence-frame {\n    min-height: 340px;\n  }\n  .individual-result-layout {\n    gap: 34px;\n  }\n  .admin-dashboard {\n    width: calc(100% - 56px);\n  }\n}\n@media (max-width:680px) {\n  .grader-entry {\n    grid-template-columns: 1fr;\n    padding: 24px;\n    gap: 30px;\n  }\n  .grader-entry__copy h1 {\n    font-size: 40px;\n  }\n  .grader-entry__copy p {\n    font-size: 18px;\n  }\n  .grader-entry__copy .brand-mark {\n    margin-bottom: 6px;\n  }\n  .selector-card {\n    display: flex;\n    min-height: 220px;\n  }\n  .selector-card__art {\n    height: 120px;\n  }\n  .association-copy h1,.tutorial-heading h1,.admin-dashboard h1 {\n    font-size: 38px;\n  }\n  .association-options,.overview-cards,.admin-grid {\n    grid-template-columns: 1fr;\n  }\n  .association-options button {\n    min-height: 155px;\n  }\n  .screen-stack--tutorial {\n    display: flex;\n  }\n  .tutorial-stage__number {\n    left: 4px;\n    top: 2px;\n    font-size: 60px;\n  }\n  .tutorial-stage__callout {\n    position: static;\n    margin-top: 10px;\n  }\n  .weight-row {\n    align-items: flex-start;\n    flex-direction: column;\n  }\n  .weight-row .weight-input {\n    width: 100%;\n  }\n  .weight-row .weight-input input {\n    font-size: 58px;\n  }\n  .individual-result-layout {\n    display: flex;\n    flex-direction: column;\n    align-items: stretch;\n    gap: 24px;\n  }\n  .result-details>.result-sample-image {\n    height: 150px;\n  }\n  .admin-dashboard {\n    width: calc(100% - 36px);\n    padding-top: 34px;\n  }\n  .admin-dashboard__intro {\n    align-items: flex-start;\n    flex-direction: column;\n  }\n  .admin-dashboard__intro .btn {\n    width: 100%;\n  }\n  .admin-card {\n    min-height: 128px;\n  }\n  .admin-status {\n    align-items: flex-start;\n    flex-direction: column;\n  }\n  .admin-status span:last-child {\n    margin-left: 0;\n  }\n  .override-modal__actions {\n    flex-direction: column-reverse;\n  }\n  .override-modal__actions .btn {\n    width: 100%;\n  }\n}\n.screen-stack--association {\n  grid-template-rows: auto auto minmax(64px,1fr) !important;\n}\n.screen-stack--association .association-options {\n  height: auto !important;\n  min-height: 0 !important;\n  align-self: start;\n  align-items: stretch;\n  margin-top: 4px !important;\n}\n.screen-stack--association .association-options button {\n  height: auto !important;\n  min-height: clamp(170px,25vh,240px) !important;\n  justify-content: center;\n}\n.grader-dashboard__hero {\n  position: relative;\n  overflow: hidden;\n  border-color: #cbdcf3;\n  background: radial-gradient(circle at 88% 10%,rgba(36,120,255,.2),transparent 34%),linear-gradient(135deg,#fff 0%,#F1F5FF 100%);\n}\n.grader-dashboard__hero:after {\n  content: '';\n  position: absolute;\n  right: -70px;\n  bottom: -100px;\n  width: 260px;\n  height: 260px;\n  border: 42px solid rgba(23,107,255,.06);\n  border-radius: 50%;\n  pointer-events: none;\n}\n.grader-dashboard__hero>div {\n  position: relative;\n  z-index: 1;\n}\n.grader-dashboard__hero-actions {\n  position: relative;\n  z-index: 1;\n  display: flex;\n  align-items: center;\n  gap: 12px;\n}\n.grader-dashboard__sync-state {\n  display: flex;\n  align-items: center;\n  gap: 9px;\n  margin-top: 18px;\n  color: var(--secondary);\n  font-size: 14px;\n}\n.grader-dashboard__metrics article {\n  position: relative;\n  display: grid;\n  grid-template-columns: auto 1fr;\n  grid-template-rows: auto auto auto;\n  column-gap: 14px;\n  border-color: #d7e2ef;\n  background: linear-gradient(145deg,#fff,#f8fbff);\n  box-shadow: 0 12px 28px rgba(17,24,39,.07);\n}\n.grader-dashboard__metrics article>span {\n  grid-row: 1/4;\n  width: 48px;\n  height: 48px;\n  display: grid;\n  place-items: center;\n  border-radius: 15px;\n  background: var(--blue-soft);\n  color: var(--blue);\n}\n.grader-dashboard__metrics article small {\n  align-self: end;\n}\n.grader-dashboard__metrics article strong {\n  line-height: 1.05;\n}\n.grader-dashboard__metrics article em {\n  color: var(--muted);\n  font-size: 13px;\n  font-style: normal;\n}\n.grader-dashboard>.admin-table-card {\n  border-color: #d7e2ef;\n  box-shadow: 0 12px 30px rgba(17,24,39,.07);\n}\n@media (max-width:900px) {\n  .grader-dashboard__hero-actions {\n    width: 100%;\n  }\n  .grader-dashboard__hero-actions .btn {\n    flex: 1;\n  }\n  .admin-header-actions .btn span {\n    display: none;\n  }\n}\n@media (max-height:850px) and (orientation:landscape) {\n  .screen-stack--association .association-options button {\n    min-height: 150px !important;\n    max-height: 190px;\n  }\n  .grader-dashboard__sync-state {\n    margin-top: 8px;\n  }\n  .grader-dashboard__hero-actions {\n    gap: 8px;\n  }\n  .grader-dashboard__metrics article>span {\n    width: 38px;\n    height: 38px;\n  }\n  .grader-dashboard__metrics article em {\n    font-size: 11px;\n  }\n}\n.topbar--compact {\n  height: 48px;\n  min-height: 48px;\n  padding: 0 14px 0 16px;\n  gap: 14px;\n}\n.topbar--compact .brand-mark--compact .brand-word {\n  font-size: 15px;\n}\n.topbar--compact .brand-mark--compact .brand-symbol {\n  width: 26px;\n  height: 26px;\n}\n.topbar--compact .brand-mark--compact .brand-symbol>span {\n  width: 8px;\n  height: 8px;\n}\n.topbar--compact .topbar__actions {\n  gap: 8px;\n}\n.topbar--compact .topbar__actions>.status-dot {\n  width: 8px;\n  height: 8px;\n}\n.topbar--compact .icon-button {\n  width: 34px !important;\n  height: 34px !important;\n  border-radius: 10px !important;\n}\n@keyframes welcomeFadeUp {\n  0% {\n    opacity: 0;\n    transform: translateY(28px);\n  }\n  100% {\n    opacity: 1;\n    transform: translateY(0);\n  }\n}\n@keyframes logoPulse {\n  0% {\n    transform: scale(1);\n    opacity: .6;\n  }\n  50% {\n    transform: scale(1.5);\n    opacity: 0;\n  }\n  100% {\n    transform: scale(1.5);\n    opacity: 0;\n  }\n}\n@keyframes logoGlow {\n  0% {\n    box-shadow: 0 0 0 0 rgba(23,107,255,.3);\n  }\n  50% {\n    box-shadow: 0 0 40px 12px rgba(36,120,255,.18);\n  }\n  100% {\n    box-shadow: 0 0 0 0 rgba(23,107,255,.3);\n  }\n}\n.welcome-screen--v2 {\n  position: relative;\n  min-height: 100vh;\n  height: auto;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  overflow: hidden;\n  padding: 0;\n}\n.welcome-screen--v2 .welcome-screen__bg {\n  position: absolute;\n  inset: 0;\n  background: url('/assets/tunaeyebackground.png') center/cover no-repeat;\n  z-index: 0;\n}\n.welcome-screen--v2 .welcome-screen__bg::after {\n  content: '';\n  position: absolute;\n  inset: 0;\n  background: linear-gradient(170deg,rgba(7,17,29,.78) 0%,rgba(17,24,39,.72) 40%,rgba(23,107,255,.45) 100%);\n  backdrop-filter: blur(2px);\n}\n.welcome-screen--v2 .welcome-screen__content {\n  position: relative;\n  z-index: 1;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: clamp(28px,5vh,52px);\n  padding: clamp(28px,5vh,60px) clamp(20px,4vw,48px);\n  max-width: 580px;\n  width: 100%;\n  text-align: center;\n}\n.welcome-brand-hero {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 8px;\n  opacity: 0;\n  transform: translateY(28px);\n}\n.welcome-screen--v2.is-entered .welcome-brand-hero {\n  animation: welcomeFadeUp .7s cubic-bezier(.22,1,.36,1) forwards;\n}\n.welcome-brand-hero__mark {\n  margin-bottom: 6px;\n}\n.kiosk-logo-ring {\n  position: relative;\n  width: 88px;\n  height: 88px;\n  display: grid;\n  place-items: center;\n}\n.kiosk-logo-ring__pulse {\n  position: absolute;\n  inset: 0;\n  border-radius: 50%;\n  border: 2px solid rgba(36,120,255,.5);\n  animation: logoPulse 2.8s ease-out infinite;\n}\n.kiosk-logo-ring__inner {\n  width: 68px;\n  height: 68px;\n  border-radius: 50%;\n  background: linear-gradient(135deg,#176BFF,#2478FF);\n  color: #fff;\n  display: grid;\n  place-items: center;\n  box-shadow: 0 8px 32px rgba(23,107,255,.35);\n  animation: logoGlow 3s ease-in-out infinite;\n}\n.welcome-brand-hero__title {\n  font-family: 'Open Runde',sans-serif;\n  font-size: clamp(52px,9vw,72px);\n  font-weight: 700;\n  letter-spacing: -.06em;\n  line-height: .95;\n  color: #fff;\n  margin: 0;\n}\n.welcome-brand-hero__title span {\n  color: #2478FF;\n}\n.welcome-brand-hero__sub {\n  font-family: 'Open Runde',sans-serif;\n  font-size: clamp(14px,2.5vw,18px);\n  font-weight: 600;\n  letter-spacing: .32em;\n  color: rgba(255,255,255,.55);\n  text-transform: uppercase;\n  margin: 0;\n}\n.welcome-onboard-strip {\n  width: 100%;\n  overflow: hidden;\n  opacity: 0;\n  transform: translateY(18px);\n}\n.welcome-screen--v2.is-entered .welcome-onboard-strip {\n  animation: welcomeFadeUp .7s .25s cubic-bezier(.22,1,.36,1) forwards;\n}\n.welcome-onboard-track {\n  display: flex;\n  width: 300%;\n  transition: transform .5s cubic-bezier(.22,1,.36,1);\n}\n.welcome-onboard-card {\n  flex: 1;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 6px;\n  padding: 18px 14px;\n  border-radius: 18px;\n  background: rgba(255,255,255,.08);\n  border: 1px solid rgba(255,255,255,.1);\n  backdrop-filter: blur(10px);\n  color: rgba(255,255,255,.6);\n  transition: all .4s ease;\n  margin: 0 6px;\n}\n.welcome-onboard-card.is-active {\n  background: rgba(255,255,255,.15);\n  border-color: rgba(255,255,255,.22);\n  color: #fff;\n  transform: scale(1.04);\n}\n.welcome-onboard-card__icon {\n  width: 38px;\n  height: 38px;\n  border-radius: 12px;\n  display: grid;\n  place-items: center;\n  background: rgba(255,255,255,.12);\n  color: #2478FF;\n}\n.welcome-onboard-card strong {\n  font-size: 15px;\n  font-weight: 700;\n  letter-spacing: -.02em;\n}\n.welcome-onboard-card small {\n  font-size: 12px;\n  opacity: .7;\n}\n.welcome-onboard-dots {\n  display: flex;\n  justify-content: center;\n  gap: 8px;\n  margin-top: 14px;\n}\n.welcome-onboard-dots button {\n  width: 8px;\n  height: 8px;\n  border: 0;\n  border-radius: 50%;\n  background: rgba(255,255,255,.25);\n  padding: 0;\n  transition: all .3s ease;\n}\n.welcome-onboard-dots button.is-active {\n  width: 24px;\n  border-radius: 4px;\n  background: #2478FF;\n}\n.welcome-cta-group {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 10px;\n  opacity: 0;\n  transform: translateY(18px);\n}\n.welcome-screen--v2.is-entered .welcome-cta-group {\n  animation: welcomeFadeUp .7s .45s cubic-bezier(.22,1,.36,1) forwards;\n}\n.welcome-cta-main {\n  min-width: 260px;\n  background: linear-gradient(135deg,#176BFF,#1a4fd6) !important;\n  box-shadow: 0 12px 36px rgba(23,107,255,.35) !important;\n  border-radius: 22px !important;\n  color: #fff !important;\n  font-size: 22px !important;\n}\n.welcome-cta-main:hover {\n  box-shadow: 0 16px 44px rgba(23,107,255,.45) !important;\n  transform: translateY(-2px) scale(1.02);\n}\n.welcome-cta-group .btn--ghost {\n  color: rgba(255,255,255,.6) !important;\n}\n.welcome-cta-group .btn--ghost:hover {\n  color: #fff !important;\n  background: rgba(255,255,255,.1) !important;\n}\n.tutorial-fab--glass {\n  position: absolute;\n  right: 20px;\n  bottom: 20px;\n  z-index: 2;\n  width: 