n  --pdial-rim-mid: rgba(255, 255, 255, 0.07);\n  --pdial-ink: #ffffff;\n  --pdial-label-top: #f4f4f4;\n  --pdial-label-bot: #c6c6c6;\n  --pdial-lead-1: #ffffff;\n  --pdial-lead-2: rgba(200, 225, 255, 0.72);\n  --pdial-lead-3: rgba(170, 210, 255, 0.16);\n  --pdial-main-1: #ffffff;\n  --pdial-main-2: #d7e8ff;\n  --pdial-digit-sep: rgba(0, 0, 0, 0.6);\n  --pdial-wash-op: 1;\n  --pdial-hint: rgba(255, 255, 255, 0.6);\n\n  position: relative;\n  display: inline-flex;\n  flex-direction: column;\n  align-items: center;\n  font-family: var(--pdial-font-body);\n  user-select: none;\n  -webkit-user-select: none;\n}\n\n/* light theme */\n.pdial[data-theme=\"light\"] {\n  --pdial-card-top: #fdfcfa;\n  --pdial-card-mid: #f6f4f0;\n  --pdial-card-bot: #efece7;\n  --pdial-card-shadow: 0 0 0 1px rgba(40, 25, 10, 0.06), 0 1px 2px rgba(40, 25, 10, 0.06), 0 40px 70px -35px rgba(20, 50, 90, 0.25);\n  --pdial-rim-top: rgba(255, 255, 255, 1);\n  --pdial-rim-mid: rgba(255, 255, 255, 0.4);\n  --pdial-ink: #111827;\n  --pdial-label-top: #111827;\n  --pdial-label-bot: #0B45E5;\n  --pdial-lead-1: #111827;\n  --pdial-lead-2: rgba(15, 45, 90, 0.62);\n  --pdial-lead-3: rgba(20, 60, 120, 0.14);\n  --pdial-main-1: #111827;\n  --pdial-main-2: #061EAE;\n  --pdial-digit-sep: rgba(255, 255, 255, 0.85);\n  --pdial-wash-op: 0.78;\n  --pdial-hint: rgba(17, 24, 39, 0.6);\n}\n\n.pdial__wrap {\n  position: relative;\n}\n\n.pdial__card {\n  position: relative;\n  width: var(--pdial-w);\n  height: var(--pdial-h);\n  border-radius: calc(var(--pdial-w) * 0.3);\n  background: radial-gradient(130% 80% at 50% 0%, var(--pdial-card-top) 0%, var(--pdial-card-mid) 45%, var(--pdial-card-bot) 100%);\n  box-shadow: var(--pdial-card-shadow);\n  opacity: 1;\n  touch-action: none;\n  cursor: grab;\n  outline: none;\n  -webkit-tap-highlight-color: transparent;\n  transition:\n    background 0.35s ease,\n    box-shadow 0.35s ease;\n}\n\n.pdial__card[data-dragging=\"true\"] {\n  cursor: grabbing;\n}\n\n.pdial__card:focus-visible .pdial__rim {\n  box-shadow: 0 0 0 2px color-mix(in srgb, var(--pdial-ink) 45%, transparent);\n}\n\n.pdial__rim {\n  position: absolute;\n  inset: 0;\n  padding: 1px;\n  border-radius: inherit;\n  pointer-events: none;\n  background: linear-gradient(\n    180deg,\n    var(--pdial-rim-top) 0%,\n    var(--pdial-rim-mid) 22%,\n    var(--pdial-rim-mid) 52%,\n    color-mix(in srgb, var(--pdial-c2) 70%, transparent) 84%,\n    var(--pdial-c3) 100%\n  );\n  -webkit-mask:\n    linear-gradient(#000 0 0) content-box,\n    linear-gradient(#000 0 0);\n  -webkit-mask-composite: xor;\n  mask:\n    linear-gradient(#000 0 0) content-box exclude,\n    linear-gradient(#000 0 0);\n}\n\n.pdial__clip {\n  position: absolute;\n  inset: 0;\n  overflow: hidden;\n  border-radius: inherit;\n}\n\n.pdial__wash {\n  position: absolute;\n  inset: 0;\n  opacity: var(--pdial-wash-op);\n  background:\n    radial-gradient(62% 22% at 50% 102%, #e0f2fe 0%, color-mix(in srgb, var(--pdial-c3) 80%, transparent) 40%, transparent 80%),\n    linear-gradient(\n      0deg,\n      var(--pdial-c3) 0%,\n      var(--pdial-c2) 8%,\n      var(--pdial-c1) 19%,\n      color-mix(in srgb, var(--pdial-c1) 38%, transparent) 29%,\n      transparent 40%\n    );\n  filter: blur(calc(var(--pdial-w) * 0.016));\n  transform-origin: 50% 100%;\n}\n\n.pdial[data-theme=\"light\"] .pdial__wash {\n  filter: blur(calc(var(--pdial-w) * 0.02)) saturate(0.88) brightness(1.1);\n}\n\n.pdial__walls {\n  position: absolute;\n  inset: 0;\n  border-radius: inherit;\n  pointer-events: none;\n  opacity: var(--pdial-wash-op);\n  box-shadow:\n    inset 0 calc(var(--pdial-w) * -0.02) calc(var(--pdial-w) * 0.04) calc(var(--pdial-w) * -0.012) color-mix(in srgb, var(--pdial-c3) 80%, white),\n    inset calc(var(--pdial-w) * 0.016) calc(var(--pdial-w) * -0.05) calc(var(--pdial-w) * 0.05) calc(var(--pdial-w) * -0.03) color-mix(in srgb, var(--pdial-c2) 80%, transparent),\n    inset calc(var(--pdial-w) * -0.016) calc(var(--pdial-w) * -0.05) calc(var(--pdial-w) * 0.05) calc(var(--pdial-w) * -0.03) color-mix(in srgb, var(--pdial-c2) 80%, transparent);\n}\n\n.pdial__bloom,\n.pdial__halo {\n  position: absolute;\n  border-radius: 50%;\n  opacity: 0.5;\n  pointer-events: none;\n}\n\n.pdial__bloom {\n  right: 8%;\n  bottom: calc(var(--pdial-h) * -0.08);\n  left: 8%;\n  height: calc(var(--pdial-h) * 0.22);\n  background: radial-gradient(closest-side, color-mix(in srgb, var(--pdial-c3) 85%, white), color-mix(in srgb, var(--pdial-c2) 80%, transparent) 55%, transparent);\n  filter: blur(calc(var(--pdial-w) * 0.07));\n}\n\n.pdial__halo {\n  inset: 45% -4% -2% -4%;\n  background: radial-gradient(60% 50% at 50% 80%, color-mix(in srgb, var(--pdial-c2) 45%, transparent), transparent 70%);\n  filter: blur(calc(var(--pdial-w) * 0.08));\n}\n\n.pdial__dial {\n  position: absolute;\n  inset: 0;\n  width: 100%;\n  height: 100%;\n}\n\n.pdial__ticks {\n  stroke: var(--pdial-ink);\n}\n\n.pdial__season {\n  position: absolute;\n  top: 15.5%;\n  right: 0;\n  left: 0;\n  margin: 0;\n  font-family: var(--pdial-font-head);\n  font-size: calc(var(--pdial-w) * 0.082);\n  font-weight: 800;\n  line-height: 1;\n  letter-spacing: 0.09em;\n  text-indent: 0.09em;\n  text-align: center;\n}\n\n.pdial__season span {\n  display: inline-block;\n  margin: -0.1em 0 -0.24em;\n  padding: 0.1em 0 0.24em;\n  background: linear-gradient(180deg, var(--pdial-label-top) 30%, var(--pdial-label-bot) 80%);\n  -webkit-background-clip: text;\n  background-clip: text;\n  color: transparent;\n  will-change: transform, filter, opacity;\n}\n\n.pdial__value {\n  position: absolute;\n  top: 46%;\n  right: 0;\n  left: 0;\n  display: flex;\n  justify-content: center;\n}\n\n.pdial__num {\n  display: flex;\n  align-items: flex-start;\n  font-family: var(--pdial-font-head);\n  font-size: calc(var(--pdial-w) * 0.42);\n  font-weight: 600;\n  line-height: 1;\n  letter-spacing: 0;\n}\n\n.pdial__slot {\n  position: relative;\n  display: inline-block;\n}\n\n.pdial__slot > span {\n  display: inline-block;\n  -webkit-background-clip: text;\n  background-clip: text;\n  color: transparent;\n}\n\n.pdial__lead {\n  z-index: 0;\n  margin-right: -0.07em;\n  transform: translateY(0.1em) scale(1.08);\n  transform-origin: 100% 0;\n}\n\n.pdial__lead > span {\n  background-image: linear-gradient(180deg, var(--pdial-lead-1) 0%, var(--pdial-lead-1) 42%, var(--pdial-lead-2) 70%, var(--pdial-lead-3) 100%);\n}\n\n.pdial__main {\n  z-index: 1;\n  filter: drop-shadow(calc(var(--pdial-w) * -0.006) 0 calc(var(--pdial-w) * 0.012) var(--pdial-digit-sep));\n  position: relative;\n}\n\n.pdial__main > span {\n  background-image: linear-gradient(180deg, var(--pdial-main-1) 0%, var(--pdial-main-1) 58%, var(--pdial-main-2) 100%);\n}\n\n.pdial__kilo-unit {\n  position: absolute;\n  top: 0.18em;\n  right: -0.48em;\n  font-size: 0.28em;\n  font-weight: 700;\n  color: var(--pdial-ink);\n  opacity: 0.88;\n  letter-spacing: -0.02em;\n}\n\n.pdial__hint {\n  margin: calc(var(--pdial-w) * 0.18) 0 0;\n  color: var(--pdial-hint);\n  font-size: 13px;\n  font-weight: 600;\n  letter-spacing: 0.025em;\n  text-align: center;\n  opacity: 0;\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .pdial__card {\n    transition: none;\n  }\n}\n"],["STYLE",{},"/*! tailwindcss v4.3.3 | MIT License | https://tailwindcss.com */\n@layer properties;\n@layer theme, base, components, utilities;\n@layer theme {\n  :root, :host {\n    --font-sans: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\",\n      \"Noto Sans\", Arial, sans-serif, \"Apple Color Emoji\", \"Segoe UI Emoji\",\n      \"Segoe UI Symbol\", \"Noto Color Emoji\";\n    --font-mono: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, \"Liberation Mono\",\n      \"Courier New\", monospace;\n    --color-amber-400: oklch(82.8% 0.189 84.429);\n    --color-emerald-400: oklch(76.5% 0.177 163.223);\n    --color-emerald-500: oklch(69.6% 0.17 162.48);\n    --color-emerald-600: oklch(59.6% 0.145 163.225);\n    --color-white: #fff;\n    --spacing: 0.25rem;\n    --text-xs: 0.75rem;\n    --text-xs--line-height: calc(1 / 0.75);\n    --text-sm: 0.875rem;\n    --text-sm--line-height: calc(1.25 / 0.875);\n    --font-weight-medium: 500;\n    --font-weight-semibold: 600;\n    --font-weight-bold: 700;\n    --tracking-tight: -0.025em;\n    --tracking-wider: 0.05em;\n    --tracking-widest: 0.1em;\n    --radius-md: 0.375rem;\n    --radius-lg: 0.5rem;\n    --radius-xl: 0.75rem;\n    --radius-2xl: 1rem;\n    --animate-spin: spin 1s linear infinite;\n    --animate-ping: ping 1s cubic-bezier(0, 0, 0.2, 1) infinite;\n    --default-transition-duration: 150ms;\n    --default-transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);\n    --default-font-family: var(--font-sans);\n    --default-mono-font-family: var(--font-mono);\n  }\n}\n@layer base {\n  *, ::after, ::before, ::backdrop, ::file-selector-button {\n    box-sizing: border-box;\n    margin: 0;\n    padding: 0;\n    border: 0 solid;\n  }\n  html, :host {\n    line-height: 1.5;\n    -webkit-text-size-adjust: 100%;\n    tab-size: 4;\n    font-family: var(--default-font-family, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", \"Noto Sans\", Arial, sans-serif, \"Apple Color Emoji\", \"Segoe UI Emoji\", \"Segoe UI Symbol\", \"Noto Color Emoji\");\n    font-feature-settings: var(--default-font-feature-settings, normal);\n    font-variation-settings: var(--default-font-variation-settings, normal);\n    -webkit-tap-highlight-color: transparent;\n  }\n  hr {\n    height: 0;\n    color: inherit;\n    border-top-width: 1px;\n  }\n  abbr:where([title]) {\n    -webkit-text-decoration: underline dotted;\n    text-decoration: underline dotted;\n  }\n  h1, h2, h3, h4, h5, h6 {\n    font-size: inherit;\n    font-weight: inherit;\n  }\n  a {\n    color: inherit;\n    -webkit-text-decoration: inherit;\n    text-decoration: inherit;\n  }\n  b, strong {\n    font-weight: bolder;\n  }\n  code, kbd, samp, pre {\n    font-family: var(--default-