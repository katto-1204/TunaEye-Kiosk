ize: 13px !important;\n}\n.topbar--xs .brand-symbol {\n  width: 18px !important;\n  height: 18px !important;\n}\n.topbar--xs .icon-button {\n  width: 28px !important;\n  height: 28px !important;\n  border: none !important;\n}\n.topbar--xs .status-dot {\n  width: 7px !important;\n  height: 7px !important;\n}\n.topbar--xs .step-rail {\n  font-size: 11px;\n}\n.topbar--xs .step-rail__dot {\n  width: 20px;\n  height: 20px;\n  font-size: 10px;\n}\n.topbar--xs .step-rail__item {\n  gap: 4px;\n}\n.topbar--xs .step-rail__item i {\n  width: 16px;\n}\n.topbar-wrapper--xs {\n  top: 8px;\n}\n.app-main:not(.app-main--welcome):not(.app-main--complete):not(.app-main--admin-dashboard) {\n  height: calc(100dvh - 58px);\n}\n.weight-split {\n  display: grid;\n  grid-template-columns: minmax(240px,380px) minmax(0,1fr);\n  gap: clamp(24px,4vw,60px);\n  min-height: 0;\n  align-items: center;\n  padding: clamp(12px,2vh,24px) 0;\n}\n.weight-split__info {\n  display: flex;\n  flex-direction: column;\n  gap: clamp(8px,1.5vh,16px);\n  padding: clamp(16px,2.5vw,30px);\n  border: 1px solid var(--border);\n  border-radius: 28px;\n  background: #fff;\n  box-shadow: var(--shadow-soft);\n  min-height: 0;\n  justify-content: center;\n}\n.weight-split__info .eyebrow {\n  color: var(--blue);\n}\n.weight-split__info h1 {\n  margin: 6px 0 4px;\n  font-size: clamp(26px,3.2vw,40px);\n  letter-spacing: -.045em;\n  color: var(--navy);\n  line-height: 1.1;\n}\n.weight-split__info p {\n  margin: 0;\n  color: var(--secondary);\n  font-size: clamp(14px,1.4vw,17px);\n  line-height: 1.5;\n}\n.weight-split__input {\n  display: flex;\n  flex-direction: column;\n  gap: clamp(8px,1.5vh,16px);\n  align-items: stretch;\n  min-height: 0;\n}\n.weight-display-row {\n  display: flex;\n  flex-direction: column;\n  gap: 10px;\n}\n.weight-input-display {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  padding: 14px 20px;\n  border: 2px solid var(--border);\n  border-radius: 18px;\n  background: #f8fafc;\n  cursor: p