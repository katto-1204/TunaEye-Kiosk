ius: 20px;\n  padding-inline: 22px;\n  font-size: 21px;\n  font-weight: 500;\n  box-shadow: 0 10px 24px rgba(15,23,42,.07);\n  transition: border-color .18s ease,box-shadow .18s ease;\n}\n.grader-entry__form .field-label input::placeholder {\n  color: #8694a8;\n  font-weight: 450;\n}\n.grader-entry__form .field-label input:focus {\n  border-color: var(--blue);\n  box-shadow: 0 0 0 5px rgba(23,107,255,.13),0 12px 28px rgba(15,23,42,.08);\n}\n.grader-entry__form .remember-row {\n  min-height: 48px;\n  gap: 14px;\n  margin-top: 18px;\n  color: var(--secondary);\n  font-size: 17px;\n  cursor: pointer;\n}\n.grader-entry__form .remember-row input {\n  flex: 0 0 26px;\n  width: 26px;\n  height: 26px;\n  margin: 0;\n  cursor: pointer;\n}\n.grader-entry__form .legal-links {\n  flex-wrap: wrap;\n  margin-top: 22px;\n  padding-top: 20px;\n  border-top: 1px solid #e3eaf3;\n  font-size: 15px;\n}\n.grader-entry__form .legal-links button {\n  min-height: 38px;\n  font-size: 15px;\n  font-weight: 600;\n}\n@media (min-width:681px) and (max-height:850px) and (orientation:landscape) {\n  .screen-stack--grader .grader-entry {\n    grid-template-columns: minmax(260px,.78fr) minmax(390px,1.22fr);\n    padding: 20px 26px;\n    gap: 28px;\n  }\n  .grader-entry__form {\n    padding: 22px 26px !important;\n  }\n  .grader-entry__form-heading {\n    margin-bottom: 18px;\n  }\n  .grader-entry__form-icon {\n    width: 50px;\n    height: 50px;\n    flex-basis: 50px;\n    border-radius: 15px;\n  }\n  .grader-entry__form-heading strong {\n    font-size: 21px;\n  }\n  .grader-entry__form .field-label input {\n    min-height: 64px !important;\n  }\n  .grader-entry__form .remember-row {\n    margin-top: 12px;\n  }\n  .grader-entry__form .legal-links {\n    margin-top: 12px;\n    padding-top: 10px;\n  }\n}\n@media (min-width:681px) and (max-width:1000px) and (orientation:portrait) {\n  .screen-stack--grader .grader-entry {\n    grid-template-columns: 1fr !important;\n    gap: 24px;\n  }\n  .grader-entr