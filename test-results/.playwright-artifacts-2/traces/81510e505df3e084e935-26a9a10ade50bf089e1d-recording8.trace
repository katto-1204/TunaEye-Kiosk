 display: grid;\n  place-items: center;\n  background: var(--blue-soft);\n  color: var(--blue);\n}\n.association-options button strong {\n  font-size: 25px;\n  letter-spacing: -.03em;\n}\n.association-options button small {\n  font-size: 16px;\n  color: var(--secondary);\n}\n.association-options button>svg:last-child {\n  position: absolute;\n  right: 20px;\n  top: 20px;\n  color: var(--blue);\n}\n.single-fish-card {\n  display: flex;\n  align-items: center;\n  gap: 16px;\n  width: min(560px,100%);\n  padding: 24px;\n  background: #fff;\n  border: 1px solid var(--border);\n  border-radius: 22px;\n  box-shadow: var(--shadow-soft);\n}\n.single-fish-card__icon {\n  width: 58px;\n  height: 58px;\n  border-radius: 18px;\n  display: grid;\n  place-items: center;\n  background: #e9f6ef;\n  color: var(--green);\n}\n.single-fish-card div {\n  display: flex;\n  flex-direction: column;\n  gap: 5px;\n}\n.single-fish-card strong {\n  font-size: 21px;\n}\n.single-fish-card small {\n  color: var(--secondary);\n  font-size: 16px;\n}\n.screen-stack--tutorial {\n  display: grid;\n  grid-template-columns: 36% 64%;\n  grid-template-rows: 1fr auto auto;\n  gap: 16px 38px;\n}\n.tutorial-heading {\n  align-self: center;\n}\n.tutorial-heading h1 {\n  font-size: 48px;\n  line-height: 1.04;\n  letter-spacing: -.06em;\n  margin: 14px 0;\n}\n.tutorial-heading p {\n  font-size: 20px;\n  line-height: 1.45;\n  color: var(--secondary);\n  max-width: 380px;\n}\n.tutorial-sample-chips {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 8px;\n  margin-top: 26px;\n}\n.tutorial-sample-chips span {\n  padding: 8px 12px;\n  border: 1px solid #c7d9ef;\n  color: var(--blue);\n  background: var(--blue-soft);\n  border-radius: 999px;\n  font-size: 14px;\n  font-weight: 600;\n}\n.tutorial-stage {\n  position: relative;\n}\n.tutorial-stage .evidence-frame {\n  min-height: 420px;\n}\n.tutorial-stage__number {\n  position: absolute;\n  z-index: 3;\n  left: -22px;\n  top: 10px;\n  font-size: 78px;\n  line-height: 1;\