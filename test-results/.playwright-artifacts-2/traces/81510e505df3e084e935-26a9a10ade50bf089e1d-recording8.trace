letter--C {\n  color: var(--red);\n}\n.individual-result-layout .grade-hero h1 {\n  font-size: 40px;\n  max-width: 490px;\n}\n.result-details>.result-sample-image {\n  width: 100%;\n  height: 190px;\n  object-fit: cover;\n  margin-bottom: 16px;\n}\n.result-badges {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 8px;\n  margin-top: 22px;\n}\n.result-badges span {\n  padding: 8px 11px;\n  border-radius: 999px;\n  background: #f0f5fa;\n  color: var(--secondary);\n  font-size: 14px;\n}\n.result-badges .override-badge {\n  background: #fff4d9;\n  color: var(--amber);\n  font-weight: 600;\n}\n.overview-cards {\n  display: grid;\n  grid-template-columns: repeat(2,1fr);\n  gap: 20px;\n}\n.overview-card {\n  padding: 18px;\n  border: 1px solid var(--border);\n  background: #fff;\n  border-radius: 24px;\n  box-shadow: var(--shadow-soft);\n}\n.overview-card__head {\n  display: flex;\n  gap: 14px;\n  align-items: center;\n}\n.overview-card__head .result-sample-image {\n  width: 146px;\n  height: 92px;\n  object-fit: cover;\n  border-radius: 16px;\n}\n.overview-card h2 {\n  font-size: 23px;\n  letter-spacing: -.03em;\n  margin: 5px 0;\n}\n.status-label {\n  display: inline-flex;\n  padding: 6px 9px;\n  border-radius: 999px;\n  font-size: 13px;\n  font-weight: 600;\n}\n.status-label--valid {\n  background: #e9f6ef;\n  color: var(--green);\n}\n.status-label--uncertain {\n  background: #fff5db;\n  color: var(--amber);\n}\n.status-label--invalid {\n  background: #fff0ec;\n  color: var(--red);\n}\n.overview-card__stats {\n  display: flex;\n  gap: 22px;\n  border-top: 1px solid var(--line);\n  border-bottom: 1px solid var(--line);\n  margin: 16px 0 8px;\n  padding: 12px 0;\n}\n.overview-card__stats span {\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n}\n.overview-card__stats small {\n  color: var(--muted);\n  font-size: 13px;\n}\n.overview-card__stats strong {\n  font-size: 16px;\n}\n.overview-card>.btn {\n  padding-left: 0;\n}\n.combined-panel {\n  display: flex;\n  align-items: flex-start;\n  gap: 15px;\n  padding: 20px;\n  border-radius: 22px;\n  border: 1px solid #c9dcef;\n  background: #f8fbff;\n}\n.combined-panel--different {\n  border-color: #ead8d1;\n  background: #fffaf8;\n}\n.combined-panel__icon {\n  width: 46px;\n  height: 46px;\n  border-radius: 15px;\n  display: grid;\n  place-items: center;\n  background: var(--blue-soft);\n  color: var(--blue);\n  flex: none;\n}\n.combined-panel--different .combined-panel__icon {\n  background: #fff0ec;\n  color: var(--red);\n}\n.combined-panel h2 {\n  font-size: 21px;\n  margin: 5px 0;\n}\n.combined-panel p {\n  font-size: 15px;\n  line-height: 1.4;\n  color: var(--secondary);\n  margin: 0;\n}\n.admin-dashboard {\n  width: min(1100px,calc(100% - 96px));\n  margin: 0 auto;\n  flex: 1;\n  padding: 58px 0 34px;\n}\n.admin-dashboard__intro {\n  display: flex;\n  justify-content: space-between;\n  align-items: flex-end;\n  gap: 20px;\n}\n.admin-dashboard h1 {\n  font-size: 50px;\n  letter-spacing: -.06em;\n  margin: 12px 0;\n}\n.admin-dashboard__intro p {\n  color: var(--secondary);\n  font-size: 19px;\n  margin: 0;\n}\n.admin-grid {\n  display: grid;\n  grid-template-columns: repeat(2,1fr);\n  gap: 18px;\n  margin-top: 42px;\n}\n.admin-card {\n  min-height: 150px;\n  display: grid;\n  grid-template-columns: auto 1fr auto;\n  grid-template-rows: auto auto;\n  align-items: center;\n  column-gap: 16px;\n  text-align: left;\n  padding: 22px;\n  border: 1px solid var(--border);\n  background: #fff;\n  border-radius: 22px;\n  box-shadow: var(--shadow-soft);\n  color: var(--navy);\n}\n.admin-card>span {\n  grid-row: 1 / span 2;\n  width: 58px;\n  height: 58px;\n  border-radius: 18px;\n  display: grid;\n  place-items: center;\n  background: var(--blue-soft);\n  color: var(--blue);\n}\n.admin-card strong {\n  font-size: 22px;\n}\n.admin-card small {\n  font-size: 15px;\n  color: var(--secondary);\n}\n.admin-card>svg {\n  grid-column: 3;\n  grid-row: 1 / span 2;\n  color: #93a1b1;\n}\n.admin-status {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  color: var(--secondary);\n  font-size: 15px;\n  margin-top: 24px;\n}\n.admin-status span:last-child {\n  margin-left: auto;\n  color: var(--muted);\n}\n.print-queue {\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n  margin-top: 28px;\n}\n.print-queue>div {\n  display: grid;\n  grid-template-columns: 28px 1fr auto;\n  align-items: center;\n  gap: 10px;\n  padding: 11px 12px;\n  border: 1px solid var(--border);\n  border-radius: 14px;\n  color: var(--secondary);\n  background: #fff;\n}\n.print-queue>div>span {\n  width: 24px;\n  height: 24px;\n  display: grid;\n  place-items: center;\n  border-radius: 50%;\n  background: #eef3f8;\n  font-size: 12px;\n}\n.print-queue>div.is-current {\n  border-color: #9cbef0;\n  background: var(--blue-soft);\n  color: var(--blue);\n}\n.print-queue>div.is-current>span {\n  background: var(--blue);\n  color: #fff;\n}\n.print-queue>div.is-printed {\n  color: var(--green);\n  background: #f4fbf6;\n}\n.print-queue>div.is-printed>span {\n  background: #e9f6ef;\n}\n.print-queue small {\n  font-size: 12px;\n  color: var(--muted);\n}\n.receipt__sample {\n  display: flex;\n  justify-content: space-between;\n  gap: 10px;\n  border-bottom: 1px dashed #c7d3df;\n  padding-bottom: 12px;\n  font-size: 13px;\n}\n.receipt__sample span {\n  color: var(--secondary);\n}\n.receipt__sample strong {\n  font-weight: 600;\n}\n.complete-print-list {\n  display: flex;\n  flex-wrap: wrap;\n  justify-content: center;\n  gap: 8px;\n  margin-top: 24px;\n}\n.complete-print-list span {\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n  padding: 9px 12px;\n  border-radius: 999px;\n  background: #e9f6ef;\n  color: var(--green);\n  font-size: 14px;\n}\n.override-modal {\n  max-width: 620px;\n}\n.override-modal>p {\n  color: var(--secondary);\n  font-size: 16px;\n  line-height: 1.45;\n}\n.override-grades {\n  display: flex;\n  gap: 10px;\n  margin: 12px 0 22px;\n}\n.override-grades button {\n  flex: 1;\n  min-height: 58px;\n  border: 1px solid var(--border);\n  border-radius: 16px;\n  background: #fff;\n  color: var(--secondary);\n  font-size: 18px;\n  font-weight: 600;\n}\n.override-grades button.is-selected {\n  border: 2px solid var(--blue);\n  background: var(--blue-soft);\n  color: var(--blue);\n}\n.override-modal__actions {\n  display: flex;\n  justify-content: flex-end;\n  gap: 12px;\n  margin-top: 24px;\n}\n.legal-modal>p {\n  color: var(--secondary);\n  font-size: 17px;\n  line-height: 1.55;\n}\n@media (max-width:1100px) {\n  .grader-entry {\n    gap: 36px;\n    padding: 32px;\n  }\n  .sample-options--three {\n    grid-template-columns: 1fr;\n  }\n  .selector-card {\n    min-height: 220px;\n    display: grid;\n    grid-template-columns: 180px 1fr auto;\n    align-items: center;\n  }\n  .selector-card__art {\n    height: 150px;\n  }\n  .screen-stack--tutorial {\n    display: flex;\n  }\n  .tutorial-stage {\n    width: 100%;\n  }\n  .tutorial-stage .evidence-frame {\n    min-height: 340px;\n  }\n  .individual-result-layout {\n    gap: 34px;\n  }\n  .admin-dashboard {\n    width: calc(100% - 56px);\n  }\n}\n@media (max-width:680px) {\n  .grader-entry {\n    grid-template-columns: 1fr;\n    padding: 24px;\n    gap: 30px;\n  }\n  .grader-entry__copy h1 {\n    font-size: 40px;\n  }\n  .grader-entry__copy p {\n    font-size: 18px;\n  }\n  .grader-entry__copy .brand-mark {\n    margin-bottom: 6px;\n  }\n  .selector-card {\n    display: flex;\n    min-height: 220px;\n  }\n  .selector-card__art {\n    height: 120px;\n  }\n  .association-copy h1,.tutorial-heading h1,.admin-dashboard h1 {\n    font-size: 38px;\n  }\n  .association-options,.overview-cards,.admin-grid {\n    grid-template-columns: 1fr;\n  }\n  .association-options button {\n    min-height: 155px;\n  }\n  .screen-stack--tutorial {\n    display: flex;\n  }\n  .tutorial-stage__number {\n    left: 4px;\n    top: 2px;\n    font-size: 60px;\n  }\n  .tutorial-stage__callout {\n    position: 