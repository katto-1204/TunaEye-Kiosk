ntry__copy p {\n  font-size: 20px;\n  line-height: 1.48;\n  color: var(--secondary);\n  max-width: 470px;\n  margin: 0;\n}\n.grader-entry__form {\n  padding: 12px 0;\n}\n.field-label {\n  display: flex;\n  flex-direction: column;\n  gap: 10px;\n  color: var(--secondary);\n  font-size: 16px;\n}\n.field-label input,.field-label textarea {\n  border: 1px solid var(--border);\n  border-radius: 18px;\n  background: #fff;\n  color: var(--navy);\n  padding: 0 18px;\n  min-height: 62px;\n  outline: none;\n  box-shadow: var(--shadow-soft);\n}\n.field-label textarea {\n  padding: 14px 16px;\n  resize: vertical;\n  min-height: 94px;\n}\n.grader-profiles {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 8px;\n  margin-top: 16px;\n}\n.grader-profiles button {\n  min-height: 46px;\n  border: 1px solid var(--border);\n  background: #f7faff;\n  color: var(--secondary);\n  padding: 0 14px;\n  border-radius: 14px;\n  font-size: 14px;\n}\n.grader-profiles button.is-selected {\n  border-color: var(--blue);\n  color: var(--blue);\n  background: var(--blue-soft);\n  font-weight: 600;\n}\n.remember-row {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  color: var(--secondary);\n  font-size: 16px;\n  margin-top: 26px;\n}\n.remember-row input {\n  width: 20px;\n  height: 20px;\n  accent-color: var(--blue);\n}\n.legal-links {\n  display: flex;\n  gap: 8px;\n  align-items: center;\n  color: var(--muted);\n  font-size: 14px;\n  margin-top: 32px;\n}\n.legal-links button {\n  border: 0;\n  background: transparent;\n  color: var(--blue);\n  text-decoration: underline;\n  text-underline-offset: 3px;\n  padding: 0;\n  font-size: 14px;\n}\n.legal-links button:hover {\n  color: var(--blue-dark);\n}\n.error-text {\n  display: flex;\n  align-items: center;\n  gap: 7px;\n  color: var(--red);\n  font-size: 15px;\n  margin-top: 10px;\n}\n.sample-options--three {\n  grid-template-columns: repeat(3,1fr);\n  align-items: stretch;\n}\n.selector-card {\n  min-height: 340px;\n  padding: 20px;\n}\n.selec