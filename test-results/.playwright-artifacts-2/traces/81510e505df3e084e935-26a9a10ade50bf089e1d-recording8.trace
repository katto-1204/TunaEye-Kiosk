;\n  transition: border-color .18s ease,background .18s ease;\n}\n.weight-input-display.is-active {\n  border-color: var(--blue);\n  background: #fff;\n  box-shadow: 0 0 0 4px var(--blue-soft);\n}\n.weight-input-display input {\n  flex: 0 1 auto;\n  border: none;\n  background: transparent;\n  font: inherit;\n  font-size: clamp(28px,3.5vw,44px);\n  font-weight: 700;\n  color: var(--navy);\n  letter-spacing: -.04em;\n  outline: none;\n  min-width: 3ch;\n  max-width: 8ch;\n  text-align: left;\n  caret-color: var(--blue);\n}\n.weight-input-display b {\n  color: var(--muted);\n  font-size: clamp(18px,2vw,24px);\n  font-weight: 600;\n  flex: none;\n}\n.weight-split__info .weight-entry {\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n}\n.weight-split__info .weight-row {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  padding: 10px 14px;\n  border: 1px solid var(--border);\n  border-radius: 14px;\n  background: #f8fafc;\n  cursor: pointer;\n  transition: border-color .18s,background .18s;\n}\n.weight-split__info .weight-row.is-active-fish {\n  border-color: var(--blue);\n  background: var(--blue-soft);\n}\n.weight-split__info .weight-row span {\n  display: flex;\n  flex-direction: column;\n  gap: 3px;\n}\n.weight-split__info .weight-row strong {\n  color: var(--navy);\n  font-size: 15px;\n}\n.weight-split__info .weight-row small {\n  color: var(--muted);\n  font-size: 12px;\n}\n.weight-split__input .numpad-container {\n  width: 100%;\n}\n.weight-split__input .numpad-grid {\n  display: grid;\n  grid-template-columns: repeat(3,1fr);\n  gap: 10px;\n}\n.weight-split__input .numpad-btn {\n  min-height: clamp(52px,7vh,72px);\n  border: 1px solid var(--border);\n  border-radius: 16px;\n  background: #fff;\n  color: var(--navy);\n  font-size: clamp(20px,2.4vw,28px);\n  font-weight: 600;\n  cursor: pointer;\n  transition: all .15s ease;\n  box-shadow: var(--shadow-soft);\n}\n.weight-split__input .numpad-btn:hover {\n  background: var(--blue-soft);\n  border-c