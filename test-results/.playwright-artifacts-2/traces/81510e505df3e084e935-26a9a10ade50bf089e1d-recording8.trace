{\n  color: var(--red);\n}\n.individual-result-layout .grade-hero h1 {\n  font-size: 40px;\n  max-width: 490px;\n}\n.result-details>.result-sample-image {\n  width: 100%;\n  height: 190px;\n  object-fit: cover;\n  margin-bottom: 16px;\n}\n.result-badges {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 8px;\n  margin-top: 22px;\n}\n.result-badges span {\n  padding: 8px 11px;\n  border-radius: 999px;\n  background: #f0f5fa;\n  color: var(--secondary);\n  font-size: 14px;\n}\n.result-badges .override-badge {\n  background: #fff4d9;\n  color: var(--amber);\n  font-weight: 600;\n}\n.overview-cards {\n  display: grid;\n  grid-template-columns: repeat(2,1fr);\n  gap: 20px;\n}\n.overview-card {\n  padding: 18px;\n  border: 1px solid var(--border);\n  background: #fff;\n  border-radius: 24px;\n  box-shadow: var(--shadow-soft);\n}\n.overview-card__head {\n  display: flex;\n  gap: 14px;\n  align-items: center;\n}\n.overview-card__head .result-sample-image {\n  width: 146px;\n  height: 92px;\n  object-fit: cover;\n  border-radius: 16px;\n}\n.overview-card h2 {\n  font-size: 23px;\n  letter-spacing: -.03em;\n  margin: 5px 0;\n}\n.status-label {\n  display: inline-flex;\n  padding: 6px 9px;\n  border-radius: 999px;\n  font-size: 13px;\n  font-weight: 600;\n}\n.status-label--valid {\n  background: #e9f6ef;\n  color: var(--green);\n}\n.status-label--uncertain {\n  background: #fff5db;\n  color: var(--amber);\n}\n.status-label--invalid {\n  background: #fff0ec;\n  color: var(--red);\n}\n.overview-card__stats {\n  display: flex;\n  gap: 22px;\n  border-top: 1px solid var(--line);\n  border-bottom: 1px solid var(--line);\n  margin: 16px 0 8px;\n  padding: 12px 0;\n}\n.overview-card__stats span {\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n}\n.overview-card__stats small {\n  color: var(--muted);\n  font-size: 13px;\n}\n.overview-card__stats strong {\n  font-size: 16px;\n}\n.overview-card>.btn {\n  padding-left: 0;\n}\n.combined-panel {\n  display: flex;\n  align-items: fl