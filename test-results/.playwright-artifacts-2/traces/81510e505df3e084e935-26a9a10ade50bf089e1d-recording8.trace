 column;\n  gap: 14px;\n  min-height: 0;\n  overflow: hidden;\n}\n.grader-bento-v2__right {\n  display: flex;\n  flex-direction: column;\n  min-height: 0;\n  overflow: hidden;\n}\n.grader-bento__info-grid {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 10px;\n}\n.grader-info-card {\n  display: flex;\n  flex-direction: row;\n  align-items: center;\n  gap: 12px;\n  padding: clamp(12px,1.5vw,18px);\n  border: 1px solid var(--border);\n  border-radius: 18px;\n  background: #fff;\n  box-shadow: var(--shadow-soft);\n}\n.grader-info-card__icon {\n  width: 38px;\n  height: 38px;\n  flex: none;\n  display: grid;\n  place-items: center;\n  border-radius: 12px;\n  background: var(--blue-soft);\n  color: var(--blue);\n}\n.grader-info-card__body {\n  display: flex;\n  flex-direction: column;\n  gap: 2px;\n  min-width: 0;\n}\n.grader-info-card__body small {\n  color: var(--muted);\n  font-size: clamp(11px,1.2vw,13px);\n}\n.grader-info-card__body strong {\n  color: var(--navy);\n  font-size: clamp(20px,2.2vw,30px);\n  letter-spacing: -.04em;\n  line-height: 1;\n}\n.grader-info-card__body em {\n  color: var(--green);\n  font-size: 10px;\n  font-style: normal;\n}\n.grader-bento__hello-card {\n  flex: 1;\n  display: flex;\n  flex-direction: column;\n  justify-content: space-between;\n  gap: 20px;\n  padding: clamp(20px,2.5vw,32px);\n  border: 1px solid rgba(23,107,255,.2);\n  border-radius: 24px;\n  background: linear-gradient(145deg,#F3F6FF 0%,#fff 60%);\n  box-shadow: var(--shadow);\n}\n.grader-hello__header .eyebrow {\n  color: var(--blue);\n}\n.grader-hello__header h1 {\n  margin: 6px 0 8px;\n  font-size: clamp(26px,3vw,42px);\n  line-height: 1.03;\n  letter-spacing: -.05em;\n  color: var(--navy);\n}\n.grader-hello__header p {\n  margin: 0;\n  color: var(--secondary);\n  font-size: clamp(14px,1.4vw,16px);\n  line-height: 1.45;\n}\n.grader-hello__actions {\n  display: flex;\n  flex-direction: column;\n  gap: 10px;\n}\n.grader-hello__subactions {\n  display: flex;\n  gap: 10px;\n}\n.grader-hello__subactions .btn {\n  flex: 1;\n}\n.grader-bento-v2__right .admin-table-card {\n  height: 100%;\n  overflow-y: auto;\n  border-radius: 20px;\n}\n.grader-dashboard__empty {\n  display: grid;\n  place-content: center;\n  justify-items: center;\n  text-align: center;\n  color: var(--muted);\n  padding: 32px;\n  height: 100%;\n  border: 1px solid var(--border);\n  border-radius: 20px;\n  background: #fff;\n}\n.grader-dashboard__empty h2 {\n  margin: 12px 0 5px;\n  color: var(--navy);\n  font-size: clamp(20px,2.2vw,28px);\n}\n.grader-dashboard__empty p {\n  font-size: clamp(14px,1.4vw,17px);\n}\n@media (max-width:900px) {\n  .grader-bento-v2 {\n    grid-template-columns: 1fr;\n    grid-template-rows: auto minmax(0,1fr);\n  }\n  .grader-bento-v2__left {\n    overflow: visible;\n  }\n  .grader-bento__info-grid {\n    grid-template-columns: repeat(4,1fr);\n  }\n  .grader-info-card__body strong {\n    font-size: 20px;\n  }\n}\n@media (max-width:680px) {\n  .admin-header-actions {\n    gap: 8px;\n  }\n  .admin-header-actions .btn {\n    min-height: 52px !important;\n    font-size: 15px !important;\n    padding-inline: 14px !important;\n  }\n  .grader-bento-v2 {\n    grid-template-columns: 1fr;\n    gap: 10px;\n  }\n  .grader-bento__info-grid {\n    grid-template-columns: 1fr 1fr;\n    gap: 8px;\n  }\n  .grader-info-card {\n    padding: 10px;\n    gap: 8px;\n  }\n  .grader-info-card__icon {\n    width: 32px;\n    height: 32px;\n    border-radius: 10px;\n  }\n  .grader-info-card__body strong {\n    font-size: 18px;\n  }\n  .grader-info-card__body small {\n    font-size: 11px;\n  }\n  .grader-bento__hello-card {\n    padding: 16px;\n    gap: 12px;\n  }\n  .grader-hello__header h1 {\n    font-size: 24px;\n  }\n  .grader-dashboard>.admin-table-card {\n    display: none;\n  }\n}\n.topbar--xs {\n  height: 34px !important;\n  min-height: 34px !important;\n  padding: 0 14px !important;\n  border-radius: 9999px !important;\n}\n.topbar--xs .brand-word {\n  