play: flex;\n  align-items: center;\n  gap: 10px;\n  color: var(--secondary);\n  font-size: 15px;\n  margin-top: 24px;\n}\n.admin-status span:last-child {\n  margin-left: auto;\n  color: var(--muted);\n}\n.print-queue {\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n  margin-top: 28px;\n}\n.print-queue>div {\n  display: grid;\n  grid-template-columns: 28px 1fr auto;\n  align-items: center;\n  gap: 10px;\n  padding: 11px 12px;\n  border: 1px solid var(--border);\n  border-radius: 14px;\n  color: var(--secondary);\n  background: #fff;\n}\n.print-queue>div>span {\n  width: 24px;\n  height: 24px;\n  display: grid;\n  place-items: center;\n  border-radius: 50%;\n  background: #eef3f8;\n  font-size: 12px;\n}\n.print-queue>div.is-current {\n  border-color: #9cbef0;\n  background: var(--blue-soft);\n  color: var(--blue);\n}\n.print-queue>div.is-current>span {\n  background: var(--blue);\n  color: #fff;\n}\n.print-queue>div.is-printed {\n  color: var(--green);\n  background: #f4fbf6;\n}\n.print-queue>div.is-printed>span {\n  background: #e9f6ef;\n}\n.print-queue small {\n  font-size: 12px;\n  color: var(--muted);\n}\n.receipt__sample {\n  display: flex;\n  justify-content: space-between;\n  gap: 10px;\n  border-bottom: 1px dashed #c7d3df;\n  padding-bottom: 12px;\n  font-size: 13px;\n}\n.receipt__sample span {\n  color: var(--secondary);\n}\n.receipt__sample strong {\n  font-weight: 600;\n}\n.complete-print-list {\n  display: flex;\n  flex-wrap: wrap;\n  justify-content: center;\n  gap: 8px;\n  margin-top: 24px;\n}\n.complete-print-list span {\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n  padding: 9px 12px;\n  border-radius: 999px;\n  background: #e9f6ef;\n  color: var(--green);\n  font-size: 14px;\n}\n.override-modal {\n  max-width: 620px;\n}\n.override-modal>p {\n  color: var(--secondary);\n  font-size: 16px;\n  line-height: 1.45;\n}\n.override-grades {\n  display: flex;\n  gap: 10px;\n  margin: 12px 0 22px;\n}\n.override-grades button {\n  flex: 1;\n  min-height: 58px;\n  border: 1px solid var(--border);\n  border-radius: 16px;\n  background: #fff;\n  color: var(--secondary);\n  font-size: 18px;\n  font-weight: 600;\n}\n.override-grades button.is-selected {\n  border: 2px solid var(--blue);\n  background: var(--blue-soft);\n  color: var(--blue);\n}\n.override-modal__actions {\n  display: flex;\n  justify-content: flex-end;\n  gap: 12px;\n  margin-top: 24px;\n}\n.legal-modal>p {\n  color: var(--secondary);\n  font-size: 17px;\n  line-height: 1.55;\n}\n@media (max-width:1100px) {\n  .grader-entry {\n    gap: 36px;\n    padding: 32px;\n  }\n  .sample-options--three {\n    grid-template-columns: 1fr;\n  }\n  .selector-card {\n    min-height: 220px;\n    display: grid;\n    grid-template-columns: 180px 1fr auto;\n    align-items: center;\n  }\n  .selector-card__art {\n    height: 150px;\n  }\n  .screen-stack--tutorial {\n    display: flex;\n  }\n  .tutorial-stage {\n    width: 100%;\n  }\n  .tutorial-stage .evidence-frame {\n    min-height: 340px;\n  }\n  .individual-result-layout {\n    gap: 34px;\n  }\n  .admin-dashboard {\n    width: calc(100% - 56px);\n  }\n}\n@media (max-width:680px) {\n  .grader-entry {\n    grid-template-columns: 1fr;\n    padding: 24px;\n    gap: 30px;\n  }\n  .grader-entry__copy h1 {\n    font-size: 40px;\n  }\n  .grader-entry__copy p {\n    font-size: 18px;\n  }\n  .grader-entry__copy .brand-mark {\n    margin-bottom: 6px;\n  }\n  .selector-card {\n    display: flex;\n    min-height: 220px;\n  }\n  .selector-card__art {\n    height: 120px;\n  }\n  .association-copy h1,.tutorial-heading h1,.admin-dashboard h1 {\n    font-size: 38px;\n  }\n  .association-options,.overview-cards,.admin-grid {\n    grid-template-columns: 1fr;\n  }\n  .association-options button {\n    min-height: 155px;\n  }\n  .screen-stack--tutorial {\n    display: flex;\n  }\n  .tutorial-stage__number {\n    left: 4px;\n    top: 2px;\n    font-size: 60px;\n  }\n  .tutorial-stage__callout {\n    position: static;\n 