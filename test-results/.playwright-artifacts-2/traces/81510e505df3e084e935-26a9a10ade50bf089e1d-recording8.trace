plete):not(.app-main--admin-dashboard) {\n  height: calc(100dvh - 102px);\n  min-height: 0;\n  overflow: hidden;\n}\n.app-main:not(.app-main--welcome):not(.app-main--complete):not(.app-main--admin-dashboard) .screen-stack {\n  min-height: 0;\n  max-height: 100%;\n  padding-block: clamp(18px,4vh,42px);\n  gap: clamp(14px,2.5vh,26px);\n  overflow: hidden;\n}\n.app-main .bottom-bar {\n  flex: none;\n}\n.screen-stack--camera .camera-layout,.screen-stack--review .review-layout,.screen-stack--result .individual-result-layout {\n  min-height: 0;\n}\n.live-camera,.live-camera video {\n  height: min(50vh,460px);\n  min-height: 260px;\n}\n.review-layout .evidence-frame {\n  height: min(50vh,440px);\n  min-height: 260px;\n}\n.analysis-screen__visual {\n  height: min(38vh,300px);\n}\n.analysis-screen__visual .evidence-frame {\n  height: 100%;\n}\n.result-details>.result-sample-image {\n  height: min(24vh,190px);\n  object-fit: cover;\n}\n.btn,.role-button,.sample-card,.association-options button,.tutorial-dots button {\n  touch-action: manipulation;\n}\n@media (min-width:681px) and (max-width:1000px) {\n  .camera-layout,.review-layout {\n    display: grid !important;\n    grid-template-columns: minmax(0,1.35fr) minmax(280px,.65fr) !important;\n  }\n  .camera-layout .live-camera,.camera-layout .live-camera video {\n    height: min(48vh,420px);\n  }\n  .camera-aside h1,.review-aside h1 {\n    font-size: clamp(27px,4vw,36px);\n  }\n  .quality-list {\n    margin-top: 12px;\n  }\n  .camera-selector {\n    margin-top: 12px;\n  }\n  .screen-stack--camera,.screen-stack--review {\n    width: calc(100% - 48px);\n    max-width: none;\n  }\n}\n@media (max-height:760px) {\n  .topbar {\n    min-height: 82px;\n    padding-block: 14px;\n  }\n  .app-main:not(.app-main--welcome):not(.app-main--complete):not(.app-main--admin-dashboard) {\n    height: calc(100dvh - 82px);\n  }\n  .screen-stack {\n    padding-block: 16px !important;\n    gap: 12px !important;\n  }\n  .camera-aside h1,.review-aside h1,.section-heading h1,.tutorial-heading h1 {\n    font-size: clamp(27px,4.8vh,36px);\n    margin-block: 7px;\n  }\n  .camera-aside>p,.review-aside>p,.section-heading p,.tutorial-heading p {\n    font-size: 16px;\n    line-height: 1.3;\n  }\n  .sample-context {\n    margin: 8px 0;\n  }\n  .quality-list {\n    margin-top: 8px;\n  }\n  .quality-item {\n    padding: 7px 0;\n  }\n  .camera-selector {\n    padding: 9px;\n    margin: 8px 0;\n  }\n  .demo-outcome {\n    padding: 9px;\n  }\n  .bottom-bar {\n    min-height: 64px;\n    padding-block: 8px;\n  }\n  .btn {\n    min-height: 56px;\n  }\n  .live-camera,.live-camera video {\n    height: min(48vh,390px);\n  }\n  .tutorial-stage__image {\n    height: min(47vh,340px);\n  }\n  .grade-letter {\n    font-size: 110px;\n    margin-block: 12px;\n  }\n  .confidence {\n    margin-top: 18px;\n  }\n  .result-details dl div {\n    padding-block: 9px;\n  }\n  .result-actions {\n    padding-top: 10px;\n  }\n}\n.camera-selector {\n  display: grid;\n  gap: 8px;\n  margin: 20px 0 4px;\n  padding: 14px;\n  border: 1px solid var(--border);\n  border-radius: 16px;\n  background: #fff;\n}\n.camera-selector>span {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  color: var(--navy);\n  font-weight: 600;\n}\n.camera-selector>span svg {\n  color: var(--blue);\n}\n.camera-selector select {\n  width: 100%;\n  min-height: 46px;\n  padding: 0 12px;\n  border: 1px solid var(--border);\n  border-radius: 11px;\n  background: #f8fafc;\n  color: var(--navy);\n  font: inherit;\n}\n.camera-selector small {\n  color: var(--muted);\n  font-size: 12px;\n}\n.welcome-screen__actions {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 12px;\n}\n.welcome-screen__actions .btn {\n  min-width: 190px;\n}\n@media (max-width:520px) {\n  .welcome-screen__actions {\n    width: 100%;\n    flex-direction: column;\n  }\n  .welcome-screen__actions .btn {\n    width: min(340px,100%);\n  }\n}\n.app-main--admin-dashboard {\n  padding: 0;\n  background: #f3f6fa;\n}\n.app-main--admin-dashboard+.bottom-bar {\n  display: none;\n}\n.admin-workspace {\n  display: grid;\n  grid-template-columns: 240px minmax(0,1fr);\n  width: 100%;\n  min-height: calc(100vh - 112px);\n  background: #f3f6fa;\n}\n.admin-sidebar {\n  position: sticky;\n  top: 0;\n  height: calc(100vh - 112px);\n  display: flex;\n  flex-direction: column;\n  padding: 28px 18px 22px;\n  background: #111827;\n  color: #fff;\n}\n.admin-sidebar .brand-mark {\n  padding: 0 10px;\n  margin-bottom: 36px;\n}\n.admin-sidebar .brand-mark * {\n  color: #fff;\n}\n.admin-sidebar nav {\n  display: grid;\n  gap: 7px;\n}\n.admin-sidebar nav button,.admin-sidebar__foot button {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  width: 100%;\n  min-height: 48px;\n  padding: 0 14px;\n  border: 0;\n  border-radius: 12px;\n  background: transparent;\n  color: #c8d7e8;\n  font: inherit;\n  text-align: left;\n}\n.admin-sidebar nav button:hover,.admin-sidebar nav button.is-active {\n  background: rgba(255,255,255,.12);\n  color: #fff;\n}\n.admin-sidebar nav button.is-active {\n  box-shadow: inset 3px 0 #3B8CFF;\n}\n.admin-sidebar__foot {\n  display: grid;\n  gap: 10px;\n  margin-top: auto;\n  padding-top: 20px;\n  border-top: 1px solid rgba(255,255,255,.14);\n}\n.admin-sidebar__foot>span {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  padding: 0 12px;\n  color: #b9ccdf;\n  font-size: 13px;\n}\n.admin-sidebar__foot button {\n  cursor: pointer;\n}\n.admin-content {\n  min-width: 0;\n  padding: 38px clamp(24px,4vw,60px) 54px;\n  overflow: hidden;\n}\n.admin-content__header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 24px;\n  margin-bottom: 30px;\n}\n.admin-content__header h1 {\n  margin: 7px 0 6px;\n  font-size: 38px;\n  letter-spacing: -.045em;\n  color: var(--navy);\n}\n.admin-content__header p {\n  margin: 0;\n  color: var(--secondary);\n  font-size: 16px;\n}\n.admin-avatar {\n  width: 48px;\n  height: 48px;\n  display: grid;\n  place-items: center;\n  flex: none;\n  border-radius: 15px;\n  background: #DCE8FF;\n  color: #061EAE;\n  font-weight: 700;\n}\n.admin-metrics {\n  display: grid;\n  grid-template-columns: repeat(4,minmax(0,1fr));\n  gap: 15px;\n}\n.admin-metrics article {\n  display: grid;\n  grid-template-columns: auto 1fr;\n  gap: 4px 12px;\n  padding: 20px;\n  border: 1px solid var(--border);\n  border-radius: 18px;\n  background: #fff;\n  box-shadow: var(--shadow-soft);\n}\n.admin-metrics article>span {\n  grid-row: 1/4;\n  width: 42px;\n  height: 42px;\n  display: grid;\n  place-items: center;\n  border-radius: 13px;\n  background: var(--blue-soft);\n  color: var(--blue);\n}\n.admin-metrics small {\n  color: var(--muted);\n  font-size: 13px;\n}\n.admin-metrics strong {\n  font-size: 27px;\n  letter-spacing: -.04em;\n}\n.admin-metrics em {\n  color: var(--green);\n  font-size: 12px;\n  font-style: normal;\n}\n.admin-overview-grid {\n  display: grid;\n  grid-template-columns: minmax(0,1.7fr) minmax(260px,.8fr);\n  gap: 18px;\n  margin: 18px 0;\n}\n.admin-chart,.admin-breakdown,.admin-page-card,.admin-table-card {\n  padding: 24px;\n  border: 1px solid var(--border);\n  border-radius: 20px;\n  background: #fff;\n  box-shadow: var(--shadow-soft);\n}\n.admin-section-title {\n  display: flex;\n  align-items: flex-start;\n  justify-content: space-between;\n  gap: 20px;\n  margin-bottom: 22px;\n}\n.admin-section-title h2,.admin-page-card h2 {\n  margin: 0 0 5px;\n  font-size: 21px;\n}\n.admin-section-title p,.admin-page-card p {\n  margin: 0;\n  color: var(--muted);\n  font-size: 14px;\n}\n.admin-section-title>b {\n  color: var(--blue);\n  font-size: 14px;\n}\n.admin-section-title>button {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  border: 0;\n  background: transparent;\n  color: var(--blue);\n  font-weight: 600;\n}\n.bar-chart {\n  height: 190px;\n  display: flex;\n  align-items: flex-end;\n  gap: clamp(10px,3vw,28px);\n  padding: 15px 12px 0;\n  border-bottom: 1px solid var(--line);\n  background: repeating-linear-gradient(to bottom,transparent 0,transparent 46px,#edf1f5 47px);\n}\n.bar-chart>div {\n  height: 100%;\n  display: flex;\n  flex: 1;\n  flex-direction: column;\n  align-items: center;\n  justify-content: flex-end;\n  gap: 8px;\n}\n.bar-chart span {\n  width: min(32px,80%);\n  min-height: 12px;\n  border-radius: 8px 8px 2px 2px;\n  background: linear-gradient(#2478FF,#0B45E5);\n}\n.bar-chart small {\n  color: var(--muted);\n  font-size: 11px;\n}\n.admin-breakdown {\n  display: flex;\n  flex-direction: column;\n}\n.grade-ring {\n  width: 136px;\n  height: 136px;\n  display: grid;\n  place-items: center;\n  align-self: center;\n  margin: 5px 0 20px;\n  border-radius: 50%;\n  background: conic-gradient(#0B45E5 0 67%,#3B8CFF 67% 91%,#f2b64c 91%);\n  position: relative;\n}\n.grade-ring:after {\n  content: '';\n  position: absolute;\n  inset: 18px;\n  border-radius: 50%;\n  background: #fff;\n}\n.grade-ring strong {\n  z-index: 1;\n  text-align: center;\n  font-size: 25px;\n}\n.grade-ring small {\n  display: block;\n  color: var(--muted);\n  font-size: 11px;\n  font-weight: 400;\n}\n.grade-legend {\n  display: grid;\n  gap: 10px;\n}\n.grade-legend span {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  color: var(--secondary);\n  font-size: 13px;\n}\n.grade-legend span b {\n  margin-left: auto;\n}\n.grade-legend i {\n  width: 9px;\n  height: 9px;\n  border-radius: 50%;\n}\n.grade-a {\n  background: #0B45E5;\n}\n.grade-b {\n  background: #3B8CFF;\n}\n.grade-c {\n  background: #f2b64c;\n}\n.admin-table-card {\n  overflow: hidden;\n}\n.admin-table {\n  min-width: 760px;\n}\n.admin-table>div {\n  display: grid;\n  grid-template-columns: 1.2fr 1.1fr 1.1fr .7fr .5fr .8fr;\n  align-items: center;\n  gap: 14px;\n  min-height: 64px;\n  padding: 8px 4px;\n  border-top: 1px solid var(--line);\n  font-size: 13px;\n  color: var(--secondary);\n}\n.admin-table .admin-table__head {\n  min-height: 38px;\n  border: 0;\n  color: var(--muted);\n  font-size: 11px;\n  text-transform: uppercase;\n  letter-spacing: .05em;\n}\n.admin-table span {\n  min-width: 0;\n}\n.admin-table span>strong,.admin-table span>small {\n  display: block;\n}\n.admin-table span>small {\n  margin-top: 3px;\n  color: var(--muted);\n}\n.table-grade {\n  width: 30px;\n  height: 30px;\n  display: grid !important;\n  place-items: center;\n  border-radius: 999px;\n  background: #e9f6ef;\n  color: var(--green);\n  font-weight: 700;\n}\n.table-grade--B {\n  background: #fff5db;\n  color: var(--amber);\n}\n.table-grade--C {\n  background: #fff0ec;\n  color: var(--red);\n}\n.admin-pagination {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 16px;\n  padding: 16px 20px;\n  border-top: 1px solid var(--line);\n  color: var(--muted);\n  font-size: 13px;\n}\n.admin-pagination__controls {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n}\n.admin-pagination__btn {\n  padding: 8px 14px;\n  border: 1px solid var(--border);\n  border-radius: 10px;\n  background: #fff;\n  color: var(--navy);\n  font-size: 13px;\n  font-weight: 600;\n  transition: all .18s ease;\n}\n.admin-pagination__btn:hover:not(:disabled) {\n  background: var(--blue-soft);\n  border-color: var(--blue);\n  color: var(--blue);\n}\n.admin-pagination__btn:disabled {\n  opacity: .4;\n  cursor: not-allowed;\n}\n.admin-toolbar {\n  display: flex;\n  gap: 14px;\n  margin-bottom: 18px;\n}\n.admin-toolbar input,.admin-add-grader input,.settings-form>label>input {\n  flex: 1;\n  min-height: 50px;\n  padding: 0 16px;\n  border: 1px solid var(--border);\n  border-radius: 14px;\n  background: #fff;\n  font: inherit;\n  color: var(--navy);\n  outline: none;\n}\n.admin-toolbar input:focus,.admin-add-grader input:focus,.settings-form>label>input:focus {\n  border-color: var(--blue);\n  box-shadow: 0 0 0 3px var(--blue-soft);\n}\n.price-editor {\n  display: grid;\n  gap: 12px;\n}\n.price-editor>label {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 20px;\n  padding: 18px;\n  border: 1px solid var(--line);\n  border-radius: 15px;\n}\n.price-editor>label>span {\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n  font-weight: 700;\n}\n.price-editor>label>span small {\n  color: var(--muted);\n  font-weight: 400;\n}\n.price-editor>label>div {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n}\n.price-editor input {\n  width: 120px;\n  height: 46px;\n  border: 1px solid var(--border);\n  border-radius: 12px;\n  padding: 0 12px;\n  font: inherit;\n  font-size: 20px;\n  font-weight: 700;\n}\n.admin-card-actions {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 20px;\n  margin-top: 24px;\n  padding-top: 18px;\n  border-top: 1px solid var(--line);\n}\n.admin-card-actions>span {\n  color: var(--muted);\n  font-size: 13px;\n}\n.grader-admin-list {\n  display: grid;\n}\n.grader-admin-list>div {\n  display: grid;\n  grid-template-columns: auto 1fr auto auto;\n  align-items: center;\n  gap: 13px;\n  padding: 14px 0;\n  border-bottom: 1px solid var(--line);\n}\n.grader-admin-list>div>span:nth-child(2) {\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n}\n.grader-admin-list small {\n  color: var(--muted);\n}\n.grader-admin-list button {\n  border: 0;\n  background: transparent;\n  color: var(--red);\n}\n.admin-add-grader {\n  display: flex;\n  gap: 12px;\n  margin-top: 22px;\n}\n.device-grid {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 12px;\n  margin-bottom: 22px;\n}\n.device-grid article {\n  display: grid;\n  grid-template-columns: auto 1fr auto;\n  align-items: center;\n  gap: 13px;\n  padding: 17px;\n  border: 1px solid var(--line);\n  border-radius: 15px;\n}\n.device-grid article>svg {\n  color: var(--blue);\n}\n.device-grid article span {\n  display: flex;\n  flex-direction: column;\n  gap: 3px;\n}\n.device-grid article small {\n  color: var(--muted);\n}\n.device-grid article>b {\n  color: var(--green);\n  font-size: 12px;\n}\n.device-actions {\n  display: flex;\n  flex-direction: column;\n  align-items: flex-end;\n  gap: 6px;\n}\n.device-btn {\n  padding: 5px 12px;\n  border: 1px solid var(--border);\n  border-radius: 8px;\n  background: #f3f6fa;\n  color: var(--navy);\n  font-size: 12px;\n  font-weight: 600;\n  cursor: pointer;\n  transition: all .15s ease;\n}\n.device-btn:hover {\n  background: var(--blue-soft);\n  color: var(--blue);\n  border-color: var(--blue);\n}\n.settings-form {\n  display: grid;\n  gap: 18px;\n}\n.settings-form>div:first-child {\n  margin-bottom: 4px;\n}\n.settings-form>label:not(.settings-toggle) {\n  display: grid;\n  gap: 8px;\n  color: var(--secondary);\n  font-size: 14px;\n}\n.settings-form>label>input {\n  max-width: 480px;\n}\n.settings-toggle {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 20px;\n  max-width: 620px;\n  padding: 15px 0;\n  border-bottom: 1px solid var(--line);\n}\n.settings-toggle span {\n  display: flex;\n  flex-direction: column;\n  gap: 3px;\n}\n.settings-toggle small {\n  color: var(--muted);\n}\n.settings-toggle input {\n  width: 22px;\n  height: 22px;\n  accent-color: var(--blue);\n}\n@media (max-width:1050px) {\n  .admin-metrics {\n    grid-template-columns: 1fr 1fr;\n  }\n  .admin-overview-grid {\n    grid-template-columns: 1fr;\n  }\n  .admin-workspace {\n    grid-template-columns: 82px minmax(0,1fr);\n  }\n  .admin-sidebar {\n    padding-inline: 12px;\n  }\n  .admin-sidebar .brand-word,.admin-sidebar nav span,.admin-sidebar__foot span,.admin-sidebar__foot button span {\n    display: none;\n  }\n  .admin-sidebar nav button,.admin-sidebar__foot button {\n    justify-content: center;\n  }\n  .admin-sidebar .brand-mark {\n    justify-content: center;\n    padding: 0;\n  }\n}\n@media (max-width:700px) {\n  .admin-workspace {\n    display: block;\n  }\n  .admin-sidebar {\n    position: static;\n    width: 100%;\n    height: auto;\n    padding: 12px;\n  }\n  .admin-sidebar .brand-mark,.admin-sidebar__foot {\n    display: none;\n  }\n  .admin-sidebar nav {\n    display: flex;\n    overflow-x: auto;\n  }\n  .admin-sidebar nav button {\n    min-width: 50px;\n    padding: 0 15px;\n  }\n  .admin-content {\n    padding: 24px 16px;\n  }\n  .admin-content__header h1 {\n    font-size: 31px;\n  }\n  .admin-metrics {\n    grid-template-columns: 1fr;\n  }\n  .device-grid {\n    grid-template-columns: 1fr;\n  }\n  .admin-toolbar,.admin-add-grader,.admin-card-actions {\n    align-items: stretch;\n    flex-direction: column;\n  }\n  .price-editor>label {\n    align-items: flex-start;\n    flex-direction: column;\n  }\n  .grader-admin-list>div {\n    grid-template-columns: auto 1fr auto;\n  }\n  .grader-admin-list .status-label {\n    display: none;\n  }\n  .admin-table-card {\n    overflow-x: auto;\n  }\n}\n.sample-options--two {\n  grid-template-columns: repeat(2,minmax(0,1fr));\n  align-items: stretch;\n  max-width: 820px;\n}\n.live-camera {\n  position: relative;\n  width: 100%;\n  min-height: 500px;\n  border-radius: 28px;\n  overflow: hidden;\n  background: #07111d;\n  box-shadow: var(--shadow);\n}\n.live-camera--demo {\n  background: #fff;\n}\n.live-camera--demo img {\n  object-fit: contain;\n  background: #fff;\n}\n.camera-demo-badge {\n  position: absolute;\n  top: 16px;\n  left: 16px;\n  padding: 8px 12px;\n  border-radius: 99px;\n  background: rgba(7,30,92,.88);\n  color: #fff;\n  font-size: 13px;\n  font-weight: 700;\n  letter-spacing: .04em;\n  z-index: 2;\n}\n.live-camera video {\n  display: block;\n  width: 100%;\n  height: 500px;\n  object-fit: cover;\n}\n.live-camera .target-corners {\n  inset: 18% 14%;\n}\n.camera-error {\n  position: absolute;\n  inset: 0;\n  display: grid;\n  place-content: center;\n  justify-items: center;\n  gap: 14px;\n  padding: 28px;\n  text-align: center;\n  color: #fff;\n  background: #1F2937;\n}\n.tutorial-stage__image {\n  display: block;\n  width: 100%;\n  height: 430px;\n  object-fit: contain;\n  border: 1px solid var(--border);\n  border-radius: 28px;\n  background: #fff;\n  box-shadow: var(--shadow);\n}\n.admin-card.is-selected {\n  border: 2px solid var(--blue);\n  background: var(--blue-soft);\n}\n.admin-panel {\n  margin-top: 22px;\n  padding: 24px;\n  border: 1px solid var(--border);\n  border-radius: 22px;\n  background: #fff;\n  box-shadow: var(--shadow-soft);\n}\n.admin-panel h2 {\n  margin: 8px 0 18px;\n}\n.admin-rows {\n  display: grid;\n  gap: 8px;\n  margin-bottom: 18px;\n}\n.admin-rows span {\n  display: flex;\n  justify-content: space-between;\n  gap: 20px;\n  padding: 12px;\n  border-radius: 12px;\n  background: #f5f8fc;\n  color: var(--secondary);\n}\n.admin-fields {\n  display: grid;\n  grid-template-columns: repeat(3,1fr);\n  gap: 12px;\n  margin-bottom: 18px;\n}\n.admin-fields label {\n  display: grid;\n  gap: 7px;\n  color: var(--secondary);\n}\n.admin-fields input {\n  min-height: 48px;\n  border: 1px solid var(--border);\n  border-radius: 12px;\n  padding: 0 12px;\n  font: inherit;\n}\n@media (max-width:680px) {\n  .sample-options--two,.admin-fields {\n    grid-template-columns: 1fr;\n  }\n  .live-camera,.live-camera video {\n    min-height: 320px;\n    height: 320px;\n  }\n  .tutorial-stage__image {\n    height: 300px;\n  }\n}\n@font-face {\n  font-family: 'Open Runde';\n  src: url('/fonts/OpenRunde-Medium.woff2') format('woff2');\n  font-weight: 500;\n  font-style: normal;\n  font-display: swap;\n}\n@font-face {\n  font-family: 'Open Runde';\n  src: url('/fonts/OpenRunde-Semibold.woff2') format('woff2');\n  font-weight: 600;\n  font-style: normal;\n  font-display: swap;\n}\n@font-face {\n  font-family: 'Open Runde';\n  src: url('/fonts/OpenRunde-Bold.woff2') format('woff2');\n  font-weight: 700;\n  font-style: normal;\n  font-display: swap;\n}\n@font-face {\n  font-family: 'Open Runde Bold';\n  src: url('/fonts/OpenRunde-Bold.woff2') format('woff2');\n  font-weight: 700;\n  font-style: normal;\n  font-display: swap;\n}\nbody {\n  font-family: 'Open Runde',ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;\n}\n:root {\n  font-family: 'Open Runde',ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;\n  color: #111827;\n  background: #f5f7fa;\n  font-synthesis: none;\n  text-rendering: optimizeLegibility;\n  --canvas: #f5f7fa;\n  --surface: #fff;\n  --navy: #111827;\n  --ink: #1F2937;\n  --secondary: #536477;\n  --muted: #8292a6;\n  --border: #dee6ef;\n  --line: #e9eff5;\n  --blue: #176BFF;\n  --blue-dark: #062DBF;\n  --blue-soft: #EEF4FF;\n  --cyan: #2478FF;\n  --green: #176b4b;\n  --amber: #8a5900;\n  --red: #9a3c29;\n  --space-1: 8px;\n  --space-2: 16px;\n  --space-3: 24px;\n  --space-4: 32px;\n  --space-5: 48px;\n  --space-6: 64px;\n  --radius-card: 24px;\n  --radius-control: 18px;\n  --shadow: 0 18px 50px rgba(17,24,39,.08);\n  --shadow-soft: 0 6px 20px rgba(17,24,39,.08);\n}\n* {\n  box-sizing: border-box;\n}\nhtml,body,#root {\n  min-width: 320px;\n  min-height: 100%;\n  margin: 0;\n  scroll-behavior: smooth;\n}\nbody {\n  min-height: 100vh;\n  background: radial-gradient(circle at 86% -10%,rgba(23,107,255,.08),transparent 32%),var(--canvas);\n}\nbutton,input {\n  font: inherit;\n}\nbutton {\n  cursor: pointer;\n}\nbutton:disabled {\n  cursor: not-allowed;\n}\nbutton:focus-visible,input:focus-visible {\n  outline: 4px solid rgba(36,120,255,.35);\n  outline-offset: 3px;\n}\n::selection {\n  background: rgba(23,107,255,.18);\n}\n.app-shell {\n  height: 100vh;\n  max-height: 100vh;\n  display: flex;\n  flex-direction: column;\n  overflow: hidden;\n}\n.app-shell:has(.site-shell),.app-shell:has(.marketing-landing),.app-shell:has(.welcome-screen),.app-shell--landing {\n  height: auto !important;\n  min-height: 100vh !important;\n  max-height: none !important;\n  overflow-y: auto !important;\n}\n.app-main {\n  flex: 1;\n  display: flex;\n  flex-direction: column;\n  min-height: calc(100vh - 102px);\n}\n.app-main--welcome {\n  min-height: 100vh !important;\n  height: auto !important;\n  overflow-y: visible !important;\n}\n.topbar-wrapper {\n  position: sticky;\n  top: 12px;\n  z-index: 100;\n  width: 100%;\n  padding: 0 clamp(16px,3vw,36px);\n  pointer-events: none;\n}\n.topbar {\n  pointer-events: auto;\n  max-width: 1100px;\n  margin: 0 auto;\n  height: 60px;\n  min-height: 60px;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 20px;\n  padding: 0 16px 0 20px;\n  border-radius: 9999px;\n  border: 1px solid rgba(255,255,255,.9);\n  background: rgba(255,255,255,.92);\n  backdrop-filter: blur(20px) saturate(180%);\n  box-shadow: 0 12px 32px rgba(17,24,39,.08),0 2px 8px rgba(17,24,39,.03),inset 0 1px 0 rgba(255,255,255,.95);\n  position: relative;\n  z-index: 2;\n}\n.topbar__center {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n.topbar__title {\n  color: var(--navy);\n  font-weight: 600;\n  font-size: 16px;\n  letter-spacing: -.01em;\n}\n.topbar__actions {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n}\n.status-pill {\n  display: inline-flex;\n  align-items: center;\n  gap: 8px;\n  padding: 6px 14px;\n  border: 1px solid #d2e0f2;\n  background: #f4f8fe;\n  border-radius: 9999px;\n  color: #274b78;\n  font-size: 13px;\n  font-weight: 500;\n  white-space: nowrap;\n}\n.icon-button {\n  width: 40px !important;\n  height: 40px !important;\n  border: 1px solid #d2e0f2 !important;\n  background: #ffffff !important;\n  border-radius: 9999px !important;\n  color: var(--navy) !important;\n  display: grid;\n  place-items: center;\n  transition: all .18s ease;\n}\n.icon-button:hover {\n  border-color: #176BFF !important;\n  background: #EEF4FF !important;\n  color: #176BFF !important;\n  transform: scale(1.04);\n}\n.topbar__brand-link,.admin-sidebar__brand-link {\n  all: unset;\n  cursor: pointer;\n  display: flex;\n  align-items: center;\n  border-radius: 12px;\n  transition: opacity .18s ease;\n}\n.topbar__brand-link:hover,.admin-sidebar__brand-link:hover {\n  opacity: .72;\n}\n.step-rail {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  color: #93a1b1;\n  font-size: 14px;\n  white-space: nowrap;\n}\n.step-rail__item {\n  display: flex;\n  align-items: center;\n  gap: 7px;\n}\n.step-rail__item.is-active {\n  color: var(--navy);\n  font-weight: 600;\n}\n.step-rail__dot {\n  width: 28px;\n  height: 28px;\n  border: 1px solid var(--border);\n  border-radius: 50%;\n  display: grid;\n  place-items: center;\n  background: var(--surface);\n  font-size: 12px;\n}\n.step-rail__item.is-active .step-rail__dot {\n  border-color: var(--blue);\n  background: var(--blue);\n  color: #fff;\n}\n.step-rail__item i {\n  width: 28px;\n  height: 1px;\n  background: var(--border);\n  display: block;\n  margin: 0 2px;\n}\n.step-rail__item.is-active i {\n  background: #9FC1FF;\n}\n.screen-stack {\n  width: min(1180px,calc(100% - 96px));\n  margin: 0 auto;\n  flex: 1;\n  display: flex;\n  flex-direction: column;\n  gap: 32px;\n  padding: 64px 0 32px;\n}\n.screen-stack--narrow {\n  width: min(680px,calc(100% - 96px));\n  justify-content: center;\n  align-items: center;\n  text-align: center;\n}\n.screen-stack--narrow .bottom-bar {\n  width: 100%;\n}\n.screen-stack--role {\n  justify-content: center;\n  max-width: 1080px;\n  position: relative;\n}\n.screen-stack--weight {\n  max-width: 1100px;\n  justify-content: center;\n}\n.screen-stack--placement,.screen-stack--camera,.screen-stack--review {\n  max-width: 1240px;\n  justify-content: center;\n}\n.screen-stack--result,.screen-stack--recovery,.screen-stack--print {\n  max-width: 1190px;\n  justify-content: center;\n}\n.eyebrow {\n  display: block;\n  color: var(--blue);\n  font-size: 15px;\n  font-weight: 600;\n  letter-spacing: .04em;\n}\n.section-heading h1,.role-intro h1,.placement-copy h1,.camera-aside h1,.review-aside h1,.recovery-hero h1,.print-copy h1,.screen-stack--narrow h1 {\n  font-size: 44px;\n  line-height: 1.06;\n  letter-spacing: -.045em;\n  margin: 12px 0 14px;\n  color: var(--navy);\n}\n.section-heading p,.role-intro p,.placement-copy p,.camera-aside>p,.review-aside>p,.print-copy>p,.screen-stack--narrow>p {\n  max-width: 640px;\n  margin: 0;\n  color: var(--secondary);\n  font-size: 21px;\n  line-height: 1.45;\n}\n.btn {\n  min-height: 58px;\n  padding: 0 24px;\n  border-radius: 18px;\n  border: 1px solid transparent;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 12px;\n  font-size: 20px;\n  font-weight: 600;\n  transition: transform .18s ease,background .18s ease,border-color .18s ease,box-shadow .18s ease,opacity .18s ease;\n}\n.btn:active {\n  transform: scale(.985);\n}\n.btn:disabled {\n  opacity: .45;\n}\n.btn--primary {\n  background: var(--blue);\n  color: #fff;\n  box-shadow: 0 10px 22px rgba(23,107,255,.22);\n}\n.btn--primary:hover {\n  background: #0B45E5;\n  box-shadow: 0 12px 26px rgba(23,107,255,.28);\n}\n.btn--secondary {\n  background: var(--surface);\n  color: var(--blue);\n  border-color: #bfd2f0;\n  box-shadow: var(--shadow-soft);\n}\n.btn--secondary:hover {\n  background: #f7fbff;\n  border-color: var(--blue);\n}\n.btn--ghost {\n  background: transparent;\n  color: var(--secondary);\n  padding-left: 12px;\n  padding-right: 12px;\n}\n.btn--ghost:hover {\n  background: #eef4fb;\n  color: var(--navy);\n}\n.btn--danger {\n  background: #fff5f2;\n  color: var(--red);\n  border-color: #f2cbc1;\n}\n.btn--hero {\n  min-height: 80px;\n  padding: 0 34px;\n  border-radius: 24px;\n  font-size: 24px;\n}\n.bottom-bar {\n  margin-top: auto;\n  min-height: 84px;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 24px;\n  border-top: 1px solid var(--line);\n  padding-top: 20px;\n}\n.bottom-bar__left,.bottom-bar__right {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n}\n.bottom-bar__right {\n  gap: 16px;\n}\n.welcome-screen {\n  position: relative;\n  min-height: 100vh;\n  height: auto;\n  padding: 48px 64px 40px;\n  display: grid;\n  grid-template-rows: auto 1fr auto;\n  overflow-x: hidden;\n  overflow-y: auto;\n}\n.welcome-screen__ambient {\n  position: absolute;\n  inset: 0;\n  pointer-events: none;\n  background: radial-gradient(circle at 68% 45%,rgba(36,120,255,.11),transparent 27%),linear-gradient(120deg,rgba(255,255,255,.4),transparent 62%);\n}\n.welcome-screen__brand,.welcome-screen__hero,.welcome-screen__cta {\n  position: relative;\n  z-index: 1;\n}\n.welcome-screen__brand {\n  display: flex;\n  align-items: flex-start;\n  justify-content: space-between;\n}\n.ready-line {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  color: var(--secondary);\n  font-size: 16px;\n  margin-top: 10px;\n}\n.welcome-screen__hero {\n  align-self: center;\n  justify-self: center;\n  text-align: center;\n  max-width: 720px;\n  padding: 12px 0 28px;\n}\n.welcome-screen__hero h1 {\n  font-size: 68px;\n  line-height: 1.02;\n  letter-spacing: -.065em;\n  margin: 16px 0 22px;\n  color: var(--navy);\n}\n.welcome-screen__hero h1 em {\n  font-style: normal;\n  color: var(--blue);\n}\n.welcome-screen__hero p {\n  font-size: 21px;\n  line-height: 1.48;\n  color: var(--secondary);\n  max-width: 580px;\n  margin: 0 auto;\n}\n.welcome-illustration {\n  position: relative;\n  width: 210px;\n  height: 100px;\n  margin: 42px auto 0;\n}\n.welcome-illustration__ring {\n  position: absolute;\n  left: 50%;\n  top: 12px;\n  width: 88px;\n  height: 88px;\n  border-radius: 28px;\n  transform: translateX(-50%) rotate(11deg);\n  border: 2px solid rgba(23,107,255,.35);\n  background: linear-gradient(135deg,#fff,rgba(234,242,255,.7));\n  box-shadow: 0 16px 32px rgba(23,107,255,.10);\n}\n.welcome-illustration__eye {\n  position: absolute;\n  left: 50%;\n  top: 40px;\n  width: 28px;\n  height: 28px;\n  transform: translateX(-50%);\n  border-radius: 50%;\n  background: var(--blue);\n  box-shadow: 0 0 0 12px rgba(23,107,255,.10),0 0 0 22px rgba(36,120,255,.06);\n}\n.welcome-illustration__ray {\n  position: absolute;\n  height: 2px;\n  width: 58px;\n  background: linear-gradient(90deg,transparent,var(--cyan));\n  border-radius: 99px;\n}\n.welcome-illustration__ray--one {\n  left: 0;\n  top: 48px;\n  transform: rotate(-11deg);\n}\n.welcome-illustration__ray--two {\n  right: 0;\n  top: 28px;\n  transform: rotate(15deg);\n}\n.welcome-illustration__ray--three {\n  right: -3px;\n  bottom: 11px;\n  transform: rotate(-20deg);\n  opacity: .55;\n}\n.welcome-screen__cta {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 12px;\n}\n.welcome-screen__cta>span {\n  color: var(--muted);\n  font-size: 15px;\n}\n.tutorial-fab {\n  position: absolute;\n  right: 48px;\n  bottom: 40px;\n  z-index: 2;\n  min-height: 56px;\n  padding: 0 18px;\n  border: 1px solid #c8d8ee;\n  color: var(--blue);\n  background: rgba(255,255,255,.88);\n  box-shadow: var(--shadow-soft);\n  border-radius: 18px;\n  display: inline-flex;\n  align-items: center;\n  gap: 10px;\n  font-size: 17px;\n  font-weight: 600;\n}\n.tutorial-fab:hover {\n  background: #fff;\n  border-color: #9FC1FF;\n}\n.tutorial-fab--inline {\n  position: static;\n  box-shadow: none;\n  background: transparent;\n  border: none;\n}\n.role-intro {\n  text-align: center;\n}\n.role-intro h1 {\n  margin-bottom: 12px;\n}\n.role-intro p {\n  margin: 0 auto;\n}\n.role-actions {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 24px;\n  margin-top: 16px;\n}\n.role-button {\n  min-height: 170px;\n  border: 1px solid var(--border);\n  background: var(--surface);\n  border-radius: 28px;\n  padding: 30px;\n  display: flex;\n  align-items: center;\n  gap: 22px;\n  text-align: left;\n  color: var(--navy);\n  box-shadow: var(--shadow-soft);\n  transition: transform .18s ease,border-color .18s ease,box-shadow .18s ease;\n}\n.role-button:hover {\n  transform: translateY(-3px);\n  border-color: #a9c3e7;\n  box-shadow: var(--shadow);\n}\n.role-button--primary {\n  border-color: rgba(23,107,255,.25);\n  background: linear-gradient(135deg,#fff 0%,#F3F6FF 100%);\n}\n.role-button>span:nth-child(2) {\n  display: flex;\n  flex-direction: column;\n  gap: 7px;\n  flex: 1;\n}\n.role-button strong {\n  font-size: 28px;\n  letter-spacing: -.04em;\n}\n.role-button small {\n  font-size: 17px;\n  color: var(--secondary);\n}\n.role-button__icon {\n  width: 70px;\n  height: 70px;\n  border-radius: 22px;\n  display: grid;\n  place-items: center;\n  background: var(--blue-soft);\n  color: var(--blue);\n}\n.role-button--primary .role-button__icon {\n  background: var(--blue);\n  color: #fff;\n}\n.role-button>svg {\n  color: #93a1b1;\n}\n.role-note {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 16px;\n  color: var(--muted);\n  font-size: 15px;\n  margin-top: 4px;\n}\n.role-note__line {\n  width: 68px;\n  height: 1px;\n  background: var(--border);\n}\n.role-bottom {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  border-top: 1px solid var(--line);\n  padding-top: 18px;\n  margin-top: auto;\n}\n.admin-icon {\n  width: 76px;\n  height: 76px;\n  border-radius: 24px;\n  display: grid;\n  place-items: center;\n  color: var(--blue);\n  background: var(--blue-soft);\n  margin-bottom: 8px;\n}\n.pin-label {\n  width: 100%;\n  display: flex;\n  flex-direction: column;\n  gap: 12px;\n  text-align: left;\n  color: var(--secondary);\n  font-size: 17px;\n  margin-top: 16px;\n}\n.pin-label input {\n  width: 100%;\n  height: 78px;\n  padding: 0 22px;\n  border: 1px solid var(--border);\n  border-radius: 20px;\n  text-align: center;\n  letter-spacing: .28em;\n  font-size: 36px;\n  color: var(--navy);\n  background: var(--surface);\n  box-shadow: var(--shadow-soft);\n}\n.form-hint {\n  display: flex;\n  align-items: center;\n  gap: 7px;\n  color: var(--muted);\n  font-size: 15px;\n  margin-top: 4px;\n}\n.weight-panel {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 72px;\n  align-items: center;\n  padding: 40px;\n  border: 1px solid var(--border);\n  border-radius: 28px;\n  background: var(--surface);\n  box-shadow: var(--shadow);\n}\n.weight-panel h1 {\n  font-size: 48px;\n  line-height: 1.03;\n  letter-spacing: -.055em;\n  margin: 12px 0 16px;\n}\n.weight-panel__copy>p {\n  font-size: 21px;\n  line-height: 1.45;\n  color: var(--secondary);\n  max-width: 500px;\n}\n.manual-callout {\n  display: flex;\n  align-items: center;\n  gap: 14px;\n  margin-top: 34px;\n  padding: 16px 18px;\n  border-radius: 18px;\n  background: #f5f8fc;\n  border: 1px solid var(--line);\n  width: max-content;\n  max-width: 100%;\n}\n.manual-callout__icon {\n  width: 44px;\n  height: 44px;\n  border-radius: 14px;\n  display: grid;\n  place-items: center;\n  background: var(--blue-soft);\n  color: var(--blue);\n}\n.manual-callout span:last-child {\n  display: flex;\n  flex-direction: column;\n  gap: 2px;\n}\n.manual-callout strong {\n  font-size: 17px;\n}\n.manual-callout small {\n  font-size: 14px;\n  color: var(--muted);\n}\n.weight-entry {\n  padding: 18px;\n}\n.weight-entry>label {\n  display: block;\n  color: var(--secondary);\n  font-size: 17px;\n  margin-bottom: 12px;\n}\n.weight-input {\n  display: flex;\n  align-items: center;\n  border-bottom: 2px solid var(--blue);\n  padding: 0 0 8px;\n}\n.weight-input input {\n  width: 100%;\n  min-width: 0;\n  border: 0;\n  background: transparent;\n  color: var(--navy);\n  font-size: 88px;\n  letter-spacing: -.07em;\n  line-height: 1.08;\n  outline: 0;\n}\n.weight-input span {\n  color: var(--secondary);\n  font-size: 24px;\n  padding-bottom: 8px;\n}\n.preset-row {\n  display: flex;\n  gap: 10px;\n  margin-top: 22px;\n}\n.preset-row button {\n  min-height: 48px;\n  padding: 0 14px;\n  border-radius: 14px;\n  background: #f4f7fb;\n  border: 1px solid var(--border);\n  color: var(--secondary);\n  font-size: 16px;\n}\n.preset-row button:hover,.preset-row button.is-selected {\n  border-color: #9cbef0;\n  color: var(--blue);\n  background: var(--blue-soft);\n}\n.input-status {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  color: var(--muted);\n  font-size: 15px;\n  margin-top: 20px;\n}\n.input-status.is-valid {\n  color: var(--green);\n}\n.sample-options {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 24px;\n  margin-top: 10px;\n}\n.sample-card {\n  position: relative;\n  min-height: 270px;\n  padding: 28px;\n  border: 1px solid var(--border);\n  background: var(--surface);\n  border-radius: 28px;\n  text-align: left;\n  display: flex;\n  flex-direction: column;\n  align-items: flex-start;\n  gap: 18px;\n  box-shadow: var(--shadow-soft);\n  transition: transform .18s ease,border-color .18s ease,box-shadow .18s ease;\n}\n.sample-card:hover {\n  transform: translateY(-2px);\n  border-color: #a9c3e7;\n}\n.sample-card.is-selected {\n  border: 3px solid var(--blue);\n  padding: 26px;\n  box-shadow: 0 14px 32px rgba(23,107,255,.12);\n}\n.sample-card__label {\n  display: flex;\n  flex-direction: column;\n  gap: 6px;\n}\n.sample-card__label strong {\n  font-size: 28px;\n  letter-spacing: -.04em;\n}\n.sample-card__label small {\n  color: var(--secondary);\n  font-size: 17px;\n}\n.sample-card__check {\n  position: absolute;\n  right: 22px;\n  top: 22px;\n  width: 38px;\n  height: 38px;\n  border-radius: 50%;\n  display: grid;\n  place-items: center;\n  color: var(--blue);\n  background: var(--blue-soft);\n}\n.sample-visual {\n  position: relative;\n  width: 100%;\n  height: 128px;\n  border-radius: 22px;\n  background: linear-gradient(135deg,#f4f8fd,#EEF4FF);\n  overflow: hidden;\n}\n.sample-visual:before {\n  content: '';\n  position: absolute;\n  inset: 22px 36px;\n  border: 2px solid rgba(23,107,255,.22);\n  border-radius: 50%;\n  transform: rotate(-7deg);\n}\n.sample-visual span {\n  position: absolute;\n  left: 50%;\n  top: 50%;\n  width: 110px;\n  height: 38px;\n  transform: translate(-50%,-50%) rotate(-9deg);\n  border-radius: 50% 52% 48% 50%;\n  background: linear-gradient(90deg,#c8d7e4,#fff 40%,#a9c6d8);\n  box-shadow: 0 11px 18px rgba(55,99,133,.14);\n}\n.sample-visual span:after {\n  content: '';\n  position: absolute;\n  right: 12px;\n  top: 12px;\n  width: 6px;\n  height: 6px;\n  border-radius: 50%;\n  background: #526f86;\n}\n.sample-visual--tail span {\n  width: 78px;\n  height: 52px;\n  border-radius: 50% 22% 62% 42%;\n  transform: translate(-50%,-50%) rotate(35deg);\n}\n.sample-visual--tail span:before {\n  content: '';\n  position: absolute;\n  left: -28px;\n  top: 13px;\n  border-style: solid;\n  border-width: 13px 26px 13px 0;\n  border-color: transparent #aac4d4 transparent transparent;\n}\n.placement-copy {\n  max-width: 360px;\n  position: relative;\n}\n.placement-number {\n  font-size: 88px;\n  line-height: .9;\n  letter-spacing: -.08em;\n  color: #d7e5fa;\n  margin: 22px 0 4px;\n}\n.placement-copy h1 {\n  font-size: 46px;\n  margin-top: 0;\n}\n.placement-dots {\n  display: flex;\n  gap: 8px;\n  margin-top: 28px;\n}\n.placement-dots button {\n  width: 42px;\n  height: 8px;\n  border: 0;\n  border-radius: 99px;\n  background: #dce5f0;\n  padding: 0;\n}\n.placement-dots button.is-active {\n  background: var(--blue);\n}\n.placement-tip {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  color: var(--blue);\n  font-size: 15px;\n  margin-top: 28px;\n}\n.screen-stack--placement {\n  display: grid;\n  grid-template-columns: 32% 68%;\n  grid-template-rows: 1fr auto;\n  gap: 20px 42px;\n}\n.screen-stack--placement .placement-copy {\n  align-self: center;\n}\n.screen-stack--placement .evidence-frame {\n  min-height: 390px;\n}\n.screen-stack--placement .bottom-bar {\n  grid-column: 1 / -1;\n}\n.evidence-frame {\n  position: relative;\n  min-height: 470px;\n  border: 1px solid #cbd9e9;\n  border-radius: 28px;\n  overflow: hidden;\n  background: linear-gradient(140deg,#eef5fc 0%,#fdfefe 48%,#e6f0fb 100%);\n  box-shadow: var(--shadow);\n  display: flex;\n  flex-direction: column;\n  padding: 18px 20px;\n}\n.evidence-frame__glow {\n  position: absolute;\n  inset: -30% 12% 25%;\n  background: radial-gradient(circle,rgba(93,217,245,.24),transparent 56%);\n  pointer-events: none;\n}\n.evidence-frame__topline,.evidence-frame__bottomline {\n  position: relative;\n  z-index: 1;\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  color: var(--secondary);\n  font-size: 14px;\n}\n.evidence-frame__signal {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n}\n.evidence-frame__signal .status-dot {\n  width: 7px;\n  height: 7px;\n}\n.chamber {\n  position: relative;\n  flex: 1;\n  min-height: 315px;\n  margin: 14px 2px;\n  border-radius: 22px;\n  background: linear-gradient(145deg,#dbe7f0,#f7fbff 44%,#d7e4ee);\n  box-shadow: inset 0 2px 0 rgba(255,255,255,.8),inset 0 -14px 24px rgba(80,117,144,.12);\n  overflow: hidden;\n}\n.chamber:before {\n  content: '';\n  position: absolute;\n  inset: 26px 30px;\n  border-radius: 18px;\n  border: 1px solid rgba(83,100,119,.24);\n  background: linear-gradient(140deg,rgba(255,255,255,.65),rgba(184,207,225,.25));\n  box-shadow: inset 0 0 40px rgba(42,85,123,.08);\n}\n.chamber__rail {\n  position: absolute;\n  z-index: 2;\n  top: 16%;\n  bottom: 16%;\n  width: 12px;\n  border-radius: 99px;\n  background: linear-gradient(#b4cadb,#f9fcff,#abc3d6);\n  box-shadow: 0 5px 10px rgba(40,76,105,.12);\n}\n.chamber__rail--left {\n  left: 9%;\n}\n.chamber__rail--right {\n  right: 9%;\n}\n.tuna-silhouette {\n  position: absolute;\n  left: 50%;\n  top: 50%;\n  z-index: 3;\n  width: 45%;\n  height: 17%;\n  transform: translate(-50%,-50%) rotate(-7deg);\n  filter: drop-shadow(0 18px 16px rgba(50,91,121,.18));\n}\n.tuna-silhouette__body {\n  position: absolute;\n  inset: 0;\n  border-radius: 53% 48% 44% 52%;\n  background: linear-gradient(180deg,#e6f0f4 0%,#a4bfd0 47%,#718fa7 100%);\n  border: 1px solid #6f8da1;\n}\n.tuna-silhouette__body:before {\n  content: '';\n  position: absolute;\n  left: 22%;\n  right: 10%;\n  top: 48%;\n  height: 1px;\n  background: rgba(49,78,96,.35);\n}\n.tuna-silhouette__tail {\n  position: absolute;\n  left: -15%;\n  top: 18%;\n  width: 25%;\n  height: 68%;\n  clip-path: polygon(100% 50%,0 0,16% 50%,0 100%);\n  background: #84a8be;\n}\n.tuna-silhouette__eye {\n  position: absolute;\n  right: 9%;\n  top: 37%;\n  width: 6px;\n  height: 6px;\n  border-radius: 50%;\n  background: #273e52;\n}\n.target-corners {\n  position: absolute;\n  z-index: 4;\n  inset: 28% 18%;\n  border: 1px dashed rgba(23,107,255,.55);\n  border-radius: 16px;\n}\n.target-corners i {\n  position: absolute;\n  width: 26px;\n  height: 26px;\n  border-color: var(--blue);\n  border-style: solid;\n}\n.target-corners i:nth-child(1) {\n  left: -2px;\n  top: -2px;\n  border-width: 3px 0 0 3px;\n  border-radius: 8px 0 0;\n}\n.target-corners i:nth-child(2) {\n  right: -2px;\n  top: -2px;\n  border-width: 3px 3px 0 0;\n  border-radius: 0 8px 0 0;\n}\n.target-corners i:nth-child(3) {\n  right: -2px;\n  bottom: -2px;\n  border-width: 0 3px 3px 0;\n  border-radius: 0 0 8px;\n}\n.target-corners i:nth-child(4) {\n  left: -2px;\n  bottom: -2px;\n  border-width: 0 0 3px 3px;\n  border-radius: 0 0 0 8px;\n}\n.camera-crosshair {\n  position: absolute;\n  z-index: 5;\n  inset: 42% 46%;\n  border: 1px solid rgba(23,107,255,.38);\n  border-radius: 50%;\n}\n.camera-crosshair:before,.camera-crosshair:after {\n  content: '';\n  position: absolute;\n  background: var(--blue);\n}\n.camera-crosshair:before {\n  left: 50%;\n  top: -11px;\n  width: 1px;\n  height: calc(100% + 22px);\n}\n.camera-crosshair:after {\n  top: 50%;\n  left: -11px;\n  height: 1px;\n  width: calc(100% + 22px);\n}\n.camera-crosshair span {\n  position: absolute;\n  inset: 7px;\n  border-radius: 50%;\n  background: rgba(23,107,255,.18);\n}\n.evidence-frame__bottomline {\n  border-top: 1px solid rgba(145,170,194,.35);\n  padding-top: 12px;\n}\n.evidence-frame__time {\n  color: #8091a5;\n}\n.evidence-frame--camera .chamber {\n  background: linear-gradient(145deg,#d9e7f2,#fbffff 46%,#d4e1eb);\n}\n.evidence-frame.is-frozen .chamber {\n  filter: saturate(.76);\n}\n.screen-stack--camera {\n  display: grid;\n  grid-template-rows: 1fr auto;\n  gap: 24px;\n}\n.camera-layout {\n  display: grid;\n  grid-template-columns: minmax(0,7fr) minmax(300px,3fr);\n  gap: 36px;\n  align-items: stretch;\n}\n.camera-layout .evidence-frame {\n  min-height: 500px;\n}\n.camera-aside {\n  display: flex;\n  flex-direction: column;\n  padding: 16px 0;\n}\n.camera-aside h1 {\n  font-size: 38px;\n}\n.camera-aside>p {\n  font-size: 18px;\n}\n.quality-list {\n  display: flex;\n  flex-direction: column;\n  gap: 12px;\n  margin-top: 30px;\n}\n.quality-item {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  padding: 12px 0;\n  border-bottom: 1px solid var(--line);\n}\n.quality-item>span {\n  width: 32px;\n  height: 32px;\n  border-radius: 10px;\n  display: grid;\n  place-items: center;\n  color: var(--blue);\n  background: var(--blue-soft);\n}\n.quality-item--ready>span {\n  color: var(--green);\n  background: #e9f6ef;\n}\n.quality-item div {\n  display: flex;\n  flex-direction: column;\n  gap: 2px;\n}\n.quality-item strong {\n  font-size: 16px;\n}\n.quality-item small {\n  color: var(--muted);\n  font-size: 14px;\n}\n.demo-outcome {\n  margin-top: auto;\n  padding: 14px;\n  border: 1px solid var(--border);\n  border-radius: 18px;\n  background: #fbfcfe;\n}\n.demo-outcome>span {\n  font-size: 14px;\n  color: var(--secondary);\n  font-weight: 600;\n}\n.demo-outcome>div {\n  display: flex;\n  gap: 6px;\n  margin-top: 9px;\n}\n.demo-outcome button {\n  height: 38px;\n  flex: 1;\n  border: 1px solid var(--border);\n  border-radius: 10px;\n  background: #fff;\n  color: var(--secondary);\n  font-size: 13px;\n  text-transform: capitalize;\n}\n.demo-outcome button.is-selected {\n  border-color: var(--blue);\n  background: var(--blue-soft);\n  color: var(--blue);\n  font-weight: 600;\n}\n.demo-outcome small {\n  display: block;\n  color: var(--muted);\n  font-size: 12px;\n  line-height: 1.35;\n  margin-top: 8px;\n}\n.screen-stack--review {\n  display: grid;\n  grid-template-rows: 1fr auto;\n  gap: 24px;\n}\n.review-layout {\n  display: grid;\n  grid-template-columns: minmax(0,7fr) minmax(300px,3fr);\n  gap: 36px;\n  align-items: center;\n}\n.review-layout .evidence-frame {\n  min-height: 470px;\n}\n.review-aside {\n  padding: 16px 0;\n}\n.review-badge {\n  display: inline-flex;\n  align-items: center;\n  gap: 7px;\n  width: max-content;\n  padding: 9px 13px;\n  border-radius: 999px;\n  font-size: 15px;\n  font-weight: 600;\n}\n.review-badge--valid {\n  color: var(--green);\n  background: #e9f6ef;\n}\n.review-badge--uncertain {\n  color: var(--amber);\n  background: #fff5db;\n}\n.review-badge--invalid {\n  color: var(--red);\n  background: #fff0ec;\n}\n.review-aside h1 {\n  font-size: 40px;\n}\n.review-aside>p {\n  font-size: 19px;\n}\n.review-note {\n  display: flex;\n  align-items: center;\n  gap: 9px;\n  color: var(--secondary);\n  font-size: 14px;\n  margin-top: 28px;\n  padding-top: 18px;\n  border-top: 1px solid var(--line);\n}\n.analysis-screen {\n  flex: 1;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  text-align: center;\n  padding: 52px 24px;\n  gap: 12px;\n}\n.analysis-screen__visual {\n  position: relative;\n  width: min(520px,80vw);\n  height: 260px;\n}\n.analysis-screen__visual .evidence-frame {\n  height: 260px;\n  min-height: 0;\n}\n.analysis-screen h1 {\n  font-size: 46px;\n  letter-spacing: -.05em;\n  margin: 4px 0 0;\n}\n.analysis-screen>p {\n  margin: 0;\n  color: var(--secondary);\n  font-size: 20px;\n}\n.analysis-screen .step-rail {\n  margin-top: 18px;\n}\n.analysis-status {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  color: var(--secondary);\n  font-size: 15px;\n  margin-top: 12px;\n}\n.spinner {\n  width: 18px;\n  height: 18px;\n  border: 2px solid #cfe0f8;\n  border-top-color: var(--blue);\n  border-radius: 50%;\n  animation: spin .9s linear infinite;\n}\n@keyframes spin {\n  to {\n    transform: rotate(360deg);\n  }\n}\n.analysis-pulse {\n  position: absolute;\n  z-index: 6;\n  left: 50%;\n  top: 50%;\n  display: flex;\n  gap: 5px;\n  transform: translate(-50%,-50%);\n}\n.analysis-pulse span {\n  width: 7px;\n  height: 7px;\n  border-radius: 50%;\n  background: var(--blue);\n  animation: pulse 1.1s ease-in-out infinite;\n}\n.analysis-pulse span:nth-child(2) {\n  animation-delay: .15s;\n}\n.analysis-pulse span:nth-child(3) {\n  animation-delay: .3s;\n}\n@keyframes pulse {\n  0%,80%,100% {\n    opacity: .3;\n    transform: scale(.8);\n  }\n  40% {\n    opacity: 1;\n    transform: scale(1);\n  }\n}\n.screen-stack--result {\n  gap: 24px;\n}\n.result-layout {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 64px;\n  align-items: center;\n}\n.grade-hero {\n  padding: 16px 0;\n}\n.grade-letter {\n  font-size: 160px;\n  line-height: .9;\n  font-weight: 700;\n  letter-spacing: -.1em;\n  color: var(--green);\n  margin: 26px 0 10px;\n}\n.grade-hero h1 {\n  font-size: 42px;\n  letter-spacing: -.05em;\n  margin: 0 0 12px;\n}\n.grade-hero p {\n  font-size: 20px;\n  color: var(--secondary);\n  margin: 0;\n  max-width: 420px;\n}\n.confidence {\n  margin-top: 34px;\n  max-width: 430px;\n}\n.confidence__label {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  color: var(--secondary);\n  font-size: 16px;\n}\n.confidence__label strong {\n  font-size: 22px;\n  color: var(--green);\n}\n.confidence__track {\n  height: 10px;\n  border-radius: 99px;\n  background: #e1ebf0;\n  margin-top: 10px;\n  overflow: hidden;\n}\n.confidence__track span {\n  display: block;\n  height: 100%;\n  border-radius: 99px;\n  background: linear-gradient(90deg,#6ac093,var(--green));\n}\n.result-details {\n  padding: 18px;\n  border-radius: 28px;\n  border: 1px solid var(--border);\n  background: var(--surface);\n  box-shadow: var(--shadow);\n}\n.evidence-frame--result {\n  min-height: 260px;\n  height: 260px;\n  box-shadow: none;\n}\n.evidence-frame--result .chamber {\n  min-height: 150px;\n}\n.result-details dl {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 0;\n  margin: 18px 0 0;\n  border-top: 1px solid var(--line);\n}\n.result-details dl div {\n  display: flex;\n  flex-direction: column;\n  gap: 5px;\n  padding: 15px 8px 6px;\n}\n.result-details dt {\n  color: var(--muted);\n  font-size: 14px;\n}\n.result-details dd {\n  margin: 0;\n  color: var(--navy);\n  font-size: 16px;\n  font-weight: 600;\n}\n.result-details dd .saved-dot {\n  display: inline-block;\n  width: 8px;\n  height: 8px;\n  border-radius: 50%;\n  background: #2eb67d;\n  margin-right: 7px;\n}\n.result-actions {\n  display: flex;\n  justify-content: space-between;\n  gap: 16px;\n  border-top: 1px solid var(--line);\n  padding-top: 20px;\n}\n.result-actions .btn:first-child {\n  margin-right: auto;\n}\n.recovery-hero {\n  text-align: center;\n  max-width: 700px;\n  margin: 0 auto;\n  padding: 42px 24px 26px;\n  border-radius: 28px;\n}\n.recovery-hero--uncertain {\n  background: #fff8e9;\n  border: 1px solid #f0d9a0;\n}\n.recovery-hero--invalid {\n  background: #f9f4f2;\n  border: 1px solid #ead8d1;\n}\n.recovery-hero__icon {\n  width: 70px;\n  height: 70px;\n  border-radius: 24px;\n  display: grid;\n  place-items: center;\n  margin: 0 auto 18px;\n  background: #fff;\n  color: var(--amber);\n}\n.recovery-hero--invalid .recovery-hero__icon {\n  color: var(--red);\n}\n.recovery-hero h1 {\n  font-size: 44px;\n}\n.recovery-hero p {\n  max-width: 530px;\n  margin: 0 auto;\n  color: var(--secondary);\n  font-size: 20px;\n  line-height: 1.45;\n}\n.recovery-actions {\n  display: flex;\n  justify-content: center;\n  gap: 16px;\n}\n.recovery-note {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 8px;\n  color: var(--secondary);\n  font-size: 15px;\n  padding-top: 14px;\n  border-top: 1px solid var(--line);\n}\n.screen-stack--print {\n  gap: 24px;\n}\n.print-layout {\n  display: grid;\n  grid-template-columns