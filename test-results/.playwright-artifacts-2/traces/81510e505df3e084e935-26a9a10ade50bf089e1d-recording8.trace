ader-entry__copy p {\n  font-size: 20px;\n  line-height: 1.48;\n  color: var(--secondary);\n  max-width: 470px;\n  margin: 0;\n}\n.grader-entry__form {\n  padding: 12px 0;\n}\n.field-label {\n  display: flex;\n  flex-direction: column;\n  gap: 10px;\n  color: var(--secondary);\n  font-size: 16px;\n}\n.field-label input,.field-label textarea {\n  border: 1px solid var(--border);\n  border-radius: 18px;\n  background: #fff;\n  color: var(--navy);\n  padding: 0 18px;\n  min-height: 62px;\n  outline: none;\n  box-shadow: var(--shadow-soft);\n}\n.field-label textarea {\n  padding: 14px 16px;\n  resize: vertical;\n  min-height: 94px;\n}\n.grader-profiles {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 8px;\n  margin-top: 16px;\n}\n.grader-profiles button {\n  min-height: 46px;\n  border: 1px solid var(--border);\n  background: #f7faff;\n  color: var(--secondary);\n  padding: 0 14px;\n  border-radius: 14px;\n  font-size: 14px;\n}\n.grader-profiles button.is-selected {\n  border-color: var(--blue);\n  color: var(--blue);\n  background: var(--blue-soft);\n  font-weight: 600;\n}\n.remember-row {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  color: var(--secondary);\n  font-size: 16px;\n  margin-top: 26px;\n}\n.remember-row input {\n  width: 20px;\n  height: 20px;\n  accent-color: var(--blue);\n}\n.legal-links {\n  display: flex;\n  gap: 8px;\n  align-items: center;\n  color: var(--muted);\n  font-size: 14px;\n  margin-top: 32px;\n}\n.legal-links button {\n  border: 0;\n  background: transparent;\n  color: var(--blue);\n  text-decoration: underline;\n  text-underline-offset: 3px;\n  padding: 0;\n  font-size: 14px;\n}\n.legal-links button:hover {\n  color: var(--blue-dark);\n}\n.error-text {\n  display: flex;\n  align-items: center;\n  gap: 7px;\n  color: var(--red);\n  font-size: 15px;\n  margin-top: 10px;\n}\n.sample-options--three {\n  grid-template-columns: repeat(3,1fr);\n  align-items: stretch;\n}\n.selector-card {\n  min-height: 340px;\n  padding: 20px;\n}\n.selector-card.is-selected {\n  padding: 18px;\n}\n.selector-card__art {\n  width: 100%;\n  height: 170px;\n  display: flex;\n  gap: 8px;\n  align-items: center;\n  justify-content: center;\n  border-radius: 19px;\n  overflow: hidden;\n  background: #f5f9fd;\n}\n.selector-card__art .sample-art {\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n}\n.selector-card__art .sample-art:only-child {\n  width: 100%;\n}\n.selector-card__art .sample-art:not(:only-child) {\n  width: 50%;\n  object-fit: cover;\n}\n.selector-note {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  color: var(--secondary);\n  font-size: 15px;\n  padding: 14px 16px;\n  border: 1px solid var(--border);\n  border-radius: 16px;\n  background: #fff;\n  width: max-content;\n  max-width: 100%;\n}\n.sample-art {\n  display: block;\n  max-width: 100%;\n  object-fit: cover;\n  border-radius: 18px;\n}\n.association-copy {\n  max-width: 760px;\n}\n.association-copy h1 {\n  font-size: 52px;\n  line-height: 1.03;\n  letter-spacing: -.06em;\n  margin: 14px 0;\n}\n.association-copy p {\n  font-size: 20px;\n  line-height: 1.45;\n  color: var(--secondary);\n  max-width: 700px;\n}\n.association-options {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 22px;\n  margin-top: 20px;\n}\n.association-options button {\n  position: relative;\n  min-height: 190px;\n  border: 1px solid var(--border);\n  background: #fff;\n  border-radius: 26px;\n  padding: 26px;\n  text-align: left;\n  box-shadow: var(--shadow-soft);\n  display: flex;\n  flex-direction: column;\n  align-items: flex-start;\n  gap: 12px;\n  transition: transform .18s ease,border-color .18s ease,box-shadow .18s ease;\n}\n.association-options button:hover {\n  transform: translateY(-2px);\n  border-color: #a9c3e7;\n}\n.association-options button.is-selected {\n  border: 3px solid var(--blue);\n  padding: 24px;\n  background: #f8fbff;\n}\n.association-options button>span:first-child {\n  width: 56px;\n  height: 56px;\n  border-radius: 18