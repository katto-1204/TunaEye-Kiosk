;\n    margin: 7px 0 !important;\n  }\n  .grade-hero h1 {\n    font-size: 28px !important;\n    margin-bottom: 5px !important;\n  }\n  .grade-hero p,.confidence__label span {\n    font-size: 14px !important;\n  }\n  .confidence {\n    margin-top: 9px !important;\n  }\n  .result-badges {\n    margin-top: 9px !important;\n  }\n  .result-details {\n    padding: 8px !important;\n  }\n  .result-details>.result-sample-image {\n    height: 18vh !important;\n    margin-bottom: 5px !important;\n  }\n  .result-details dl {\n    margin-top: 5px !important;\n  }\n  .result-details dl div {\n    padding: 6px 5px !important;\n  }\n  .result-actions {\n    padding-top: 7px !important;\n    gap: 7px !important;\n    flex-direction: row !important;\n  }\n  .result-actions .btn {\n    padding-inline: 10px !important;\n    font-size: 14px !important;\n  }\n  .overview-cards {\n    gap: 8px !important;\n  }\n  .overview-card {\n    padding: 10px !important;\n  }\n  .overview-card__head .result-sample-image {\n    width: 100px !important;\n    height: 70px !important;\n  }\n  .overview-card__stats {\n    margin: 7px 0 3px !important;\n    padding: 6px 0 !important;\n  }\n  .combined-panel {\n    padding: 10px !important;\n  }\n  .combined-panel p {\n    display: none;\n  }\n  .screen-stack--overview .section-heading p {\n    display: none;\n  }\n  .screen-stack--overview .section-heading h1 {\n    font-size: 28px !important;\n    margin: 5px 0 !important;\n  }\n}\n.evidence-frame__capture {\n  display: block;\n  width: 100%;\n  min-height: 0;\n  flex: 1;\n  margin: 12px 0;\n  border-radius: 20px;\n  object-fit: cover;\n  background: #07111d;\n}\n.app-main:not(.app-main--welcome):not(.app-main--complete):not(.app-main--admin-dashboard) {\n  height: calc(100dvh - 102px);\n  min-height: 0;\n  overflow: hidden;\n}\n.app-main:not(.app-main--welcome):not(.app-main--complete):not(.app-main--admin-dashboard) .screen-stack {\n  min-height: 0;\n  max-height: 100%;\n  padding-block: clamp(18px,4vh