herits: false;\n}\n@property --tw-ring-shadow {\n  syntax: \"*\";\n  inherits: false;\n  initial-value: 0 0 #0000;\n}\n@property --tw-inset-ring-color {\n  syntax: \"*\";\n  inherits: false;\n}\n@property --tw-inset-ring-shadow {\n  syntax: \"*\";\n  inherits: false;\n  initial-value: 0 0 #0000;\n}\n@property --tw-ring-inset {\n  syntax: \"*\";\n  inherits: false;\n}\n@property --tw-ring-offset-width {\n  syntax: \"<length>\";\n  inherits: false;\n  initial-value: 0px;\n}\n@property --tw-ring-offset-color {\n  syntax: \"*\";\n  inherits: false;\n  initial-value: #fff;\n}\n@property --tw-ring-offset-shadow {\n  syntax: \"*\";\n  inherits: false;\n  initial-value: 0 0 #0000;\n}\n@property --tw-blur {\n  syntax: \"*\";\n  inherits: false;\n}\n@property --tw-brightness {\n  syntax: \"*\";\n  inherits: false;\n}\n@property --tw-contrast {\n  syntax: \"*\";\n  inherits: false;\n}\n@property --tw-grayscale {\n  syntax: \"*\";\n  inherits: false;\n}\n@property --tw-hue-rotate {\n  syntax: \"*\";\n  inherits: false;\n}\n@property --tw-invert {\n  syntax: \"*\";\n  inherits: false;\n}\n@property --tw-opacity {\n  syntax: \"*\";\n  inherits: false;\n}\n@property --tw-saturate {\n  syntax: \"*\";\n  inherits: false;\n}\n@property --tw-sepia {\n  syntax: \"*\";\n  inherits: false;\n}\n@property --tw-drop-shadow {\n  syntax: \"*\";\n  inherits: false;\n}\n@property --tw-drop-shadow-color {\n  syntax: \"*\";\n  inherits: false;\n}\n@property --tw-drop-shadow-alpha {\n  syntax: \"<percentage>\";\n  inherits: false;\n  initial-value: 100%;\n}\n@property --tw-drop-shadow-size {\n  syntax: \"*\";\n  inherits: false;\n}\n@keyframes spin {\n  to {\n    transform: rotate(360deg);\n  }\n}\n@keyframes ping {\n  75%, 100% {\n    transform: scale(2);\n    opacity: 0;\n  }\n}\n@keyframes pulse {\n  50% {\n    opacity: 0.5;\n  }\n}\n@layer properties {\n  @supports ((-webkit-hyphens: none) and (not (margin-trim: inline))) or ((-moz-orient: inline) and (not (color:rgb(from red r g b)))) {\n    *, ::before, ::after, ::backdrop {\n      --tw-translate-x: 0;\n      --tw-translate-y: 0;\n      --tw-translate-z: 0;\n      --tw-rotate-x: initial;\n      --tw-rotate-y: initial;\n      --tw-rotate-z: initial;\n      --tw-skew-x: initial;\n      --tw-skew-y: initial;\n      --tw-space-y-reverse: 0;\n      --tw-border-style: solid;\n      --tw-gradient-position: initial;\n      --tw-gradient-from: #0000;\n      --tw-gradient-via: #0000;\n      --tw-gradient-to: #0000;\n      --tw-gradient-stops: initial;\n      --tw-gradient-via-stops: initial;\n      --tw-gradient-from-position: 0%;\n      --tw-gradient-via-position: 50%;\n      --tw-gradient-to-position: 100%;\n      --tw-font-weight: initial;\n      --tw-tracking: initial;\n      --tw-shadow: 0 0 #0000;\n      --tw-shadow-color: initial;\n      --tw-shadow-alpha: 100%;\n      --tw-inset-shadow: 0 0 #0000;\n      --tw-inset-shadow-color: initial;\n      --tw-inset-shadow-alpha: 100%;\n      --tw-ring-color: initial;\n      --tw-ring-shadow: 0 0 #0000;\n      --tw-inset-ring-color: initial;\n      --tw-inset-ring-shadow: 0 0 #0000;\n      --tw-ring-inset: initial;\n      --tw-ring-offset-width: 0px;\n      --tw-ring-offset-color: #fff;\n      --tw-ring-offset-shadow: 0 0 #0000;\n      --tw-blur: initial;\n      --tw-brightness: initial;\n      --tw-contrast: initial;\n      --tw-grayscale: initial;\n      --tw-hue-rotate: initial;\n      --tw-invert: initial;\n      --tw-opacity: initial;\n      --tw-saturate: initial;\n      --tw-sepia: initial;\n      --tw-drop-shadow: initial;\n      --tw-drop-shadow-color: initial;\n      --tw-drop-shadow-alpha: 100%;\n      --tw-drop-shadow-size: initial;\n    }\n  }\n}\n"],["STYLE",{},".brand-loading{height:100dvh;display:grid;place-content:center;justify-items:center;gap:10px;background:radial-gradient(circle,#eaf3ff,#f7f9fc 58%);color:#123d73}.brand-loading .brand-mark{margin-bottom:24px}.brand-loading__mark{display:flex;gap:8px}.brand-loading__mark span{width:10px;height:10px;border-radius:50%;background:#2563eb;animation:loading-dot 1s ease-in-out infinite}.brand-loading__mark span:nth-child(2){animation-delay:.14s}.brand-loading__mark span:nth-child(3){animation-delay:.28s}.brand-loading strong{font-size:24px}.brand-loading small{color:#728197}@keyframes loading-dot{50%{transform:translateY(-8px);opacity:1}0%,100%{opacity:.35}}\n.marketing-landing{min-height:100dvh;height:auto;overflow-x:hidden;overflow-y:auto;background:#f8fbff;color:#123d73;scroll-behavior:smooth}.marketing-nav{position:sticky;top:0;z-index:10;display:flex;align-items:center;justify-content:space-between;padding:18px clamp(24px,6vw,88px);border-bottom:1px solid #d7e2ef;background:rgba(255,255,255,.92);backdrop-filter:blur(14px)}.marketing-nav>div,.marketing-actions,.marketing-proof,.marketing-footer>div{display:flex;align-items:center;gap:18px}.marketing-nav a,.marketing-nav button,.marketing-footer button{border:0;background:transparent;color:#4a607b;font:inherit;text-decoration:none}.marketing-nav button{padding:11px 18px;border-radius:13px;background:#123d73;color:#fff;font-weight:600}.marketing-hero{min-height:calc(100dvh - 82px);display:grid;grid-template-columns:1.05fr .95fr;align-items:center;gap:clamp(38px,7vw,100px);padding:clamp(54px,8vw,110px) clamp(28px,8vw,120px);background:radial-gradient(circle at 80% 18%,rgba(41,169,232,.16),transparent 32%),linear-gradient(145deg,#f9fbff,#eef5ff)}.marketing-hero h1{font-size:clamp(56px,7vw,96px);line-height:.92;letter-spacing:-.075em;margin:20px 0}.marketing-hero h1 em{color:#2563eb;font-style:normal}.marketing-hero p{max-width:680px;color:#4a607b;font-size:clamp(18px,1.7vw,24px);line-height:1.5}.marketing-actions,.marketing-proof{flex-wrap:wrap;margin-top:28px}.marketing-proof span{padding:8px 11px;border:1px solid #d7e2ef;border-radius:999px;background:#fff;color:#4a607b;font-size:13px}.marketing-visual{position:relative;min-height:480px;display:grid;place-items:center;border-radius:42px;background:linear-gradient(145deg,#0a376b,#07254c);box-shadow:0 35px 80px rgba(16,56,104,.22);overflow:hidden}.marketing-visual img{width:88%;height:88%;object-fit:contain}.marketing-visual>div{position:absolute;left:24px;bottom:24px;display:flex;flex-direction:column;padding:15px 18px;border-radius:16px;background:rgba(255,255,255,.92)}.marketing-visual span{color:#4a607b;font-size:13px}.marketing-section,.marketing-split{padding:clamp(70px,9vw,130px) clamp(28px,8vw,120px)}.marketing-section>h2,.marketing-split h2{max-width:850px;font-size:clamp(38px,5vw,66px);line-height:1;letter-spacing:-.06em;margin:14px 0 38px}.marketing-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}.marketing-grid article{padding:28px;border:1px solid #d7e2ef;border-radius:24px;background:#fff}.marketing-grid svg{color:#2563eb}.marketing-grid h3{font-size:22px;margin:22px 0 8px}.marketing-grid p,.marketing-team p,.marketing-split>p,.faq-grid p{color:#4a607b;font-size:17px;line-height:1.55}.marketing-split{display:grid;grid-template-columns:1fr 1fr;gap:70px;align-items:center;background:#123d73;color:#fff}.marketing-split .eyebrow{color:#83c8ff}.marketing-split>p{color:#c8d8e9;font-size:21px}.marketing-team{text-align:center;background:#eef5ff}.marketing-team h2,.marketing-team p{margin-inline:auto}.marketing-team p{max-width:780px}.faq-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.faq-grid details{padding:22px;border:1px solid #d7e2ef;border-radius:19px;background:#fff}.faq-grid summary{font-size:18px;font-weight:700;cursor:pointer}.marketing-footer{display:flex;align-items:center;justify-content:space-between;gap:20px;padding:28px clamp(28px,8vw,120px);border-top:1px solid #d7e2ef;background:#fff;color:#728197}\n.onboarding-slider{width:min(650px,100%);margin:24px auto 0;overflow:hidden}.onboarding-track{display:flex;transition:transform .35s ease}.onboarding-track article{min-width:100%;display:flex;align-items:center;justify-content:center;gap:14px;padding:18px 22px;border:1px solid #cddff4;border-radius:22px;background:rgba(255,255,255,.78);text-align:left}.onboarding-track article>span{width:50px;height:50px;display:grid;place-items:center;flex:none;border-radius:16px;background:#e8f0ff;color:#2563eb}.onboarding-track article>div{display:flex;flex-direction:column;gap:4px}.onboarding-track strong{font-size:19px}.onboarding-track small{color:#4a607b;font-size:14px;line-height:1.35}.onboarding-dots{display:flex;justify-content:center;gap:7px;margin-top:10px}.onboarding-dots button{width:9px;height:9px;padding:0;border:0;border-radius:99px;background:#cbd9ea}.onboarding-dots button.is-active{width:30px;background:#2563eb}\n.otp-screen{max-width:720px}.otp-screen h1{font-size:clamp(38px,5vw,56px);margin:10px 0}.otp-screen>p{max-width:590px}.otp-inputs{display:flex;justify-content:center;gap:14px;margin:20px 0}.otp-inputs input{width:76px;height:88px;border:2px solid #c9d8e9;border-radius:20px;background:#fff;color:#123d73;font-size:42px;font-weight:700;text-align:center;outline:none}.otp-inputs input:focus{border-color:#2563eb;box-shadow:0 0 0 5px #e8f0ff}.connection-settings{display:grid;grid-template-columns:1fr 1fr;gap:14px}.connection-settings label{display:grid;gap:7px;color:#4a607b;font-size:13px}.connection-settings input{width:100%;min-height:50px;padding:0 14px;border:1px solid #d7e2ef;border-radius:13px;background:#fff;color:#123d73;font:inherit}.connection-status{display:flex;align-items:center;gap:16px;padding:16px;border:1px solid #d7e2ef;border-radius:16px;background:#f8fbff}.connection-status>span:nth-child(2){flex:1;color:#4a607b}.audit-list{display:grid}.audit-list article{display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:13px;padding:12px 4px;border-bottom:1px solid #e6edf5}.audit-list article>span{width:38px;height:38px;display:grid;place-items:center;border-radius:12px;background:#e8f0ff;color:#2563eb}.audit-list article>div{display:flex;flex-direction:column;gap:3px}.audit-list small,.audit-list time{color:#728197;font-size:12px}\n@media(max-width:900px){.marketing-nav a{display:none}.marketing-hero{grid-template-columns:1fr;min-height:auto}.marketing-visual{min-height:360px}.marketing-grid{grid-template-columns:1fr 1fr}.marketing-split{grid-template-columns:1fr;gap:20px}.faq-grid{grid-template-columns:1fr}.connection-settings{grid-template-columns:1fr}.connection-status{align-items:stretch;flex-direction:column}.otp-inputs input{width:62px;height:72px}.grader-dashboard__hero-actions{flex-wrap:wrap}}\n"],["STYLE",{},".site-shell {\n  font-family: 'Open Runde', ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;\n  min-height: 100dvh;\n  height: auto;\n  background: #f5f8fc;\n  color: #103b70;\n  overflow-x: hidden;\n  overflow-y: auto;\n  scroll-behavior: smooth;\n  -webkit-overflow-scrolling: touch;\n}\n\n/* Product demo sections */\n.site-demo-video,\n.mobile-experience-grid,\n.installation-grid {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: clamp(48px, 7vw, 110px);\n  align-items: center;\n  padding: clamp(80px, 9vw, 130px) clamp(28px, 8vw, 120px);\n}\n.site-demo-video { background: #fff; }\n.site-mobile-experience { padding: 0; background: linear-gradient(145deg, #f2f7fd, #e8f2fc); }\n.site-installation { padding: 0; background: #fff; }\n.site-demo-video__copy h2,\n.mobile-experience__right h3,\n.installation__copy h2 { margin: 12px 0 0; color: #103b70; line-height: 1.02; letter-spacing: -.055em; }\n.site-demo-video__copy h2,\n.installation__copy h2 { font-size: clamp(38px, 4.5vw, 64px); }\n.mobile-experience__right h3 { font-size: clamp(34px, 4vw, 56px); }\n.site-demo-video__visual { aspect-ratio: 16/10; height: auto; padding: 0; border: 1px solid #cadbec; box-shadow: 0 28px 70px rgba(16,59,112,.16); }\n.video-placeholder { background: radial-gradient(circle at 50% 42%, #f8fbff, #dceaf8); }\n.video-overlay { padding: 18px 24px; background: rgba(7,37,76,.88); }\n.mobile-experience__left { display: grid; grid-template-columns: minmax(220px,300px) minmax(140px,1fr); align-items: center; gap: 28px; }\n.device-mockup { max-width: 280px; }\n.qr-section { align-items: flex-start; }\n.qr-code { width: 100%; height: auto; min-height: 180px; padding: 18px; flex-direction: column; gap: 12px; text-align: center; }\n.qr-code p { margin: 0; color: #526a85; font-size: 13px; line-height: 1.35; }\n.mobile-experience__right .experience-steps,\n.installation__copy .installation-steps { gap: 20px; }\n.site-mobile-experience .step,\n.site-installation .step { gap: 16px; }\n.site-mobile-experience .step-number,\n.site-installation .step-number { width: 36px; height: 36px; font-size: 13px; }\n.installation-diagram { width: 100%; justify-content: center; gap: 12px; }\n.installation-diagram .device-phone,\n.installation-diagram .device-tablet,\n.installation-diagram .device-pi,\n.installation-diagram .device-grader { width: 92px; height: 116px; padding: 10px; border: 1px solid #d7e4f2; }\n.installation-diagram .arrow { color: #2769eb; font-size: 24px; }\n\n@media (max-width: 980px) {\n  .site-demo-video,\n  .mobile-experience-grid,\n  .installation-grid { grid-template-columns: 1fr; }\n  .site-demo-video__visual { grid-row: 1; }\n  .mobile-experience__left { grid-template-columns: minmax(220px,300px) minmax(180px,260px); justify-content: center; }\n}\n\n@media (max-width: 620px) {\n  .site-demo-video,\n  .mobile-experience-grid,\n  .installation-grid { padding: 64px 20px; gap: 38px; }\n  .mobile-experience__left { grid-template-columns: 1fr; justify-items: center; }\n  .qr-section { align-items: center; width: min(260px,100%); }\n  .installation-diagram { display: grid; grid-template-columns: 1fr 24px 1fr; }\n  .installation-diagram .arrow:nth-of-type(3) { display: none; }\n}\n\n.site-logo {\n  display: inline-flex;\n  align-items: center;\n  gap: 10px;\n  white-space: nowrap;\n}\n.site-logo img {\n  width: 38px;\n  height: 38px;\n}\n.site-logo strong {\n  font-size: 24px;\n  letter-spacing: -0.05em;\n}\n.site-logo strong span {\n  color: #2769eb;\n}\n\n/* FLOATING PILL NAVBAR */\n.site-nav-wrapper {\n  position: sticky;\n  top: 16px;\n  z-index: 100;\n  width: 100%;\n  padding: 0 clamp(16px, 4vw, 40px);\n  pointer-events: none;\n}\n.site-nav {\n  pointer-events: auto;\n  max-width: 1100px;\n  margin: 0 auto;\n  height: 64px;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 20px;\n  padding: 0 16px 0 24px;\n  border-radius: 9999px;\n  border: 1px solid rgba(255, 255, 255, 0.85);\n  background: rgba(255, 255, 255, 0.88);\n  backdrop-filter: blur(20px) saturate(180%);\n  box-shadow: 0 16px 36px rgba(16, 42, 77, 0.1), 0 4px 12px rgba(16, 42, 77, 0.04), inset 0 1px 0 rgba(255, 255, 255, 0.9);\n  transition: all 0.25s ease;\n}\n.site-nav nav {\n  display: flex;\n  align-items: center;\n  gap: 4px;\n}\n.site-nav nav > button,\n.site-nav-dropdown__toggle,\n.site-footer button {\n  border: 0;\n  background: transparent;\n  color: #526a85;\n  font: inherit;\n}\n.site-nav nav > button,\n.site-nav-dropdown__toggle {\n  padding: 8px 16px;\n  border-radius: 9999px;\n  font-size: 14px;\n  font-weight: 600;\n  cursor: pointer;\n  transition: all 0.2s ease;\n}\n.site-nav nav > button:hover,\n.site-nav-dropdown__toggle:hover {\n  background: rgba(39, 105, 235, 0.08);\n  color: #1e5fd9;\n}\n.site-nav nav > button.is-active,\n.site-nav-dropdown__toggle.is-active {\n  background: #2769eb;\n  color: #ffffff;\n  font-weight: 700;\n  box-shadow: 0 4px 14px rgba(39, 105, 235, 0.3);\n}\n\n/* DROPDOWN NAVIGATION MENU */\n.site-nav-dropdown {\n  position: relative;\n  display: inline-block;\n}\n.dropdown-chevron {\n  display: inline-block;\n  font-size: 11px;\n  margin-left: 2px;\n  transition: transform 0.2s ease;\n}\n.site-nav-dropdown.is-open .dropdown-chevron {\n  transform: rotate(180deg);\n}\n.site-nav-dropdown__menu {\n  position: absolute;\n  top: calc(100% + 10px);\n  left: 50%;\n  transform: translateX(-50%);\n  min-width: 210px;\n  padding: 8px;\n  border-radius: 18px;\n  background: #ffffff;\n  border: 1px solid rgba(205, 220, 238, 0.95);\n  box-shadow: 0 20px 48px rgba(16, 42, 77, 0.16), 0 6px 18px rgba(16, 42, 77, 0.06);\n  z-index: 1000;\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n  animation: dropdownFadeIn 0.2s cubic-bezier(0.16, 1, 0.3, 1);\n}\n@keyframes dropdownFadeIn {\n  from { opacity: 0; transform: translate(-50%, -8px) scale(0.96); }\n  to { opacity: 1; transform: translate(-50%, 0) scale(1); }\n}\n.site-nav-dropdown__menu button {\n  display: flex !important;\n  align-items: center !important;\n  justify-content: flex-start !important;\n  width: 100% !important;\n  padding: 10px 14px !important;\n  border-radius: 12px !important;\n  background: transparent !important;\n  color: #173b6c !important;\n  font-size: 14px !important;\n  font-weight: 600 !important;\n  text-align: left !important;\n  box-shadow: none !important;\n  white-space: nowrap !important;\n  cursor: pointer;\n  transition: all 0.15s ease !important;\n}\n.site-nav-dropdown__menu button:hover {\n  background: #eaf2ff !important;\n  color: #2563eb !important;\n  transform: translateX(3px) !important;\n}\n.site-nav-dropdown__menu button.is-active {\n  background: #2563eb !important;\n  color: #ffffff !important;\n}\n\n/* FLOATING BOTTOM RIGHT CHANGELOG TRIGGER */\n.fixed-changelog-trigger {\n  position: fixed;\n  bottom: 24px;\n  right: 24px;\n  z-index: 999;\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  padding: 8px 16px 8px 10px;\n  border-radius: 9999px;\n  background: rgba(255, 255, 255, 0.92);\n  border: 1px solid rgba(203, 220, 242, 0.85);\n  backdrop-filter: blur(12px);\n  -webkit-backdrop-filter: blur(12px);\n  box-shadow: 0 8px 24px rgba(9, 47, 94, 0.14);\n  color: #092f5e;\n  font-size: 13px;\n  font-weight: 600;\n  cursor: pointer;\n  transition: all 0.22s cubic-bezier(0.16, 1, 0.3, 1);\n}\n.fixed-changelog-trigger:hover {\n  transform: translateY(-3px) scale(1.02);\n  background: #ffffff;\n  border-color: #2467bf;\n  color: #2467bf;\n  box-shadow: 0 12px 32px rgba(36, 103, 191, 0.22);\n}\n.fixed-changelog-trigger .version-pill {\n  padding: 3px 9px;\n  border-radius: 9999px;\n  background: #2467bf;\n  color: #ffffff;\n  font-size: 11px;\n  font-weight: 700;\n  letter-spacing: 0.02em;\n}\n.fixed-changelog-trigger .sparkle-icon {\n  font-size: 14px;\n}\n\n/* CHANGELOG MODAL STYLING */\n.changelog-backdrop {\n  position: fixed;\n  inset: 0;\n  z-index: 1000;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  padding: 20px;\n  background: rgba(9, 47, 94, 0.45);\n  backdrop-filter: blur(8px);\n  -webkit-backdrop-filter: blur(8px);\n  animation: fadeIn 0.2s ease-out;\n}\n.changelog-modal {\n  width: 100%;\n  max-width: 520px;\n  max-height: calc(100dvh - 60px);\n  display: flex;\n  flex-direction: column;\n  border-radius: 24px;\n  background: #ffffff;\n  border: 1px solid rgba(203, 220, 242, 0.9);\n  box-shadow: 0 24px 64px rgba(9, 47, 94, 0.24);\n  overflow: hidden;\n  animation: modalSlideUp 0.25s cubic-bezier(0.16, 1, 0.3, 1);\n}\n.changelog-modal__header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  padding: 24px 28px 18px;\n  border-bottom: 1px solid #edf2f7;\n  background: linear-gradient(180deg, #f8fafc 0%, #ffffff 100%);\n}\n.changelog-modal__title-group {\n  display: flex;\n  flex-direction: column;\n  gap: 2px;\n}\n.changelog-kicker {\n  color: #2467bf;\n  font-size: 11px;\n  font-weight: 800;\n  letter-spacing: 0.1em;\n  text-transform: uppercase;\n}\n.changelog-modal__header h2 {\n  margin: 0;\n  color: #092f5e;\n  font-size: 22px;\n  font-weight: 700;\n  letter-spacing: -0.02em;\n}\n.changelog-close-btn {\n  width: 36px;\n  height: 36px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  border-radius: 50%;\n  border: 1px solid #e2e8f0;\n  background: #f8fafc;\n  color: #64748b;\n  font-size: 22px;\n  line-height: 1;\n  cursor: pointer;\n  transition: all 0.18s ease;\n}\n.changelog-close-btn:hover {\n  background: #edf2f7;\n  color: #092f5e;\n  border-color: #cbd5e1;\n}\n.changelog-modal__body {\n  padding: 24px 28px;\n  overflow-y: auto;\n  display: flex;\n  flex-direction: column;\n  gap: 24px;\n}\n.changelog-entry {\n  display: flex;\n  flex-direction: column;\n  gap: 12px;\n  padding-bottom: 20px;\n  border-bottom: 1px dashed #e2e8f0;\n}\n.changelog-entry:last-child {\n  padding-bottom: 0;\n  border-bottom: none;\n}\n.changelog-entry__head {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n}\n.changelog-version-badge {\n  padding: 4px 10px;\n  border-radius: 9999px;\n  background: #ebf5ff;\n  border: 1px solid #b9ddff;\n  color: #1d4ed8;\n  font-size: 12px;\n  font-weight: 700;\n}\n.changelog-date {\n  color: #64748b;\n  font-size: 13px;\n  font-weight: 500;\n}\n.changelog-list {\n  list-style: none;\n  padding: 0;\n  margin: 0;\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n}\n.changelog-list li {\n  display: flex;\n  align-items: flex-start;\n  gap: 10px;\n  color: #334155;\n  font-size: 14px;\n  line-height: 1.45;\n}\n.changelog-bullet {\n  width: 6px;\n  height: 6px;\n  border-radius: 50%;\n  background: #2467bf;\n  margin-top: 7px;\n  flex-shrink: 0;\n}\n@keyframes modalSlideUp {\n  from { opacity: 0; transform: translateY(16px) scale(0.98); }\n  to { opacity: 1; transform: translateY(0) scale(1); }\n}\n@keyframes fadeIn {\n  from { opacity: 0; }\n  to { opacity: 1; }\n}\n.site-nav__cta {\n  min-height: 42px;\n  padding: 0 22px;\n  border: 0;\n  border-radius: 9999px;\n  background: linear-gradient(135deg, #103b70, #1d5bd1);\n  color: #ffffff;\n  font-weight: 700;\n  font-size: 14px;\n  letter-spacing: -0.01em;\n  box-shadow: 0 6px 18px rgba(16, 59, 112, 0.22);\n  cursor: pointer;\n  transition: transform 0.15s ease, box-shadow 0.15s ease;\n}\n.site-nav__cta:hover {\n  transform: translateY(-1px);\n  box-shadow: 0 8px 22px rgba(16, 59, 112, 0.32);\n}\n\n.site-kicker {\n  color: #2769eb;\n  font-size: 13px;\n  font-weight: 800;\n  letter-spacing: 0.12em;\n  text-transform: uppercase;\n}\n.site-hero {\n  position: relative;\n  min-height: calc(100dvh - 80px);\n  height: auto;\n  display: grid;\n  grid-template-columns: 1.05fr 0.95fr;\n  grid-template-rows: 1fr auto;\n  align-items: center;\n  gap: 50px;\n  padding: clamp(60px, 7vw, 100px) clamp(28px, 7vw, 110px) 0;\n  background: linear-gradient(145deg, #f8fbff 10%, #eaf3ff 72%, #d9ecfa);\n  overflow: visible;\n  margin-top: -80px;\n  padding-top: 130px;\n}\n.site-hero__mesh {\n  position: absolute;\n  inset: 0;\n  background: linear-gradient(120deg, transparent 60%, rgba(39, 105, 235, 0.06) 60%), radial-gradient(circle at 17% 20%, rgba(43, 179, 232, 0.18), transparent 24%);\n  clip-path: polygon(0 0, 100% 0, 100% 88%, 84% 82%, 70% 92%, 55% 83%, 38% 93%, 20% 84%, 0 91%);\n}\n.site-hero__copy,\n.site-hero__visual {\n  position: relative;\n  z-index: 1;\n}\n.site-hero h1 {\n  font-size: clamp(54px, 6.5vw, 92px);\n  line-height: 0.92;\n  letter-spacing: -0.07em;\n  margin: 20px 0;\n}\n.site-hero h1 em {\n  color: #2769eb;\n  font-style: normal;\n}\n.site-hero__copy > p {\n  max-width: 690px;\n  color: #4a617d;\n  font-size: clamp(17px, 1.5vw, 22px);\n  line-height: 1.5;\n}\n.site-actions,\n.site-trust {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 12px;\n  margin-top: 28px;\n}\n.site-button {\n  min-height: 56px;\n  padding: 0 26px;\n  border: 1px solid #b9cce4;\n  border-radius: 9999px;\n  background: #fff;\n  color: #1d5bd1;\n  font: inherit;\n  font-size: 16px;\n  font-weight: 700;\n  cursor: pointer;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 8px;\n  transition: all 0.2s ease;\n}\n.site-button:hover {\n  transform: translateY(-2px);\n  box-shadow: 0 10px 24px rgba(29, 91, 209, 0.12);\n}\n.site-button--primary {\n  border-color: #2769eb;\n  background: linear-gradient(135deg, #2769eb, #1e5fd9);\n  color: #fff;\n  box-shadow: 0 16px 30px rgba(39, 105, 235, 0.28);\n}\n.site-button--primary:hover {\n  box-shadow: 0 20px 36px rgba(39, 105, 235, 0.38);\n}\n.site-button span {\n  margin-left: 4px;\n}\n.site-trust span {\n  padding: 8px 14px;\n  border-radius: 99px;\n  background: rgba(255, 255, 255, 0.85);\n  border: 1px solid rgba(190, 208, 230, 0.5);\n  color: #425974;\n  font-size: 13px;\n  font-weight: 600;\n}\n.site-hero__visual {\n  min-height: 480px;\n  display: grid;\n  place-items: center;\n  position: relative;\n}\n\n/* TUNAEYE HERO LOGO SVG ANIMATED COMPONENT */\n.tunaeye-hero-logo-container {\n  width: min(520px, 92vw);\n  height: min(520px, 92vw);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  position: relative;\n  cursor: pointer;\n  user-select: none;\n  touch-action: none;\n}\n\n.tunaeye-hero-logo-stage {\n  width: 100%;\n  height: 100%;\n  position: relative;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n\n/* Ambient Radial Glow */\n.tunaeye-logo-ambient-glow {\n  position: absolute;\n  width: 82%;\n  height: 82%;\n  border-radius: 50%;\n  background: radial-gradient(circle, rgba(56, 189, 248, 0.28) 0%, rgba(37, 99, 235, 0.15) 50%, transparent 75%);\n  filter: blur(30px);\n  pointer-events: none;\n  z-index: 1;\n}\n\n/* Back Parallax Grid & Orbits */\n.tunaeye-logo-parallax-back {\n  position: absolute;\n  inset: 0;\n  z-index: 2;\n  pointer-events: none;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n\n.tunaeye-back-svg {\n  width: 100%;\n  height: 100%;\n}\n\n.orbit-outer-ring {\n  fill: none;\n  stroke: rgba(56, 189, 248, 0.22);\n  stroke-width: 1.5;\n}\n\n.orbit-dashed-ring {\n  fill: none;\n  stroke: rgba(37, 99, 235, 0.35);\n  stroke-width: 2;\n  stroke-dasharray: 12 16;\n  animation: tunaeyeDashRotate 45s linear infinite;\n  transform-origin: center;\n}\n\n.orbit-inner-ring {\n  fill: none;\n  stroke: rgba(147, 197, 253, 0.28);\n  stroke-width: 1;\n}\n\n.orbit-tick {\n  stroke: rgba(56, 189, 248, 0.5);\n  stroke-width: 2.5;\n  stroke-linecap: round;\n}\n\n/* Main SVG Layer */\n.tunaeye-logo-main-layer {\n  position: absolute;\n  inset: 0;\n  z-index: 3;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n\n.tunaeye-hero-image {\n  width: min(480px, 88%);\n  height: auto;\n  position: relative;\n  z-index: 2;\n  filter: drop-shadow(0 28px 45px rgba(10, 50, 95, 0.22));\n}\n\n.tunaeye-hero-svg-overlay {\n  position: absolute;\n  inset: 0;\n  width: 100%;\n  height: 100%;\n  z-index: 3;\n  pointer-events: none;\n}\n\n/* Swim Group Continuous Rotation */\n.tunaeye-rotating-fish-group {\n  transform-origin: 250px 250px;\n  animation: tunaeyeSwimRotate 24s linear infinite;\n}\n\n.tunaeye-hero-logo-container:hover .tunaeye-rotating-fish-group {\n  animation-duration: 12s;\n}\n\n/* Fish Swimming Sway Physics */\n.tuna-fish {\n  transform-origin: 250px 250px;\n  transition: filter 0.3s ease;\n}\n\n.tuna-fish--cyan {\n  animation: tunaSwayLeft 4s ease-in-out infinite alternate;\n}\n\n.tuna-fish--deep {\n  animation: tunaSwayRight 4s ease-in-out infinite alternate;\n}\n\n/* Center Pulse Dot */\n.pulse-center-dot {\n  animation: tunaDotPulse 2s ease-in-out infinite;\n  transform-origin: 250px 250px;\n}\n\n/* Floating Parallax Particles */\n.tunaeye-logo-parallax-front {\n  position: absolute;\n  inset: 0;\n  z-index: 4;\n  pointer-events: none;\n}\n\n.particle-dot {\n  position: absolute;\n  border-radius: 50%;\n  background: #38bdf8;\n  box-shadow: 0 0 10px #38bdf8;\n  animation: particleFloat 3.5s ease-in-out infinite alternate;\n}\n\n.particle-dot--1 {\n  width: 8px;\n  height: 8px;\n  top: 18%;\n  left: 22%;\n  animation-delay: 0s;\n}\n\n.particle-dot--2 {\n  width: 6px;\n  height: 6px;\n  top: 72%;\n  right: 20%;\n  animation-delay: 0.8s;\n}\n\n.particle-dot--3 {\n  width: 10px;\n  height: 10px;\n  bottom: 22%;\n  left: 28%;\n  animation-delay: 1.5s;\n}\n\n.particle-dot--4 {\n  width: 7px;\n  height: 7px;\n  top: 30%;\n  right: 24%;\n  animation-delay: 2.2s;\n}\n\n/* Keyframe Animations */\n@keyframes tunaeyeSwimRotate {\n  from {\n    transform: rotate(0deg);\n  }\n  to {\n    transform: rotate(360deg);\n  }\n}\n\n@keyframes tunaeyeDashRotate {\n  from {\n    transform: rotate(360deg);\n  }\n  to {\n    transform: rotate(0deg);\n  }\n}\n\n@keyframes tunaSwayLeft {\n  0% {\n    transform: scale(1) rotate(0deg);\n  }\n  100% {\n    transform: scale(1.03) rotate(3deg);\n  }\n}\n\n@keyframes tunaSwayRight {\n  0% {\n    transform: rotate(180deg) scale(1);\n  }\n  100% {\n    transform: rotate(180deg) scale(1.03) rotate(-3deg);\n  }\n}\n\n@keyframes tunaDotPulse {\n  0%, 100% {\n    transform: scale(1);\n    opacity: 0.6;\n  }\n  50% {\n    transform: scale(1.5);\n    opacity: 1;\n  }\n}\n\n@keyframes particleFloat {\n  0% {\n    transform: translateY(0px) scale(0.9);\n    opacity: 0.5;\n  }\n  100% {\n    transform: translateY(-12px) scale(1.2);\n    opacity: 1;\n  }\n}\n.site-hero__band {\n  position: relative;\n  z-index: 2;\n  grid-column: 1/-1;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 22px;\n  min-height: 68px;\n  border-radius: 24px 24px 0 0;\n  background: #103b70;\n  color: #fff;\n  font-weight: 700;\n}\n.site-hero__band i {\n  width: 7px;\n  height: 7px;\n  border-radius: 50%;\n  background: #55c7f0;\n}\n\n.site-story,\n.site-architecture {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: clamp(45px, 8vw, 120px);\n  align-items: center;\n  padding: clamp(90px, 10vw, 150px) clamp(28px, 9vw, 140px);\n  background: #fff;\n}\n.site-story h2,\n.site-hardware h2,\n.site-criteria h2,\n.site-workflow h2,\n.site-architecture h2,\n.site-faq-preview h2,\n.site-cta h2 {\n  font-size: clamp(38px, 4.5vw, 68px);\n  line-height: 1;\n  letter-spacing: -0.06em;\n  margin: 15px 0;\n}\n.site-story p,\n.site-architecture p,\n.site-faq-preview p {\n  color: #526a85;\n  font-size: 18px;\n  line-height: 1.6;\n}\n.site-text-link {\n  padding: 0;\n  border: 0;\n  background: transparent;\n  color: #2769eb;\n  font: inherit;\n  font-weight: 800;\n  cursor: pointer;\n}\n\n/* HARDWARE SECTION */\n.site-hardware {\n  padding: clamp(90px, 10vw, 140px) clamp(28px, 8vw, 120px);\n  background: #f0f6fd;\n}\n.site-hardware header {\n  text-align: center;\n  max-width: 780px;\n  margin: 0 auto 50px;\n}\n.hardware-grid {\n  display: grid;\n  grid-template-columns: repeat(4, 1fr);\n  gap: 20px;\n}\n.hardware-card {\n  padding: 28px 24px;\n  border-radius: 24px;\n  background: #ffffff;\n  border: 1px solid #d8e5f5;\n  box-shadow: 0 10px 30px rgba(16, 59, 112, 0.05);\n  display: flex;\n  flex-direction: column;\n}\n/* .hardware-card__icon sizing is defined below in the scroll-reveal section */\n.hardware-card h3 {\n  font-size: 20px;\n  margin: 0 0 10px;\n  color: #103b70;\n}\n.hardware-card p {\n  color: #526a85;\n  font-size: 14px;\n  line-height: 1.55;\n  margin: 0 0 18px;\n  flex: 1;\n}\n.hardware-card ul {\n  list-style: none;\n  padding: 0;\n  margin: 0;\n  border-top: 1px solid #edf3fa;\n  padding-top: 14px;\n}\n.hardware-card li {\n  color: #2769eb;\n  font-size: 13px;\n  font-weight: 700;\n  margin-bottom: 6px;\n  display: flex;\n  align-items: center;\n  gap: 6px;\n}\n.hardware-card li::before {\n  content: \"✓\";\n  color: #2eb67d;\n}\n\n/* CRITERIA SECTION */\n.site-criteria {\n  padding: clamp(90px, 10vw, 140px) clamp(28px, 8vw, 120px);\n  background: #ffffff;\n}\n.site-criteria__intro {\n  text-align: center;\n  max-width: 800px;\n  margin: 0 auto 40px;\n}\n.criteria-tabs {\n  display: flex;\n  justify-content: center;\n  gap: 12px;\n  margin-bottom: 40px;\n}\n.criteria-tabs button {\n  padding: 14px 28px;\n  border-radius: 9999px;\n  border: 1px solid #cce0f5;\n  background: #f4f8fe;\n  color: #3b5575;\n  font: inherit;\n  font-weight: 700;\n  font-size: 15px;\n  cursor: pointer;\n  transition: all 0.2s ease;\n}\n.criteria-tabs button.is-active {\n  background: #103b70;\n  color: #ffffff;\n  border-color: #103b70;\n  box-shadow: 0 8px 20px rgba(16, 59, 112, 0.2);\n}\n.criteria-panel {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 50px;\n  align-items: center;\n  padding: 40px;\n  border-radius: 32px;\n  background: linear-gradient(145deg, #f7faff, #edf5ff);\n  border: 1px solid #d4e3f5;\n}\n.criteria-panel__text h3 {\n  font-size: 28px;\n  margin: 0 0 12px;\n  color: #103b70;\n}\n.criteria-panel__text > p {\n  color: #526a85;\n  font-size: 16px;\n  line-height: 1.55;\n  margin-bottom: 24px;\n}\n.criteria-list {\n  display: flex;\n  flex-direction: column;\n  gap: 16px;\n}\n.criteria-list strong {\n  display: block;\n  color: #1d5bd1;\n  font-size: 15px;\n  margin-bottom: 4px;\n}\n.criteria-list p {\n  margin: 0;\n  color: #526a85;\n  font-size: 14px;\n  line-height: 1.5;\n}\n.criteria-panel__image {\n  position: relative;\n  display: grid;\n  place-items: center;\n  padding: 30px;\n  background: #fff;\n  border-radius: 24px;\n  box-shadow: 0 16px 40px rgba(16, 59, 112, 0.1);\n}\n.criteria-panel__image img {\n  max-height: 280px;\n  object-fit: contain;\n}\n.criteria-panel__image span {\n  margin-top: 12px;\n  color: #2769eb;\n  font-size: 12px;\n  font-weight: 800;\n  text-transform: uppercase;\n}\n\n.grade-scale-grid {\n  display: grid;\n  grid-template-columns: repeat(4, 1fr);\n  gap: 16px;\n  margin-top: 40px;\n}\n.grade-card {\n  padding: 24px;\n  border-radius: 20px;\n  background: #f8fbff;\n  border: 1px solid #d5e3f3;\n}\n.grade-badge {\n  display: inline-block;\n  padding: 4px 12px;\n  border-radius: 9999px;\n  font-size: 12px;\n  font-weight: 800;\n  margin-bottom: 12px;\n}\n.grade-card--a .grade-badge {\n  background: #e2f9ed;\n  color: #0b8243;\n}\n.grade-card--bplus .grade-badge {\n  background: #e6f0ff;\n  color: #1e5fd9;\n}\n.grade-card--b .grade-badge {\n  background: #fff4e5;\n  color: #b86200;\n}\n.grade-card--c .grade-badge {\n  background: #fde8e8;\n  color: #c81e1e;\n}\n.grade-card h4 {\n  margin: 0 0 8px;\n  font-size: 16px;\n  color: #103b70;\n}\n.grade-card p {\n  margin: 0;\n  font-size: 13px;\n  color: #526a85;\n  line-height: 1.5;\n}\n\n.site-workflow {\n  position: relative;\n  padding: clamp(90px, 9vw, 140px) clamp(28px, 7vw, 110px);\n  background: #103b70;\n  color: #fff;\n}\n.site-workflow header {\n  text-align: center;\n}\n.site-workflow .site-kicker {\n  color: #67cff4;\n}\n.site-workflow header h2 {\n  max-width: 800px;\n  margin-inline: auto;\n}\n.site-workflow > div {\n  display: grid;\n  grid-template-columns: repeat(6, 1fr);\n  gap: 12px;\n  margin-top: 54px;\n}\n.site-workflow article {\n  min-height: 240px;\n  padding: 20px;\n  border: 1px solid rgba(255, 255, 255, 0.15);\n  border-radius: 20px;\n  background: rgba(255, 255, 255, 0.07);\n}\n.site-workflow article > span {\n  color: #67cff4;\n  font-weight: 800;\n  font-size: 14px;\n}\n.site-workflow h3 {\n  margin: 48px 0 10px;\n  font-size: 18px;\n}\n.site-workflow p {\n  color: #c6d7e8;\n  font-size: 13px;\n  line-height: 1.45;\n}\n\n.site-showcase {\n  display: grid;\n  grid-template-columns: 0.75fr 1.25fr;\n  gap: 65px;\n  align-items: center;\n  padding: clamp(90px, 10vw, 150px) clamp(28px, 9vw, 140px);\n  background: linear-gradient(160deg, #edf6ff, #f8fbff);\n}\n.site-showcase__copy h2 {\n  font-size: clamp(40px, 4.5vw, 64px);\n  letter-spacing: -0.06em;\n  margin: 14px 0;\n}\n.site-showcase__copy p {\n  color: #526a85;\n  font-size: 18px;\n  line-height: 1.6;\n}\n.site-showcase__copy > div {\n  display: flex;\n  align-items: center;\n  gap: 16px;\n  margin-top: 30px;\n}\n.site-showcase__copy button {\n  width: 48px;\n  height: 48px;\n  border: 1px solid #bed0e5;\n  border-radius: 50%;\n  background: #fff;\n  color: #103b70;\n  font-size: 21px;\n  cursor: pointer;\n}\n.site-showcase__image {\n  position: relative;\n  height: 460px;\n  display: grid;\n  place-items: center;\n  border-radius: 36px;\n  background: #fff;\n  box-shadow: 0 28px 65px rgba(16, 59, 112, 0.13);\n  overflow: hidden;\n}\n.site-showcase__image:before {\n  content: \"\";\n  position: absolute;\n  width: 520px;\n  height: 520px;\n  border: 60px solid #edf4ff;\n  border-radius: 50%;\n}\n.site-showcase__image span {\n  position: absolute;\n  z-index: 2;\n  left: 24px;\n  top: 22px;\n  color: #2769eb;\n  font-size: 13px;\n  font-weight: 800;\n  text-transform: uppercase;\n}\n.site-showcase__image img {\n  position: relative;\n  z-index: 1;\n  width: 75%;\n  height: 72%;\n  object-fit: contain;\n}\n\n.site-metrics {\n  display: grid;\n  grid-template-columns: repeat(4, 1fr);\n  gap: 16px;\n  padding: 50px clamp(28px, 7vw, 110px);\n  background: #2769eb;\n}\n.site-metrics article {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  padding: 28px;\n  color: #fff;\n  text-align: center;\n}\n.site-metrics strong {\n  font-size: clamp(34px, 4vw, 54px);\n}\n.site-metrics span {\n  color: #d9e8ff;\n  font-size: 14px;\n  font-weight: 600;\n}\n\n.site-architecture {\n  background: #fff;\n}\n.architecture-flow {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 15px;\n}\n.architecture-flow article {\n  min-width: 150px;\n  padding: 23px;\n  border: 1px solid #d4e1ef;\n  border-radius: 22px;\n  background: #f7faff;\n  text-align: center;\n}\n.architecture-flow article b {\n  display: block;\n  color: #2769eb;\n  font-size: 12px;\n}\n.architecture-flow article strong,\n.architecture-flow article small {\n  display: block;\n  margin-top: 8px;\n}\n.architecture-flow article small {\n  color: #6f8196;\n}\n.architecture-flow > i {\n  color: #2769eb;\n  font-size: 25px;\n}\n\n.site-faq-preview {\n  padding: clamp(90px, 10vw, 150px) clamp(28px, 9vw, 140px);\n  background: #eff5fc;\n}\n.site-faq-preview header {\n  text-align: center;\n}\n.site-faq-preview header h2 {\n  max-width: 850px;\n  margin-inline: auto;\n}\n.site-faq-preview > div {\n  max-width: 900px;\n  margin: 45px auto 25px;\n}\n.site-faq-preview details {\n  padding: 21px 4px;\n  border-bottom: 1px solid #cbd9e8;\n}\n.site-faq-preview summary {\n  font-size: 19px;\n  font-weight: 800;\n  cursor: pointer;\n}\n\n.site-cta {\n  padding: clamp(80px, 9vw, 130px) 30px;\n  background: radial-gradient(circle at center, #154e90, #0d315f);\n  color: #fff;\n  text-align: center;\n}\n.site-cta .site-kicker {\n  color: #67cff4;\n}\n.site-cta h2 {\n  max-width: 900px;\n  margin-inline: auto;\n}\n.site-cta p {\n  color: #c8d8e9;\n  font-size: 19px;\n}\n.site-cta .site-actions {\n  justify-content: center;\n}\n\n.site-footer {\n  display: grid;\n  grid-template-columns: 1.6fr repeat(3, 1fr);\n  gap: 40px;\n  padding: 65px clamp(28px, 8vw, 120px) 35px;\n  background: #071f3d;\n  color: #d8e4ef;\n}\n.site-footer > div {\n  display: flex;\n  flex-direction: column;\n  align-items: flex-start;\n  gap: 10px;\n}\n.site-footer p {\n  max-width: 330px;\n  color: #9fb2c8;\n  line-height: 1.5;\n}\n.site-footer strong {\n  color: #fff;\n}\n.site-footer button,\n.site-footer a,\n.site-footer span {\n  padding: 0;\n  color: #aabbd0;\n  text-decoration: none;\n  cursor: pointer;\n}\n.site-footer small {\n  grid-column: 1/-1;\n  padding-top: 25px;\n  border-top: 1px solid rgba(255, 255, 255, 0.12);\n  color: #7f94ab;\n}\n\n.site-inner header,\n.site-inner--visual header.inner-hero {\n  padding: clamp(140px, 12vw, 180px) clamp(28px, 8vw, 120px) clamp(60px, 6vw, 90px);\n  background: radial-gradient(circle at 78% 24%, rgba(69, 186, 231, 0.22), transparent 26%), #103b70;\n  color: #fff;\n  width: 100%;\n  box-sizing: border-box;\n}\n.site-inner header .site-kicker,\n.site-inner--visual header.inner-hero .site-kicker {\n  color: #67cff4;\n  display: block;\n  margin-bottom: 12px;\n}\n.site-inner header h1,\n.site-inner--visual header.inner-hero h1 {\n  max-width: 1000px;\n  font-size: clamp(44px, 5.5vw, 76px);\n  line-height: 1.05;\n  letter-spacing: -0.05em;\n  margin: 16px 0;\n  color: #ffffff;\n}\n.site-inner header p,\n.site-inner--visual header.inner-hero p {\n  max-width: 820px;\n  color: #cbd9e8;\n  font-size: 20px;\n  line-height: 1.55;\n}\n.site-inner section:not(.inner-cards) {\n  display: grid;\n  grid-template-columns: repeat(4, 1fr);\n  gap: 18px;\n  padding: 80px clamp(28px, 8vw, 120px);\n  background: #f5f8fc;\n}\n.site-inner article {\n  min-height: 240px;\n  padding: 28px;\n  border: 1px solid #d5e1ee;\n  border-radius: 25px;\n  background: #fff;\n}\n.site-inner article > span {\n  color: #2769eb;\n  font-weight: 800;\n}\n.site-inner article h2 {\n  margin: 35px 0 10px;\n  font-size: 22px;\n}\n.site-inner article p {\n  color: #526a85;\n  line-height: 1.55;\n}\n.site-inner aside {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 25px;\n  padding: 55px clamp(28px, 8vw, 120px);\n  background: #dcecff;\n}\n.site-inner aside h2 {\n  font-size: clamp(28px, 4vw, 48px);\n  margin: 0;\n}\n\n\n@media (max-width: 1100px) {\n  .hardware-grid,\n  .grade-scale-grid {\n    grid-template-columns: 1fr 1fr;\n  }\n  .site-workflow > div {\n    grid-template-columns: repeat(3, 1fr);\n  }\n}\n\n@media (max-width: 980px) {\n  .site-nav {\n    height: 58px;\n  }\n  .site-nav nav {\n    display: none;\n  }\n  .site-hero {\n    grid-template-columns: 1fr;\n    padding-top: 110px;\n  }\n  .site-hero__visual {\n    min-height: 380px;\n  }\n  .site-story,\n  .site-architecture,\n  .site-showcase,\n  .criteria-panel {\n    grid-template-columns: 1fr;\n  }\n  .site-metrics {\n    grid-template-columns: 1fr 1fr;\n  }\n  .site-inner section:not(.inner-cards) {\n    grid-template-columns: 1fr 1fr;\n  }\n  .site-footer {\n    grid-template-columns: 1fr 1fr;\n  }\n  .architecture-flow {\n    flex-wrap: wrap;\n  }\n}\n\n@media (max-width: 620px) {\n  .site-nav-wrapper {\n    top: 10px;\n    padding-inline: 10px;\n  }\n  .site-nav {\n    height: 56px;\n    padding-inline: 14px;\n  }\n  .site-nav__cta {\n    padding-inline: 14px;\n    font-size: 13px;\n  }\n  .site-hero h1 {\n    font-size: 46px;\n  }\n  .site-hero__visual {\n    min-height: 300px;\n  }\n  .site-hero__band {\n    gap: 10px;\n    font-size: 11px;\n    flex-wrap: wrap;\n    padding: 10px;\n  }\n  .hardware-grid,\n  .grade-scale-grid,\n  .site-workflow > div,\n  .site-metrics,\n  .site-inner section:not(.inner-cards) {\n    grid-template-columns: 1fr;\n  }\n  .site-story,\n  .site-showcase,\n  .site-architecture,\n  .site-hardware,\n  .site-criteria {\n    padding-block: 60px;\n  }\n  .site-showcase__image {\n    height: 320px;\n  }\n  .architecture-flow {\n    flex-direction: column;\n  }\n  .architecture-flow > i {\n    transform: rotate(90deg);\n  }\n  .site-footer {\n    grid-template-columns: 1fr;\n  }\n  .site-inner aside {\n    align-items: flex-start;\n    flex-direction: column;\n  }\n}\n\n/* ─── SCROLL REVEAL ────────────────────────────────────────────────────── */\n.scroll-reveal {\n  opacity: 0;\n  transform: translateY(28px);\n  transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1), transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);\n  will-change: opacity, transform;\n}\n.scroll-reveal.is-revealed {\n  opacity: 1;\n  transform: translateY(0);\n}\n\n/* ─── HARDWARE CARD SVG ICON ──────────────────────────────────────────── */\n.hardware-card__icon {\n  width: 56px;\n  height: 56px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  border-radius: 16px;\n  background: linear-gradient(135deg, #eaf3ff, #d4e9ff);\n  color: #2769eb;\n  margin-bottom: 18px;\n  flex-shrink: 0;\n}\n.hardware-card__icon svg {\n  width: 30px;\n  height: 30px;\n}\n\n/* ─── ARCHITECTURE FLOW SVG CONNECTOR ────────────────────────────────── */\n.architecture-flow > i {\n  color: #2769eb;\n  font-size: inherit;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  width: 28px;\n  height: 28px;\n  flex-shrink: 0;\n  font-style: normal;\n}\n.architecture-flow > i svg {\n  width: 22px;\n  height: 22px;\n}\n\n/* ─── ADVISER CARD SVG ICON ──────────────────────────────────────────── */\n.adviser-card__icon {\n  width: 52px;\n  height: 52px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  border-radius: 50%;\n  background: linear-gradient(135deg, #eaf3ff, #d4e9ff);\n  color: #2769eb;\n  flex-shrink: 0;\n}\n.adviser-card__icon svg {\n  width: 26px;\n  height: 26px;\n}\n\n/* ─── INNER PAGE — VISUAL LAYOUT ─────────────────────────────────────── */\nheader.inner-hero {\n  padding: clamp(140px, 12vw, 180px) clamp(28px, 8vw, 120px) clamp(60px, 6vw, 90px);\n  background: radial-gradient(circle at 78% 24%, rgba(69, 186, 231, 0.22), transparent 26%), #103b70;\n  color: #fff;\n  width: 100%;\n  box-sizing: border-box;\n}\nheader.inner-hero .site-kicker {\n  color: #67cff4;\n  display: block;\n}\nheader.inner-hero h1 {\n  max-width: 1000px;\n  font-size: clamp(44px, 5.5vw, 76px);\n  line-height: 1.05;\n  letter-spacing: -0.05em;\n  margin: 18px 0;\n  color: #ffffff;\n}\nheader.inner-hero p {\n  max-width: 820px;\n  color: #cbd9e8;\n  font-size: 20px;\n  line-height: 1.55;\n}\n\n\n.site-inner--visual section.inner-cards {\n  display: flex !important;\n  flex-direction: column !important;\n  gap: 20px;\n  padding: clamp(50px, 6vw, 90px) clamp(28px, 8vw, 120px);\n  background: #f5f8fc;\n}\n\n.inner-card {\n  display: grid;\n  grid-template-columns: 72px 1fr;\n  gap: 24px;\n  align-items: center;\n  padding: 30px 36px;\n  border: 1px solid #dce8f5;\n  border-radius: 24px;\n  background: #ffffff;\n  box-shadow: 0 4px 20px rgba(16, 42, 77, 0.04);\n  transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);\n}\n.inner-card:hover {\n  transform: translateY(-3px);\n  box-shadow: 0 14px 36px rgba(39, 105, 235, 0.12);\n  border-color: #b0d0ff;\n  background: #ffffff;\n}\n\n.inner-card:last-child {\n  border-bottom: none;\n}\n.inner-card:hover {\n  background: rgba(39, 105, 235, 0.03);\n  border-radius: 16px;\n  padding-left: 16px;\n  margin-left: -16px;\n}\n\n.inner-card__num {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  width: 64px;\n  height: 64px;\n  border-radius: 20px;\n  background: linear-gradient(135deg, #2769eb, #1e5fd9);\n  flex-shrink: 0;\n}\n.inner-card__num span {\n  color: #fff;\n  font-size: 20px;\n  font-weight: 900;\n  letter-spacing: -0.04em;\n}\n\n.inner-card__body h2 {\n  margin: 0 0 10px;\n  font-size: clamp(20px, 2.2vw, 28px);\n  color: #103b70;\n  letter-spacing: -0.03em;\n}\n.inner-card__body p {\n  margin: 0;\n  color: #526a85;\n  font-size: 17px;\n  line-height: 1.6;\n  max-width: 780px;\n}\n\n.inner-cta {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 25px;\n  padding: 55px clamp(28px, 8vw, 120px);\n  background: #dcecff;\n}\n.inner-cta h2 {\n  font-size: clamp(28px, 4vw, 48px);\n  margin: 0;\n  color: #103b70;\n}\n\n@media (max-width: 980px) {\n  .inner-card {\n    grid-template-columns: 1fr;\n    gap: 16px;\n  }\n  .inner-cta {\n    flex-direction: column;\n    align-items: flex-start;\n  }\n}\n@media (max-width: 620px) {\n  .inner-cards {\n    padding-inline: 20px;\n  }\n  .site-inner--visual > header.inner-hero {\n    padding-inline: 20px;\n  }\n}\n\n/* ─── MINIMAL HARDWARE CARD ─────────────────────────────────────────────── */\n.hardware-card--minimal {\n  align-items: flex-start;\n  gap: 0;\n  padding: 26px 22px 22px;\n}\n.hardware-card--minimal h3 {\n  font-size: 17px;\n  line-height: 1.25;\n  margin: 0 0 14px;\n  color: #103b70;\n}\n.hw-pills {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 6px;\n}\n.hw-pills span {\n  padding: 4px 11px;\n  border-radius: 9999px;\n  background: #eaf3ff;\n  border: 1px solid #bdd7f8;\n  color: #1d5bd1;\n  font-size: 12px;\n  font-weight: 700;\n  letter-spacing: 0.01em;\n}\n\n/* ─── PICTOGRAM WORKFLOW PIPELINE ─────────────────────────────────────────── */\n.site-workflow--picto > div { display: none; } /* hide old grid child if any */\n\n.picto-pipeline {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  flex-wrap: wrap;\n  gap: 0;\n  margin-top: 56px;\n}\n\n.picto-step {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 10px;\n  width: 120px;\n  text-align: center;\n}\n.picto-step__icon {\n  width: 80px;\n  height: 80px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  border-radius: 28px;\n  background: rgba(255, 255, 255, 0.12);\n  border: 1px solid rgba(255, 255, 255, 0.22);\n  color: #fff;\n  backdrop-filter: blur(8px);\n  transition: background 0.2s ease, transform 0.2s ease;\n}\n.picto-step__icon:hover {\n  background: rgba(255, 255, 255, 0.2);\n  transform: translateY(-4px);\n}\n.picto-step__icon svg {\n  width: 36px;\n  height: 36px;\n}\n.picto-step__num {\n  color: #67cff4;\n  font-size: 11px;\n  font-weight: 800;\n  letter-spacing: 0.1em;\n}\n.picto-step__label {\n  color: #fff;\n  font-size: 14px;\n  font-weight: 700;\n  line-height: 1.2;\n}\n\n.picto-connector {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  width: 32px;\n  color: rgba(103, 207, 244, 0.6);\n  flex-shrink: 0;\n  margin-bottom: 30px; /* offset to center with icon */\n}\n.picto-connector svg {\n  width: 18px;\n  height: 18px;\n}\n\n@media (max-width: 900px) {\n  .picto-pipeline {\n    gap: 4px;\n  }\n  .picto-step {\n    width: 90px;\n  }\n  .picto-step__icon {\n    width: 64px;\n    height: 64px;\n    border-radius: 20px;\n  }\n  .picto-step__icon svg {\n    width: 28px;\n    height: 28px;\n  }\n  .picto-connector {\n    width: 20px;\n  }\n}\n@media (max-width: 620px) {\n  .picto-pipeline {\n    gap: 16px 8px;\n  }\n  .picto-connector {\n    display: none;\n  }\n  .picto-step {\n    width: 80px;\n  }\n}\n"]],"\n  ",["BODY",{},"\n    ",["DIV",{"id":"root"},["DIV",{"class":"brand-loading"},["DIV",{"class":"pdial","data-theme":"light","style":"--pdial-w: min(300px, 80vw);"},["DIV",{"class":"pdial__wrap"},["DIV",{"class":"pdial__halo","aria-hidden":"true"}],["DIV",{"class":"pdial__bloom","aria-hidden":"true"}],["DIV",{"class":"pdial__card","tabindex":"0","role":"slider","aria-label":"Tuna Weight","aria-valuemin":"0","aria-valuemax":"100","aria-valuenow":"4